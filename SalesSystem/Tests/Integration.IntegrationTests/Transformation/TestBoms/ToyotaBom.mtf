        <Font color="#000000" datum="TOP_LEFT" name="ＭＳ ゴシック" size="3.60" style="R"/>
        <String>９.　THE RANGE  B1 - B1  IS BENDING PORTION AND KINKS WITH PACKING POSTURE </String>
        <DatumPt x="37.46" y="60.27"/>
        <Size height="4.05" width="138.52"/>
      </TEXT>
      <TEXT id="FIG-48">
