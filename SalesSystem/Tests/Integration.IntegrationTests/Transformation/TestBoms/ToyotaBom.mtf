        <Size height="4.05" width="6.88"/>
      </TEXT>
      <TEXT id="FIG-40">
        <Line color="#000000" type="NONE" width="0.00"/>
        <Fill color="#8080c0" type="NONE"/>
        <Font color="#000000" datum="TOP_LEFT" name="ＭＳ ゴシック" size="3.60" style="R"/>
        <String>１０.　MUST APPLY SPOT TAPE UNDER BAND CLAMP OR TIE-BAND IN CASE OF NO PROTECTOR OR
       NO TAPE,INCLUDING ROUGH TAPING.</String>
        <DatumPt x="33.76" y="43.27"/>
        <Size height="7.65" width="155.18"/>
      </TEXT>
      <TEXT id="FIG-41">
        <Line color="#000000" type="NONE" width="0.00"/>
        <Fill color="#8080c0" type="NONE"/>
        <Font color="#000000" datum="TOP_LEFT" name="ＭＳ ゴシック" size="3.60" style="R"/>
        <String>８.　ELIMINATE SPOT TAPING, ROUGH TAPING, HALF-LAP TAPING WHEN SINGLE 
     WIRE, SHIELDED WIRE, OR TWISTED PAIR WIRE IS USED EXCEPT PCT.</String>
        <DatumPt x="37.46" y="70.32"/>
        <Size height="7.65" width="129.20"/>
      </TEXT>
