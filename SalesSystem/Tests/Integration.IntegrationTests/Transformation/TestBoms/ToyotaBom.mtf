        <Font color="#000000" datum="TOP_LEFT" name="ＭＳ ゴシック" size="3.60" style="R"/>
        <String>５.　IF NOT DESIGNATED,SUPPLIER DETERMINE TUBE SIZE AS THE MINIMUM.</String>
