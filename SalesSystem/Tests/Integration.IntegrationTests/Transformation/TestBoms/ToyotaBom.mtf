        <Font color="#000000" datum="TOP_LEFT" name="ＭＳ ゴシック" size="3.60" style="R"/>
        <String>１.　UNLESS OTHERWISE SPECIFIED,TAPE IS VT-B(t=0.07).</String>
        <DatumPt x="37.46" y="112.32"/>
        <Size height="4.05" width="99.58"/>
      </TEXT>
      <TEXT id="FIG-35">
