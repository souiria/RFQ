        <Fill color="#8080c0" type="NONE"/>
        <Font color="#000000" datum="TOP_LEFT" name="ＭＳ ゴシック" size="3.60" style="R"/>
        <String>３.　UNLESS OTHERWISE SPECIFIED,OPTION/PACKAGING TAPE IS S-VT-W,W=10.</String>
        <DatumPt x="37.46" y="100.32"/>
        <Size height="4.05" width="129.25"/>
      </TEXT>
      <TEXT id="FIG-37">
