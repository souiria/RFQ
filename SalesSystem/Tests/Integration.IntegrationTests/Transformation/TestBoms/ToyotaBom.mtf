        <Line color="#000000" type="NONE" width="0.00"/>
        <Fill color="#8080c0" type="NONE"/>
        <Font color="#000000" datum="TOP_LEFT" name="ＭＳ ゴシック" size="3.60" style="R"/>
        <String>１7． NO ROUGH TAPING UNDER COT. WHEN HALF-LAP TAPING ON D7 OR LESS COT.</String>
        <DatumPt x="217.77" y="86.38"/>
        <Size height="4.05" width="134.81"/>
      </TEXT>
      <TEXT id="FIG-65">
        <Line color="#000000" type="NONE" width="0.00"/>
        <Fill color="#8080c0" type="NONE"/>
        <Font color="#000000" datum="TOP_LEFT" name="ＭＳ ゴシック" size="3.60" style="R"/>
        <String>18． WHEN DIVIDING COVERING,BUTT THEM TOGETHER AND APPLY TAPING.</String>
        <DatumPt x="219.74" y="80.14"/>
        <Size height="4.05" width="119.98"/>
      </TEXT>
      <TEXT id="FIG-66">
        <Line color="#000000" type="NONE" width="0.00"/>
        <Fill color="#8080c0" type="NONE"/>
        <Font color="#000000" datum="TOP_LEFT" name="ＭＳ ゴシック" size="3.60" style="R"/>
        <String>19． IN CASE OF INDICATION OF ROUGH TAPING ON CUT TUBE, HALF-LAP TAPING
     ON CUT TUBE ISN'T NECESSARY.</String>
        <DatumPt x="219.29" y="73.70"/>
        <Size height="7.65" width="132.93"/>
      </TEXT>
      <TEXT id="FIG-69">
        <Line color="#000000" type="NONE" width="0.00"/>
        <Fill color="#8080c0" type="NONE"/>
        <Font color="#000000" datum="TOP_LEFT" name="ＭＳ ゴシック" size="3.60" style="R"/>
        <String>20． WHEN ONE PART NUMBER HAS NO BRANCH VARIATION, USE A SAME PROTECTIVE MATERIAL 
     AND THE SIZE SHALL BE DETERMINED DEPENDING ON THE SMALLEST WIRE.</String>
        <DatumPt x="219.44" y="63.95"/>
        <Size height="7.65" width="151.46"/>
      </TEXT>
      <TEXT id="FIG-70">
