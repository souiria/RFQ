    </PackageReference>
    <PackageReference Include="Grpc.Core.Testing" Version="2.46.6" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.9" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit.Analyzers" Version="4.8.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Access\CDb\CDb.csproj" />
    <ProjectReference Include="..\..\src\Access\CPD\CPD.csproj" />
    <ProjectReference Include="..\..\src\Access\EDI\EDI.csproj" />
    <ProjectReference Include="..\..\src\Access\Emacs\Emacs.csproj" />
    <ProjectReference Include="..\..\src\Access\Master\Master.csproj" />
    <ProjectReference Include="..\..\src\Access\NPR\NPR.csproj" />
    <ProjectReference Include="..\..\src\Access\Purchasing\Purchasing.csproj" />
    <ProjectReference Include="..\..\src\Access\Rfq\Rfq.csproj" />
    <ProjectReference Include="..\..\src\Access\SFS\SFS.csproj" />
    <ProjectReference Include="..\..\src\Client\SalesSystem.Rfq\SalesSystem.Rfq.csproj" />
    <ProjectReference Include="..\..\src\Logic\Engine\DocumentConversion\Transformation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <None Update="TestData\FordBom.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
