<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
	<ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>
	

  <ItemGroup>
	  <!-- AdditionalImportDirs lets every proto resolve CommonTypes.proto -->
	  <Protobuf Include="Protos\**\*.proto" GrpcServices="Both" ProtoRoot="Protos">
		  <AdditionalImportDirs>..\..\..\Utilities\GrpcProtos.Shared\Protos\Shared</AdditionalImportDirs>
	  </Protobuf>	  
  </ItemGroup>

  <ItemGroup>
	  <PackageReference Include="Grpc.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Utilities\GrpcProtos.Edi.Shared\GrpcProtos.Edi.Shared.csproj" />
    <ProjectReference Include="..\..\..\Utilities\GrpcProtos\GrpcProtos.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Protos\" />
  </ItemGroup>

</Project>
