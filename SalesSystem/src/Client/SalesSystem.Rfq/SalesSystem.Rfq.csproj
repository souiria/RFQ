<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
	<ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>$(DefineConstants);LOCALDEV</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Protos\Emacs.proto.bak" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" />
    
    <PackageReference Include="Google.Protobuf" />
    
    <PackageReference Include="Newtonsoft.Json" /><PackageReference Include="System.DirectoryServices.AccountManagement" />
	<PackageReference Include="Grpc.Net.Client" />
	<PackageReference Include="Grpc.Net.ClientFactory" />
	<PackageReference Include="Grpc.Tools" />
	<PackageReference Include="MudBlazor" />
	<PackageReference Include="SpreadsheetLight.Cross.Platform" />
	  <PackageReference Include="Grpc.AspNetCore" />	  
  </ItemGroup>

	<Target Name="Tailwind" BeforeTargets="Compile">
	<Exec Command="C:\Tailwind\tailwindcss.exe --input ./Styles/tailwind.css --output ./wwwroot/styles.css" />
  </Target>

  <Target Name="TailwindRelease" BeforeTargets="Compile" Condition="'$(Configuration)' == 'Release'">
	<Exec EnvironmentVariables="NODE_ENV=production" Command="C:\Tailwind\tailwindcss.exe --input ./Styles/tailwind.css --output ./wwwroot/styles.css --minify" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\..\Debug\SalesSystem.ServiceDefaults\SalesSystem.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\Utilities\GrpcProtos\GrpcProtos.csproj" />
    <ProjectReference Include="..\..\Utilities\Logging\Logging.csproj" />
    <ProjectReference Include="..\..\Utilities\SharedKernal\SharedKernel.csproj" />
    <ProjectReference Include="..\..\Utilities\SharedModels\SharedModels.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\assets\fontawesome\" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\RfqModule.proto" AdditionalImportDirs="..\..\Utilities\GrpcProtos\Protos" />
  </ItemGroup>

</Project>
