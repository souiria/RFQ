<MudNavMenu Rounded="true"
            Color="Color.Primary"
            Class="m-2">
    <MudStack Spacing="2">
        <BlazeNavLink Content="Dashboard"
                      Href="/"
                      Icon="@Icons.Material.Rounded.Dashboard"
                      IconColor="Color.Inherit"
                      Match="NavLinkMatch.All"/>
        <BlazeNavLink Content="Create RFQ"
                      Href="@($"/createRfq/{globalValue?.UserId}")"
                      Icon="@Icons.Material.Rounded.Widgets"
                      IconColor="Color.Inherit"
                      Match="NavLinkMatch.All"/>
        
    </MudStack>
</MudNavMenu>
@code{
    [Parameter] public GlobalValue? globalValue { get; set; }
    string userId = string.Empty;

    protected override Task OnInitializedAsync()
    {
        userId = globalValue?.UserId.ToString() ?? string.Empty;
        return Task.CompletedTask;
    }
}