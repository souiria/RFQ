<MudMenu Icon="@Icons.Material.Filled.Menu"
         AriaLabel="Open user menu">
    <MudMenuItem Label="Dashboard" OnClick="@(() => GoTo("/"))" />
    <MudMenuItem Label="Create RFQ" OnClick="@(() => GoTo($"/createRfq/{globalValue?.UserId}"))" />
</MudMenu>
@code{
    [Parameter] public GlobalValue? globalValue { get; set; }
    string userId = string.Empty;
    // MudNavMenu? navMenu;
    // bool expanded = false;

    protected override Task OnInitializedAsync()
    {
        userId = globalValue?.UserId.ToString() ?? string.Empty;
        return Task.CompletedTask;
    }
    void GoTo(string page)
    {
        // expanded = false;
        NavigationManager.NavigateTo(page);
    }
}