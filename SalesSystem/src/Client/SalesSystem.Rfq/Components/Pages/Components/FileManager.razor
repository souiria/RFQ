@using Microsoft.JSInterop

@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<style>
    .item-scroll {
        overflow-y: auto;
    }

    .mud-item-compact {
        padding-top: 4px !important;
        padding-left: 8px !important;
    }

    .drop-zone {
        padding: 4px;
        width: 100%;
        max-height: 128px;
        background: var(--mud-palette-surface);
        border: 2px dashed var(--mud-palette-primary);
        border-radius: 5px;
        color: var(--mud-palette-text-primary);
    }

        .drop-zone.hover {
            border-style: solid;
            background: var(--mud-palette-background-gray);
        }

    .file-item {
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 4px;
        padding: 8px;
        margin: 4px 0;
        background: var(--mud-palette-background);
        color: var(--mud-palette-text-primary);
    }

        .file-item.deleted {
            background: var(--mud-palette-error-lighten);
            text-decoration: line-through;
            opacity: 0.6;
        }

    .file-manager-container {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        min-width: 0; /* important when inside a constrained flex column */
    }
</style>

<div class="file-manager-container">
    <MudStack Class="gap-4">
        <div @ref="_DropZoneElement" class="drop-zone align-content-start">
            <InputFile @ref="_InputFile" key="@_InputFileKey" OnChange="OnChange" multiple style="display:none" />
            <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-4">Drag & Drop Files Here</MudText>
            <MudText Typo="Typo.subtitle2" Align="Align.Center" Class="mt-1">Max.16MB each</MudText>
            <MudTooltip Text="Clear all files">
                <MudIconButton Variant="Variant.Filled"
                               Icon="@Icons.Material.Filled.ClearAll"
                               Color="Color.Warning"
                               OnClick="ClearAllFiles"
                               Disabled="@(!FileObjects.Any())"
                               Size="Size.Small" />
            </MudTooltip>
            <MudText Typo="Typo.caption" Class="ml-2 align-self-center">
                @FileObjects.Count file@(FileObjects.Count == 1 ? "" : "s")
            </MudText>
        </div>
    </MudStack>
</div>
