@using SalesSystem.Rfq.Models

<style>
    .rotate-90-degrees {
        transform: rotate(-90deg);
        transform-origin: left bottom;
        white-space: nowrap;
        position: absolute;
        bottom: 20px;
        left: 36px;
        font-weight: 500;
    }

    .collapse-button {
        position: absolute;
        top: 8px;
        left: 8px;
        z-index: 10;
    }

    .label-collapsed {
        height: 48px !important;
    }

    .section-container {
        display: flex;
        flex-direction: row;
        transition: all 0.3s ease;
    }

    .section-container.collapsed {
        flex: 0 0 auto;
        height: 48px;
    }

    .section-container.expanded {
        flex: 1 1 100%;
        min-height: 0;
    }
</style>

<div class="section-container @(IsExpanded ? "expanded" : "collapsed")">
    @* Part Label *@
    <MudPaper Class="@(IsExpanded ? "" : "label-collapsed")"
              Style="@GetLabelStyle()">
        <MudIconButton Class="collapse-button"
                       Icon="@(IsExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                       Color="Color.Surface"
                       Size="Size.Small"
                       OnClick="@ToggleExpanded" />
        @if (IsExpanded)
        {
            <MudText Class="rotate-90-degrees" Typo="Typo.h6" Style="color: white;">
                @Label (@PartNumbers.Count())
            </MudText>
        }
    </MudPaper>

    @* Grid Container *@
    @if (IsExpanded)
    {
        <MudPaper Class="pa-4" Style="flex: 1 1 auto; overflow: hidden; display: flex; flex-direction: column;">
            <div style="flex: 1 1 auto; min-height: 0; overflow: hidden;">
                <PartNumbersEditGrid PartNumbers="@PartNumbers" 
                                     OnPartNumberDeleted="@OnPartNumberDeleted"
                                     OnPartNumberUpdated="@OnPartNumberUpdated" />
            </div>
        </MudPaper>
    }
</div>

@code {
    [Parameter] public IEnumerable<RfqDrawingPartNumberUx> PartNumbers { get; set; } = Enumerable.Empty<RfqDrawingPartNumberUx>();
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string BackgroundColor { get; set; } = "var(--mud-palette-primary)";
    [Parameter] public bool InitiallyExpanded { get; set; } = true;
    [Parameter] public EventCallback<RfqDrawingPartNumberUx> OnPartNumberDeleted { get; set; }
    [Parameter] public EventCallback<RfqDrawingPartNumberUx> OnPartNumberUpdated { get; set; }

    private bool IsExpanded { get; set; }

    protected override void OnInitialized()
    {
        IsExpanded = InitiallyExpanded;
    }

    private void ToggleExpanded()
    {
        IsExpanded = !IsExpanded;
    }

    private string GetLabelStyle()
    {
        if (IsExpanded)
        {
            return $"width: 48px; height: 100%; background-color: {BackgroundColor}; position: relative; overflow: visible; flex-shrink: 0;";
        }
        else
        {
            return $"width: 48px; background-color: {BackgroundColor}; position: relative; overflow: visible; flex-shrink: 0;";
        }
    }
}