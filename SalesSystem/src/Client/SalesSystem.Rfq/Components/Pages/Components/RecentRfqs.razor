@using System.Collections.Generic
@using MudBlazor.Utilities

@using SalesSystem.Rfq.Models
@inject RfqUxClientService RfqUxClientService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ILogger<RecentRfqs> Logger
@inject IDialogService DialogService
<style>
    .recent-rfqs-grid .mud-toolbar {
        height: fit-content;
        line-height: 12px !important;

        position: sticky;
        top: 0;
        z-index: 2;
        background: white;
    }

    ::deep .recent-rfqs-grid .mud-toolbar {
        position: sticky;
        top: 0;
        z-index: 2;
        background: white;
    }

    .recent-rfqs-grid .mud-toolbar .mud-input-control {
        margin-top: 0;
        margin-bottom: 4px;
    }

    .compact-field .mud-input-slot {
        padding-top: 4px;
        padding-bottom: 4px;
    }

    .recent-rfqs-grid .mud-table-body .mud-table-cell {
        font-size: 10px;
        line-height: 1.2;
    }

    ::deep .recent-rfqs-grid .mud-table-head {
        position: sticky;
        top: 0;
        z-index: 1;
        background: white;
    }

    ::deep .recent-rfqs-grid .mud-table-head th {
        background: white;
    }

    .grid-container {
        height: 44vh;
        overflow-y: auto;
    }
</style>

<div class="d-flex flex-column" style="height: 100%; overflow: hidden;">
    @if (IsLoading)
    {
        <div class="d-flex justify-center align-center" style="height: 100%;">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large">
                <ChildContent>
                    <MudText Typo="Typo.subtitle2">Loading...</MudText>
                </ChildContent>
            </MudProgressCircular>
        </div>
    }
    else
    {
        <MudDataGrid T="RfqProjectUxModel"
                     @ref="@_DataGrid"
                     Items="@RfqUxClientService.RfqProjectUxs"
                     ColumnResizeMode="ResizeMode.Container"
                     QuickFilter="@QuickFilter"
                     Bordered="false"
                     Dense="true"
                     Hover="true"
                     Class="recent-rfqs-grid"
                     FixedHeader="true"
                     Height="39vh"
                     HorizontalScrollbar="true">
                <ToolBarContent>
                    <MudTooltip Text="Full text search">
                        <MudTextField AdornmentIcon="@Icons.Material.Outlined.Search"
                                      Adornment="Adornment.End"
                                      Margin="Margin.Dense"
                                      IconSize="Size.Small"
                                      Typo="Typo.subtitle2"
                                      Placeholder="Filter Results"
                                      @bind-Value="_SearchString"
                                      DebounceInterval="100"
                                      Variant="Variant.Text"
                                      Clearable
                                      Class="compact-field" />
                    </MudTooltip>
                    <MudSpacer />
                    <MudTooltip Text="Refresh Dataset">
                        <MudIconButton Size="Size.Small"
                                       Color="Color.Primary"
                                       Icon="@Icons.Material.Filled.Refresh"
                                       aria-label="refresh"
                                       @onclick="@(() => RefreshAsync())" />
                    </MudTooltip>
                    <MudTooltip Text="@(_showActionsColumn ? "Hide Actions column" : "Show Actions column")">
                        <MudIconButton Size="Size.Small"
                                       Color="@(_showActionsColumn ? Color.Default : Color.Warning)"
                                       Icon="@(_showActionsColumn ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                       aria-label="toggle-actions"
                                       @onclick="@(() => _showActionsColumn = !_showActionsColumn)" />
                    </MudTooltip>
                </ToolBarContent>
                <ColGroup>
                    <col style="width: 30%;" />
                    <col style="width: 10%;" />
                    <col style="width: 10%;" />
                    <col style="width: 10%;" />
                    <col style="width: 20%;" />
                    <col style="width: 20%;" />
                </ColGroup>
                <Columns>
                    <TemplateColumn CellClass="d-flex justify-start" Sortable="false" Hidden="@(!_showActionsColumn)" StickyLeft="true">
                        <CellTemplate>
                            <MudStack Row>
                                <MudIconButton Size="@Size.Small"
                                               Icon="@Icons.Material.Filled.Edit"
                                               aria-label="edit"
                                               OnClick="@(() => NavigateToEdit(context.Item))" />
                                <MudIconButton Size="@Size.Small"
                                               Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error"
                                               aria-label="delete"
                                               OnClick="@(() => DeleteAsync(context.Item))" />
                            </MudStack>
                        </CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn Property="x => x.RfqNumber" Title="RFQ #" />
                    <PropertyColumn Property="x => x.CustomerLocationName" Title="Customer" />
                    <PropertyColumn Property="x => x.ProjectName" Title="Project" />
                    <PropertyColumn Property="x => x.RfqReasonName" Title="Reason" />
                    <PropertyColumn Property="x => x.VehicleVolume" Title="Volume" />
                    <PropertyColumn Property="x => x.RfqResponseDeadline" Title="Deadline" Format="dd.MM.yyyy" />

                </Columns>
            </MudDataGrid>
    }
</div>

<style>
    .mud-grid-no-scroll-x {
        overflow-x: hidden !important;
    }
</style>

@code {
    MudDataGrid<RfqProjectUxModel> _DataGrid = null!;
    string? _SearchString = string.Empty;

    // Actions column visibility
    bool _showActionsColumn = true;

    private bool IsLoading = true;

    [Parameter] public GlobalValue GlobalValue { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        IsLoading = false;
    }

    async Task RefreshAsync()
    {
        try
        {
            _SearchString = string.Empty;
            Logger.LogInformation("Loading RFQ projects...");
            var count = await RfqUxClientService.GetAllRfqProjectAsync();
            if (count <= 0)
            {
                Snackbar.Add("No RFQ projects found.", Severity.Info);
            }
            // FIX: Assign the correct type directly, do not use Concat (Concat does not mutate the original list)
            // _RfqProjects = RfqUxClientService.RfqProjectUxs.Cast<RfqProjectUxModel>().ToList();
            Logger.LogInformation($"Loaded {RfqUxClientService.RfqProjectUxs.Count} RFQ projects");

        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load RFQ projects");
            Snackbar.Add("Failed to load RFQ projects.", Severity.Error);
        }
        finally
        {
            StateHasChanged();
        }
    }

    private void NavigateToEdit(RfqProjectUxModel project)
    {
        if (GlobalValue?.UserId != null && GlobalValue.UserId != Guid.Empty)
        {
            Navigation.NavigateTo($"/editRfq/{project.RowId}");
        }
        else
        {
            Snackbar.Add("User ID is required to edit RFQ.", Severity.Warning);
        }
    }

    private async Task DeleteAsync(RfqProjectUxModel project)
    {
        bool? result = await DialogService.ShowMessageBoxAsync(
            "Delete RFQ Project",
            $"Are you sure you want to delete RFQ #{project.RfqNumber}? This action cannot be undone.",
            yesText: "Delete",
            cancelText: "Cancel",
            options: new DialogOptions() { MaxWidth = MaxWidth.Small });

        if (result == true)
        {
            try
            {
                Logger.LogInformation($"Deleting RFQ project with RowId: {project.RowId}");
                var response = await RfqUxClientService.DeleteRfqProjectByRowIdAsync(project.RowId);

                if (response.SaveSuccess)
                {
                    Snackbar.Add($"RFQ #{project.RfqNumber} deleted successfully.", Severity.Success);
                    Logger.LogInformation($"Successfully deleted RFQ project: {project.RfqNumber}");

                    // Refresh the list
                    await RfqUxClientService.GetAllRfqProjectAsync();
                    StateHasChanged();
                }
                else
                {
                    Snackbar.Add($"Failed to delete RFQ: {response.Message}", Severity.Error);
                    Logger.LogWarning($"Delete failed for RFQ {project.RfqNumber}: {response.Message}");
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, $"Error deleting RFQ project with RowId: {project.RowId}");
                Snackbar.Add($"An error occurred while deleting RFQ #{project.RfqNumber}.", Severity.Error);
            }
        }
    }

    // quick filter - filter globally across multiple columns with the same input
    private Func<RfqProjectUxModel, bool> QuickFilter => x =>
    {
        if (string.IsNullOrWhiteSpace(_SearchString))
            return true;

        if (!string.IsNullOrEmpty(x.CarModel) && x.CarModel.Contains(_SearchString, StringComparison.OrdinalIgnoreCase))
            return true;

        if (!string.IsNullOrEmpty(x.CustomerBusinessUnit) && x.CustomerBusinessUnit.Contains(_SearchString, StringComparison.OrdinalIgnoreCase))
            return true;

        if (!string.IsNullOrEmpty(x.RfqNumber) && x.RfqNumber.Contains(_SearchString, StringComparison.OrdinalIgnoreCase))
            return true;

        return false;
    };
}