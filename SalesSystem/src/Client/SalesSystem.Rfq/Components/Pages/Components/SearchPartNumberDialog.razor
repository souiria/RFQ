@using SalesSystem.Rfq.Models
@using MudBlazor
@using System.Text.Json

@inject ISnackbar Snackbar
@inject ILogger<SearchPartNumberDialog> Logger
@inject IDialogService DialogService
@inject RfqUxClientService RfqUxClientService
@inject CustomAuthenticationStateProvider GetAuthenticationStateAsync

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h6" Class="mb-4">
            Found @SewsePartNumbers.Count result(s) for part number: @(SearchedPartNumber?.OriginalPartNumber ?? "N/A")
        </MudText>

        @if (SewsePartNumbers.Count > 0)
        {
            <MudList T="string"
                     SelectionMode="SelectionMode.SingleSelection"
                     Dense="true">
                @foreach (var (partNumber, index) in SewsePartNumbers.Select((pn, idx) => (pn, idx)))
                {
                    <MudListItem>
                        <MudPaper Elevation="2" Class="pa-3 mb-2">
                            <MudGrid>
                                <MudItem xs="12" sm="@(HasImage(index) ? 8 : 12)">
                                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">
                                        Part #@(index + 1)
                                    </MudText>
                                    <MudText Typo="Typo.body2">
                                        <strong>Sumitomo Number:</strong> @(partNumber ?? "N/A")
                                    </MudText>

                                    @* NPR Results Section *@
                                    @if (IsLoadingNprData(index))
                                    {
                                        <MudProgressLinear Color="Color.Secondary" Indeterminate="true" Class="mt-2 mb-1" Size="Size.Small" />
                                        <MudText Typo="Typo.caption" Class="ml-4">Loading NPR data...</MudText>
                                    }
                                    else if (HasNprResults(index))
                                    {
                                        <div class="ml-4 mt-2">
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                                <strong>NPR Results:</strong>
                                            </MudText>
                                            <MudList T="string" Dense="true" Padding="false" Class="ml-2">
                                                @foreach (var (nprPart, nprIndex) in GetNprResults(index).Select((np, ni) => (np, ni)))
                                                {
                                                    <MudListItem Dense="true" Gutters="false">
                                                        <div class="d-flex align-center justify-space-between">
                                                            <MudText Typo="Typo.body2" Class="ml-2 flex-grow-1">
                                                                • @nprPart
                                                                @if (HasNprPrice(index, nprIndex))
                                                                {
                                                                    <span> - <strong>@($"${GetNprPrice(index, nprIndex):N5}")</strong></span>
                                                                }
                                                            </MudText>
                                                            <MudButton Variant="Variant.Filled"
                                                                       Color="Color.Success"
                                                                       Size="Size.Small"
                                                                       StartIcon="@Icons.Material.Filled.Check"
                                                                       OnClick="@(() => ApplyNprData(nprPart, GetNprPrice(index, nprIndex)))"
                                                                       Class="ml-2">
                                                                Apply
                                                            </MudButton>
                                                        </div>
                                                    </MudListItem>
                                                }
                                            </MudList>
                                        </div>
                                    }
                                    else if (HasNprError(index))
                                    {
                                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2 ml-4">
                                            Failed to load NPR data
                                        </MudAlert>
                                    }

                                    @if (IsLoadingImage(index))
                                    {
                                        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mt-2" />
                                        <MudText Typo="Typo.caption" Class="mt-1">Loading image...</MudText>
                                    }
                                    else if (HasImageError(index))
                                    {
                                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                                            Failed to load image
                                        </MudAlert>
                                    }
                                </MudItem>
                                @if (HasImage(index))
                                {
                                    <MudItem xs="12" sm="4" Class="d-flex justify-center align-center">
                                        <MudImage Src="@GetImageSource(index)"
                                                  Alt="Part Image"
                                                  Elevation="3"
                                                  Class="rounded"
                                                  Style="max-width: 100%; max-height: 200px; object-fit: contain;" />
                                    </MudItem>
                                }
                            </MudGrid>
                        </MudPaper>
                    </MudListItem>
                }
            </MudList>
        }
        else
        {
            <MudAlert Severity="Severity.Info">
                No results found for the specified part number.
            </MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Color="Color.Primary" Variant="Variant.Filled">
            Close
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public RfqDrawingPartNumberUx? SearchedPartNumber { get; set; }
    [Parameter] public List<string?> SewsePartNumbers { get; set; } = new();  // a list of sewse part numbers corresponding to SearchedPartNumber in Emacs
    // [Parameter] public List<decimal?> Prices { get; set; } = new();
    
    public List<MatchedPartNumberUx> MatchedPartNumbers { get; set; } = new();

    private Dictionary<int, PartImageData> _partImages = new();
    private Dictionary<int, bool> _loadingImageStates = new();
    private Dictionary<int, bool> _imageErrorStates = new();

    private Dictionary<int, NprResultData> _nprResults = new();
    private Dictionary<int, bool> _loadingNprStates = new();
    private Dictionary<int, bool> _nprErrorStates = new();

    private string _currentUser = "Unknown";

    protected override async Task OnInitializedAsync()
    {

        try
        {
            // Get current user
            var authState = await GetAuthenticationStateAsync.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity!.IsAuthenticated)
            {
                _currentUser = user?.Identity?.Name ?? "NoName";
                Logger.GenericLogInformation($"User is authenticated: {_currentUser}");
            }
            else
            {
                _currentUser = "Anonymous";
                Logger.GenericLogInformation("User is not authenticated.");
            }
        }
        catch (Exception ex)
        {
            Logger.GenericLogError("Error getting current user", ex);
        }

        await base.OnInitializedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && SewsePartNumbers.Count > 0)
        {
            // Start loading images and NPR data for all parts in parallel
            var loadTasks = SewsePartNumbers
                .Select((partNumber, index) => Task.WhenAll(
                    LoadPartImageAsync(partNumber, index),
                    LoadNprDataAsync(partNumber, index)
                ))
                .ToList();

            // Don't await - let them load in parallel
            _ = Task.WhenAll(loadTasks);
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task LoadPartImageAsync(string? partNumber, int index)
    {
        if (string.IsNullOrWhiteSpace(partNumber))
        {
            return;
        }

        try
        {
            _loadingImageStates[index] = true;
            _imageErrorStates[index] = false;
            await InvokeAsync(StateHasChanged);

            Logger.GenericLogInformation($"Loading image for part number: {partNumber}");

            SearchResultUx response = await RfqUxClientService.SearchAdssSewsePn(partNumber);

            if (response.IsSuccessful &&
                response.ByteList != null &&
                response.ByteList.Count > 0 &&
                response.StringList2 != null &&
                response.StringList2.Count > 0)
            {
                // Get the first image (assuming ByteList contains complete image byte arrays)
                byte[] imageBytes = response.ByteList[0];
                string mimeType = response.StringList2[0] ?? "image/png";

                _partImages[index] = new PartImageData
                {
                    ImageBytes = imageBytes,
                    MimeType = mimeType
                };

                Logger.GenericLogInformation($"Successfully loaded image for part number: {partNumber}, Size: {imageBytes.Length} bytes, Type: {mimeType}");
            }
            else
            {
                Logger.GenericLogInformation($"No image found for part number: {partNumber}");
            }
        }
        catch (Exception ex)
        {
            Logger.GenericLogError($"Error loading image for part number: {partNumber}", ex);
            _imageErrorStates[index] = true;
        }
        finally
        {
            _loadingImageStates[index] = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadNprDataAsync(string? partNumber, int index)
    {
        if (string.IsNullOrWhiteSpace(partNumber))
        {
            return;
        }

        try
        {
            _loadingNprStates[index] = true;
            _nprErrorStates[index] = false;
            await InvokeAsync(StateHasChanged);

            Logger.GenericLogInformation($"Loading NPR data for part number: {partNumber}");

            SearchResultUx response = await RfqUxClientService.SearchNprSewsePn(partNumber);

            if (response.IsSuccessful &&
                response.StringList != null &&
                response.StringList.Count > 0)
            {
                List<string> nprPartNumbers = response.StringList.ToList();
                // Convert double prices to decimal with 5 decimal places precision
                List<decimal> nprPrices = response.DoubleList?
                    .Select(d => Math.Round((decimal)d, 5, MidpointRounding.AwayFromZero))
                    .ToList() ?? new List<decimal>();

                NprResultData nprResultData = new NprResultData();
                nprResultData.PartNumbers.AddRange(nprPartNumbers);
                nprResultData.Prices.AddRange(nprPrices);
                _nprResults[index] = nprResultData;
                
                Logger.GenericLogInformation($"Successfully loaded NPR data for part number: {partNumber}, Found: {nprPartNumbers.Count} NPR parts");
            }
            else
            {
                Logger.GenericLogInformation($"No NPR data found for part number: {partNumber}");
            }
        }
        catch (Exception ex)
        {
            Logger.GenericLogError($"Error loading NPR data for part number: {partNumber}", ex);
            _nprErrorStates[index] = true;
        }
        finally
        {
            _loadingNprStates[index] = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ApplyNprData(string nprPartNumber, decimal nprPrice)
    {
        await Task.Delay(1);
        if (SearchedPartNumber == null)
        {
            Logger.GenericLogInformation("Cannot apply NPR data: SearchedPartNumber is null");
            Snackbar.Add("Error: No part number to update", Severity.Error);
            return;
        }

        try
        {
            Logger.GenericLogInformation($"Applying NPR data: Part={nprPartNumber}, Price={nprPrice:F5}");

            // Update the part number with NPR data - price already has proper precision
            SearchedPartNumber.SwappedPartNumber = nprPartNumber;
            SearchedPartNumber.SwappedPartNumberPrice = nprPrice;
            SearchedPartNumber.PriceSource = "NPR";
            SearchedPartNumber.IsExactMatch = true;
            SearchedPartNumber.IsMatched = true;
            SearchedPartNumber.IsSwapped = false;

            // Create comment JSON with current user and UTC timestamp
            var commentData = new
            {
                User = _currentUser,
                Timestamp = DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm:ss.fffZ"),
                Action = "NPR_Applied",
                NprPartNumber = nprPartNumber,
                NprPrice = nprPrice
            };

            string commentJson = JsonSerializer.Serialize(commentData, new JsonSerializerOptions
            {
                WriteIndented = false
            });

            // Append to existing comments or create new
            if (string.IsNullOrWhiteSpace(SearchedPartNumber.Comments))
            {
                SearchedPartNumber.Comments = commentJson;
            }
            else
            {
                SearchedPartNumber.Comments += $"; {commentJson}";
            }

            Logger.GenericLogInformation($"Successfully applied NPR data to part number: {SearchedPartNumber.OriginalPartNumber}, Price={nprPrice:F5}");
            Snackbar.Add($"Applied NPR part: {nprPartNumber} (${nprPrice:N5})", Severity.Success);

            // Close the dialog and return the updated part number
            MudDialog.Close(DialogResult.Ok(SearchedPartNumber));
        }
        catch (Exception ex)
        {
            Logger.GenericLogError($"Error applying NPR data: {nprPartNumber}", ex);
            Snackbar.Add($"Error applying NPR data: {ex.Message}", Severity.Error);
        }
    }

    private bool HasImage(int index)
    {
        return _partImages.ContainsKey(index) && _partImages[index].ImageBytes.ToArray().Length > 0; // Fix: Changed Length() to Length
    }

    private bool IsLoadingImage(int index)
    {
        return _loadingImageStates.ContainsKey(index) && _loadingImageStates[index];
    }

    private bool HasImageError(int index)
    {
        return _imageErrorStates.ContainsKey(index) && _imageErrorStates[index];
    }

    private bool HasNprResults(int index)
    {
        return _nprResults.ContainsKey(index) && _nprResults[index].PartNumbers.Count > 0;
    }

    private bool IsLoadingNprData(int index)
    {
        return _loadingNprStates.ContainsKey(index) && _loadingNprStates[index];
    }

    private bool HasNprError(int index)
    {
        return _nprErrorStates.ContainsKey(index) && _nprErrorStates[index];
    }

    private List<string> GetNprResults(int index)
    {
        if (!_nprResults.ContainsKey(index))
        {
            return new List<string>();
        }
        return _nprResults[index].PartNumbers.ToList();
    }

    private bool HasNprPrice(int index, int nprIndex)
    {
        if (!_nprResults.ContainsKey(index))
        {
            return false;
        }
        var nprData = _nprResults[index];
        return nprIndex < nprData.Prices.Count && nprData.Prices[nprIndex] > 0;
    }

    private decimal GetNprPrice(int index, int nprIndex)
    {
        if (!_nprResults.ContainsKey(index))
        {
            return 0;
        }
        var nprData = _nprResults[index];
        if (nprIndex < nprData.Prices.Count)
        {
            return nprData.Prices[nprIndex];
        }
        return 0;
    }

    private string GetImageSource(int index)
    {
        if (!_partImages.ContainsKey(index))
        {
            return string.Empty;
        }

        var imageData = _partImages[index];
        string base64Image = Convert.ToBase64String(imageData.ImageBytes.ToArray());
        return $"data:{imageData.MimeType};base64,{base64Image}";
    }

    private void Close()
    {
        MudDialog.Close();
    }

}