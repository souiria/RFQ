@using SalesSystem.Rfq.Models
@using MudBlazor

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h6" Class="mb-4">
            Enter Dummy Part Number Information
        </MudText>
        <MudForm @ref="_form" @bind-IsValid="_isValid">
            <MudGrid>
                <MudItem xs="12">
                    <MudTextField @bind-Value="DummyPartNumber"
                                  Label="Dummy Part Number"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Required="true"
                                  RequiredError="Dummy part number is required" />
                </MudItem>
                <MudItem xs="12">
                    <MudNumericField @bind-Value="DummyPrice"
                                     Label="Dummy Price"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Format="0.#####"
                                     Adornment="Adornment.Start"
                                     AdornmentText="$"
                                     Min="0m"
                                     Required="true"
                                     RequiredError="Dummy price is required" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Color="Color.Default">Cancel</MudButton>
        <MudButton OnClick="Apply" Color="Color.Primary" Variant="Variant.Filled" Disabled="!_isValid">OK</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    private string? DummyPartNumber { get; set; }
    private decimal? DummyPrice { get; set; }
    private MudForm _form = null!;
    private bool _isValid;

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task Apply()
    {
        await _form.Validate();
        if (_isValid)
        {
            var result = new RfqDrawingPartNumberUx();

            result.SwappedPartNumber = DummyPartNumber;
            result.SwappedPartNumberPrice = DummyPrice;

            MudDialog.Close(DialogResult.Ok(result));
        }
    }
}