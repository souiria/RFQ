                                <PropertyColumn Property="x => x.Quantity" Title="Quantity" />
                                <PropertyColumn Property="x => x.UoM" Title="UoM" />
                                <PropertyColumn Property="x => x.CustomerCode" Title="Customer Code" />
                                <PropertyColumn Property="x => x.Group1" Title="Group 1" />
                                <PropertyColumn Property="x => x.Group2" Title="Group 2" />
                                <PropertyColumn Property="x => x.Group3" Title="Group 3" />
                                <PropertyColumn Property="x => x.Group4" Title="Group 4" />
                                <PropertyColumn Property="x => x.Group5" Title="Group 5" />
                                <PropertyColumn Property="x => x.Group6" Title="Group 6" />
                                <PropertyColumn Property="x => x.Group7" Title="Group 7" />
                                <PropertyColumn Property="x => x.Group8" Title="Group 8" />
