    private bool _quickFilterFunc(AlternativePartUxModel x)
    {
        if (string.IsNullOrWhiteSpace(AlternativePartFilter))
            return true;

        if (_lastCompiledFilter != AlternativePartFilter)
        {
            _lastCompiledFilter = AlternativePartFilter;
            var filter = AlternativePartFilter.Trim();
            var comparisonType = StringComparison.OrdinalIgnoreCase;
            var isNumeric = double.TryParse(filter, out _);

            _compiledQuickFilter = item =>
            {
                if (item.SumitomoNumber?.Contains(filter, comparisonType) == true) return true;
                if (item.SumitomoDescription?.Contains(filter, comparisonType) == true) return true;
                if (item.SupplierName?.Contains(filter, comparisonType) == true) return true;
                if (item.SupplierNumber?.Contains(filter, comparisonType) == true) return true;
                if (item.CurrencyCode?.Contains(filter, comparisonType) == true) return true;
                if (item.UnitOfMeasure?.Contains(filter, comparisonType) == true) return true;
                if (item.PartGroup?.Contains(filter, comparisonType) == true) return true;
                if (item.GroupDescription?.Contains(filter, comparisonType) == true) return true;
                if (item.Class1?.Contains(filter, comparisonType) == true) return true;
                if (item.Class1Name?.Contains(filter, comparisonType) == true) return true;
                if (item.Class2Name?.Contains(filter, comparisonType) == true) return true;
                if (item.ColourCode?.Contains(filter, comparisonType) == true) return true;
                if (item.ColorName?.Contains(filter, comparisonType) == true) return true;
                if (item.MaterialGroup?.Contains(filter, comparisonType) == true) return true;
                if (item.MaterialType?.Contains(filter, comparisonType) == true) return true;
                if (item.TypeDescription?.Contains(filter, comparisonType) == true) return true;
                if (item.CategoryCode?.Contains(filter, comparisonType) == true) return true;
                if (item.CategoryName?.Contains(filter, comparisonType) == true) return true;
                if (item.UoM?.Contains(filter, comparisonType) == true) return true;
                if (item.CustomerCode?.Contains(filter, comparisonType) == true) return true;
                if (item.CustomerId?.Contains(filter, comparisonType) == true) return true;
                if (item.Group1?.Contains(filter, comparisonType) == true) return true;
                if (item.Group2?.Contains(filter, comparisonType) == true) return true;
                if (item.Group3?.Contains(filter, comparisonType) == true) return true;
                if (item.Group4?.Contains(filter, comparisonType) == true) return true;
                if (item.Group5?.Contains(filter, comparisonType) == true) return true;
                if (item.Group6?.Contains(filter, comparisonType) == true) return true;
                if (item.Group7?.Contains(filter, comparisonType) == true) return true;
                if (item.Group8?.Contains(filter, comparisonType) == true) return true;
                if (item.CategoryCode2?.Contains(filter, comparisonType) == true) return true;

                if (isNumeric)
                {
                    if (item.Price?.ToString().Contains(filter, comparisonType) == true) return true;
                    if (item.NumberOfCavity?.ToString().Contains(filter, comparisonType) == true) return true;
                    if (item.InsideDiameter?.ToString().Contains(filter, comparisonType) == true) return true;
                    if (item.WallThickness?.ToString().Contains(filter, comparisonType) == true) return true;
                    if (item.Length?.ToString().Contains(filter, comparisonType) == true) return true;
                    if (item.WidthOrOutsideDiameter?.ToString().Contains(filter, comparisonType) == true) return true;
                    if (item.MassOrWeight?.ToString().Contains(filter, comparisonType) == true) return true;
                    if (item.MassOrWeight2?.ToString().Contains(filter, comparisonType) == true) return true;
                    if (item.Quantity?.ToString().Contains(filter, comparisonType) == true) return true;
                    if (item.L1?.ToString().Contains(filter, comparisonType) == true) return true;
                    if (item.L2?.ToString().Contains(filter, comparisonType) == true) return true;
                    if (item.L3?.ToString().Contains(filter, comparisonType) == true) return true;
                    if (item.PitchWidth?.ToString().Contains(filter, comparisonType) == true) return true;
                }

                return false;
            };
        }

        return _compiledQuickFilter?.Invoke(x) ?? true;
    }
}