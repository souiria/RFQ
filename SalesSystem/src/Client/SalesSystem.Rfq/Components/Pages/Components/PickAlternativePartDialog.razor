@using SalesSystem.Rfq.Models
@using MudBlazor

@inject RfqUxClientService RfqUxClientService
@inject ILogger<PickAlternativePartDialog> Logger
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<style>
    .mud-alt-part-grid .mud-table-head {
        background-color: lightgrey;
    }

        .mud-alt-part-grid .mud-table-head th {
            background-color: lightgrey;
        }

    .mud-alt-part-grid {
        overflow-x: hidden !important;
        border: 1px solid #bdbdbd;
        border-radius: 4px;
    }

    .mud-table-sticky-header {
        position: sticky;
        top: 0;
        z-index: 1;
        background-color: var(--mud-palette-surface);
    }

    /* First row: column headers */
    .mud-alt-part-grid .mud-table-head tr:first-child th {
        position: sticky;
        top: 0;
        z-index: 3;
        background-color: lightgrey;
    }

    /* Second row: filter inputs */
    .mud-alt-part-grid .mud-table-head tr:nth-child(2) th {
        position: sticky;
        top: 36px;
        z-index: 3;
        background-color: #f5f5f5;
    }
</style>

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h6" Class="mb-4">
            Enter Dummy Part Number Information
        </MudText>
        <MudForm @ref="_form" @bind-IsValid="_isValid">
            <MudGrid>
                <MudItem xs="12">
                    @if (IsLoading)
                    {
                        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                        <MudText Typo="Typo.body2" Class="mt-2">Loading alternative parts...</MudText>
                    }
                    else
                    {
                        <MudDataGrid T="AlternativePartUxModel"
                                     @ref="_alternativePartNumbersGrid"
                                     Items="@RfqUxClientService.AlternativeParts"
                                     Virtualize="true"
                                     FixedHeader="true"
                                     ItemSize="20f"
                                     Height="320px"
                                     Dense="true"
                                     DragDropColumnReordering="true"
                                     ApplyDropClassesOnDragStarted="true"
                                     ColumnResizeMode="ResizeMode.Column"
                                     SortMode="SortMode.Multiple"
                                     Hideable="true"
                                     Filterable="true"
                                     FilterMode="DataGridFilterMode.ColumnFilterRow"
                                     Groupable="true"
                                     QuickFilter="@QuickFilter"
                                     ReadOnly="true"
                                     Bordered="true"
                                     Class="mud-alt-part-grid"
                                     ShowMenuIcon="true">
                            <ToolBarContent>
                                <MudTooltip Text="Full text search">
                                    <MudTextField @bind-Value="AlternativePartFilter" 
                                                  Placeholder="Search" 
                                                  Adornment="Adornment.Start" 
                                                  Immediate="true"
                                                  AdornmentIcon="@Icons.Material.Filled.Search" 
                                                  IconSize="Size.Medium" 
                                                  Class="mt-0" />
                                </MudTooltip>
                                <span>&nbsp;</span>
                            </ToolBarContent>
                            <Columns>
                                <PropertyColumn Property="x => x.SumitomoNumber" Title="Sumitomo Number" StickyLeft="true" />
                                <PropertyColumn Property="x => x.SumitomoDescription" Title="Description" HeaderStyle="max-width:18em; min-width:18em" Filterable="true" />
                                <PropertyColumn Property="x => x.MainSupplier" Title="Main Supplier" />
                                @* <PropertyColumn Property="x => x.SupplierName" Title="Supplier Name" /> *@
                                <PropertyColumn Property="x => x.SupplierName" Title="Supplier Name">
                                    <FilterTemplate>
                                        <MultiSelectColumnFilter T="AlternativePartUxModel"
                                                                 TProperty="string"
                                                                 Items="@RfqUxClientService.AlternativeParts"
                                                                 KeySelector="@((AlternativePartUxModel x) => (string?)x.SupplierName)"
                                                                 DisplaySelector="@((AlternativePartUxModel x) => $"{x.SupplierName}")"
                                                                 FilterContext="@context" />
                                    </FilterTemplate>
                                </PropertyColumn>
                                <PropertyColumn Property="x => x.SupplierNumber" Title="Supplier Number" />
                                <PropertyColumn Property="x => x.Price" Title="Price" />
                                @* <PropertyColumn Property="x => x.CurrencyCode" Title="Currency" /> *@
                                <PropertyColumn Property="x => x.CurrencyCode" Title="Currency">
                                    <FilterTemplate>
                                        <MultiSelectColumnFilter T="AlternativePartUxModel"
                                                                 TProperty="string"
                                                                 Items="@RfqUxClientService.AlternativeParts"
                                                                 KeySelector="@((AlternativePartUxModel x) => (string?)x.CurrencyCode)"
                                                                 DisplaySelector="@((AlternativePartUxModel x) => $"{x.CurrencyCode}")"
                                                                 FilterContext="@context" />
                                    </FilterTemplate>
                                </PropertyColumn>
                                @* <PropertyColumn Property="x => x.UnitOfMeasure" Title="Unit" /> *@
                                <PropertyColumn Property="x => x.UnitOfMeasure" Title="UoM">
                                    <FilterTemplate>
                                        <MultiSelectColumnFilter T="AlternativePartUxModel"
                                                                 TProperty="string"
                                                                 Items="@RfqUxClientService.AlternativeParts"
                                                                 KeySelector="@((AlternativePartUxModel x) => (string?)x.UnitOfMeasure)"
                                                                 DisplaySelector="@((AlternativePartUxModel x) => $"{x.UnitOfMeasure}")"
                                                                 FilterContext="@context" />
                                    </FilterTemplate>
                                </PropertyColumn>
                                @* <PropertyColumn Property="x => x.PartGroup" Title="Part Group" />
                                <PropertyColumn Property="x => x.GroupDescription" Title="Group Description" /> *@
                                <PropertyColumn Property="x => x.PartGroup" Title="Part Group">
                                    <FilterTemplate>
                                        <MultiSelectColumnFilter T="AlternativePartUxModel"
                                                                 TProperty="string"
                                                                 Items="@RfqUxClientService.AlternativeParts"
                                                                 KeySelector="@((AlternativePartUxModel x) => (string?)x.PartGroup)"
                                                                 DisplaySelector="@((AlternativePartUxModel x) => $"{x.PartGroup} - {x.GroupDescription}")"
                                                                 FilterContext="@context" />
                                    </FilterTemplate>
                                </PropertyColumn>
                                @* <PropertyColumn Property="x => x.Class1" Title="Class 1" />
                                <PropertyColumn Property="x => x.Class1Name" Title="Class 1 Name" /> *@
