                                    <FilterTemplate>
                                        <MultiSelectColumnFilter T="AlternativePartUxModel"
                                                                 TProperty="string"
                                                                 Items="@RfqUxClientService.AlternativeParts"
                                                                 KeySelector="@((AlternativePartUxModel x) => (string?)x.Class1)"
                                                                 DisplaySelector="@((AlternativePartUxModel x) => $"{x.Class1} - {x.Class1Name}")"
