                {
                    WriteIndented = true
                });

        Logger?.LogInformation("NPR JSON BEFORE VALIDATION:\n" + json);
        //  //  //  //  //  //  //  //  //  //  //  //  //  //  //  //  //  //  //

        _validCount = 0;
        _invalidCount = 0;

        foreach (RfqNprRequestUxModel request in RfqProject.NprRequests)
        {
            if (request.UxStatus == UxObjectStatus.Deleted)
            {
                continue;
            }

            bool isValid = request.Validate();

            if (isValid)
            {
                _validCount++;
            }
            else
            {
                _invalidCount++;
              
                ////////////////////////////////////////////////////
                Logger?.LogWarning(
                   "INVALID NPR\n" +
                   "---------------------------------\n" +
                   string.Join("\n",
                       request.GetType()
                              .GetProperties()
                              .Select(p =>
