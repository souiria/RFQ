@using SalesSystem.Rfq.Models
@using MudBlazor

@inject IDialogService DialogService

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_isValid">
            <MudGrid>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="EditedItem.CustomerPartNumber"
                                  Label="Customer Part Number"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Required="true"
                                  RequiredError="Original part number is required" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="EditedItem.DrawingPartNumber"
                                  Label="Original Part Number"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Required="true"
                                  RequiredError="Original part number is required" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField @bind-Value="EditedItem.DrawingPartNumberPrice"
                                     Label="Drawing P/N Price"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Format="0.#####"
                                     Adornment="Adornment.Start"
                                     AdornmentText="$"
                                     Min="0m" />
                </MudItem>
                @* Pick list from search results stored in the commment after data aseparator *@
                @if (@EditedItem.MatchedPartNumbers.Count > 0)
                {
                    @* MatchedPartNumberUx partNumberUx numbers pick list *@

                }
                @* End pick list *@
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="EditedItem.SwappedPartNumber"
                                  Label="Dummy/Alt. Part Number"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="EditedItem.SwappedPartNumberPrice"
                                     Label="Dummy/Alt. P/N Price"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Format="0.#####"
                                     Adornment="Adornment.Start"
                                     AdornmentText="$"
                                     Min="0m" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="EditedItem.PriceSource"
                                  Label="Price Source"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudCheckBox Value="EditedItem.IsExactMatch"
                                 ReadOnly="true"    
                                 Label="Is Exact Match"
                                 Color="Color.Primary"
                                 Dense="true" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudCheckBox Value="EditedItem.IsSwapped"
                                 ReadOnly="true"
                                 Label="Is Swapped"
                                 Color="Color.Primary"
                                 Dense="true" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudCheckBox Value="EditedItem.IsCompleted"
                                 ReadOnly="true"
                                 Label="Is Matched"
                                 Color="Color.Primary"
                                 Dense="true" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="EditedItem.Comments"
                                  Label="Comments"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Lines="3"
                                  MaxLength="500" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Value="@EditedItem.RowId.ToString()"
                                  Label="Row ID"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  ReadOnly="true"
                                  Disabled="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Value="@EditedItem.RfqId.ToString()"
                                  Label="RFQ ID"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  ReadOnly="true"
                                  Disabled="true" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="PickDummy" 
                   Color="Color.Secondary" 
                   Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Add"
                   Style="margin-right: 8px;">
            Pick Dummy
        </MudButton>
        <MudButton OnClick="CreateNpr" 
                   Color="Color.Info" 
                   Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.NoteAdd"
                   Style="margin-right: auto;">
            Create NPR
        </MudButton>
        <MudButton OnClick="Complete"
                   Disabled="!EditedItem.IsCompleted"
                   Color="Color.Info"
                   Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.IncompleteCircle"
                   Style="margin-right: auto;">
            Complete
        </MudButton>
        <MudButton OnClick="Cancel" Color="Color.Default">Cancel</MudButton>
        <MudButton OnClick="Save" Color="Color.Primary" Variant="Variant.Filled" Disabled="!_isValid">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public RfqDrawingPartNumberUx OriginalItem { get; set; } = null!;

    private RfqDrawingPartNumberUx EditedItem { get; set; } = new();
    private MudForm _form = null!;
    private bool _isValid;

    protected override void OnInitialized()
    {
        // Create a copy of the original item to edit
        EditedItem = new RfqDrawingPartNumberUx
        {
            RowId = OriginalItem.RowId,
            RfqId = OriginalItem.RfqId,
            CustomerPartNumber = OriginalItem.CustomerPartNumber,
            DrawingPartNumber = OriginalItem.DrawingPartNumber,
            DrawingPartNumberPrice = OriginalItem.DrawingPartNumberPrice,
            SwappedPartNumber = OriginalItem.SwappedPartNumber,
            SwappedPartNumberPrice = OriginalItem.SwappedPartNumberPrice,
            PriceSource = OriginalItem.PriceSource,
            IsExactMatch = OriginalItem.IsExactMatch,
            IsSwapped = OriginalItem.IsSwapped,
            Comments = OriginalItem.Comments
        };
    }

    private async Task PickDummy()
    {
        DialogOptions options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseOnEscapeKey = true,
            BackdropClick = false
        };

        IDialogReference dialog = await DialogService.ShowAsync<PickDummyPartDialog>(
            "Pick Dummy Part",
            options
        );

        DialogResult? result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is PickDummyPartDialog.DummyPartData dummyData)
        {
            // Update the EditedItem with dummy part data
            EditedItem.SwappedPartNumber = dummyData.PartNumber;
            EditedItem.SwappedPartNumberPrice = dummyData.Price;
            EditedItem.IsSwapped = true;
            EditedItem.IsExactMatch = false;
            EditedItem.PriceSource = "Dummy";

            // Force UI refresh
            StateHasChanged();
        }
    }

    private async Task CreateNpr()
    {
        DialogOptions options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseOnEscapeKey = true,
            BackdropClick = false
        };

        IDialogReference dialog = await DialogService.ShowAsync<CreateNprDialog>(
            "Create NPR",
            options
        );

        DialogResult? result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is CreateNprDialog.NprData nprData)
        {
            // For now, do not assign the information
            // TODO: Handle NPR data assignment when requirements are defined
            // nprData.NprNumber and nprData.NprDate are available here
        }
    }
    private async Task Complete()
    {
        await _form.Validate();
        if (!_isValid)
        {
            return;
        }

        // Check if the part has drawing part number with price OR swapped part number with swapped price
        bool hasDrawingPartNumberWithPrice = !string.IsNullOrWhiteSpace(EditedItem.DrawingPartNumber) 
            && EditedItem.DrawingPartNumberPrice.HasValue 
            && EditedItem.DrawingPartNumberPrice.Value > 0;

        bool hasSwappedPartNumberWithPrice = !string.IsNullOrWhiteSpace(EditedItem.SwappedPartNumber) 
            && EditedItem.SwappedPartNumberPrice.HasValue 
            && EditedItem.SwappedPartNumberPrice.Value > 0;

        if (hasDrawingPartNumberWithPrice || hasSwappedPartNumberWithPrice)
        {
            // If hasDrawingPartNumberWithPrice
            if (hasDrawingPartNumberWithPrice)
            {
                EditedItem.IsExactMatch = true;
            }

            // If swapped part number is set with price, mark as swapped
            if (hasSwappedPartNumberWithPrice)
            {
                EditedItem.IsSwapped = true;
            }

            // Close dialog and return the edited item
            // The IsCompleted property will automatically return true based on the logic in the model
            MudDialog.Close(DialogResult.Ok(EditedItem));
        }
        else
        {
            // Show validation message if neither condition is met
            await DialogService.ShowMessageBox(
                "Incomplete Part Number",
                "To complete this part number, you must have either:\n" +
                "- A drawing part number with a price, OR\n" +
                "- A swapped part number with a swapped price",
                "OK"
            );
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task Save()
    {
        await _form.Validate();
        if (_isValid)
        {
            MudDialog.Close(DialogResult.Ok(EditedItem));
        }
    }
}