@using System.Net.Http.Json
@using SalesSystem.Rfq.Enums
@using SharedModels.Filtering

@inject RfqUxClientService RfqUxClientService
@inject ISnackbar Snackbar
@inject ILogger<PartNumbersEditGrid> Logger
@inject IDialogService DialogService

<style>
    :root {
        --appbar-height: 64px;
        --pane-gap: 16px;
        --dashboard-background: #f2f2f2;
        --rfq-grid-height: 12px;
    }

    .mud-parts-list .mud-table-head {
        background-color: lightgrey;
    }

        .mud-parts-list .mud-table-head th {
            background-color: lightgrey;
        }

    .mud-parts-list {
        overflow-x: hidden !important;
        border: 1px solid #bdbdbd;
        border-radius: 4px;
    }

    .mud-table-sticky-header {
        position: sticky;
        top: 0;
        z-index: 1;
        background-color: var(--mud-palette-surface);
    }
    /* Bottom panels */
    .data-pane {
        display: flex;
        flex-direction: column;
        padding: 6px;
    }

    .pane-title {
        padding-top: 1px;
        padding-bottom: 1px;
        padding-left: 4px;
        padding-right: 4px;
        flex: 0 0 auto;
        margin: 0 0 4px 0;
    }

    .table-host {
        display: flex;
        flex: 1 1 auto;
        min-height: 0;
        overflow: hidden;
    }
    /*
            DataGrid:
            - FixedHeader keeps the DataGrid header visible.
            - The toolbar is outside the table's scrolling container.
            - Fixed table layout plus widths summing to 100% prevents horizontal scrolling.
        */
    .mud-parts-list {
        overflow: hidden;
    }

        .mud-parts-list .mud-table-container {
            overflow-x: hidden !important;
            overflow-y: auto !important;
        }

        .mud-parts-list table {
            width: 100% !important;
            table-layout: fixed !important;
        }

        .mud-parts-list .mud-table-cell {
            padding: 1px !important;
            overflow: hidden;
            font-size: var(--rfq-grid-height) !important;
            line-height: 1;
            text-align: left;
            text-overflow: ellipsis;
            vertical-align: middle;
            white-space: nowrap;
        }

        .mud-parts-list .mud-table-head .mud-table-cell {
            font-size: 14px !important;
            font-weight: 700;
        }

    .row-action-buttons .mud-icon-button {
        height: var(--rfq-grid-height);
    }

    .toolbar-row {
        display: grid;
        grid-template-columns: minmax(0, 5fr) minmax(0, 3.5fr) minmax(0, 1.5fr);
        width: 100%;
        min-width: 0;
        min-height: 0;
    }
    /* Ensure MudBlazor's own toolbar wrapper doesn't constrain the width we set above */
    .mud-parts-list .mud-table-toolbar,
    .mud-parts-list .mud-toolbar {
        width: 100%;
        max-width: 100%;
        padding-left: 0 !important;
        padding-right: 0 !important;
        height: 36px;
    }

        .mud-parts-list .mud-toolbar .mud-input-slot {
            margin-top: 0;
            margin-bottom: 0px;
        }

    .quick-search {
        padding-top: 0px;
        padding-bottom: 0px;
    }
</style>
<div class="d-flex flex-column" style="height: 100%; overflow: hidden;">
    <MudDataGrid T="RfqDrawingPartNumberUxModel"
                 Items="@PartNumbers"
                 ReadOnly="false"
                 EditMode="DataGridEditMode.Form"
                 Bordered="true"
                 Dense="true"
                 EditTrigger="DataGridEditTrigger.Manual"
                 FixedHeader="true"
                 Height="calc(100% - 16px)"
                 Class="mud-parts-list"
                 Style="flex: 1 1 auto; min-height: 0; overflow-y: auto; margin: 8px 0;"
                 RowStyleFunc="@RowStyleFunc"
                 ColumnResizeMode="ResizeMode.Column">
        <Columns>
            <PropertyColumn Property="x => x.CustomerPartNumber" Title="Customer Part N°" />
            <PropertyColumn Property="x => x.PartNumber1" Title="Part Number 1" Hidden="true" />
            <PropertyColumn Property="x => x.PartNumber2" Title="Part Number 2" />
            <PropertyColumn Property="x => x.PartNumber3" Title="Part Number 3" />
            <PropertyColumn Property="x => x.DrawingPartNumber"
                            Title="Drawing P/N" />
            <PropertyColumn Property="x => x.DrawingPartNumberPrice"
                            Title="Drawing P/N Price"
                            Format="0.##### €" />
            <PropertyColumn Property="x => x.Quantity"
                            Title="Quantity"
                            Format="0.####" />
            <PropertyColumn Property="x => x.SwappedPartNumber"
                            Title="Dummy/Alt. P/N" />
            <PropertyColumn Property="x => x.SwappedPartNumberPrice"
                            Title="Dummy/Alt. P/N Price"
                            Format="0.##### €" />
            <PropertyColumn Property="x => x.PriceSource"
                            Title="Price Source" />
            <PropertyColumn Property="x => x.IsExactMatch"
                            Title="Exact Match" />
            <PropertyColumn Property="x => x.IsSwapped"
                            Title="Swapped" />
            <TemplateColumn Title="Actions"
                            HeaderStyle="width: 96px;"
                            CellStyle="width: 96px;"
                            StickyRight="true"
                            CellClass="rfq-actions-cell">
                <CellTemplate>
                    <MudTooltip Text="Search Part Number">
                        <MudIconButton Size="@Size.Small"
                                       Color="Color.Primary"
                                       Icon="@Icons.Material.Filled.Search"
                                       aria-label="search"
                                       OnClick="@(async () => await OnSearch(context.Item))" />
                    </MudTooltip>
                    <MudTooltip Text="Edit Part Number">
                        <MudIconButton Size="@Size.Small"
                                       Color="Color.Primary"
                                       Icon="@Icons.Material.Filled.Edit"
                                       aria-label="edit"
                                       OnClick="@(async () => await OnEdit(context.Item))" />
                    </MudTooltip>
                    <MudTooltip Text="Delete Part Number">
                        <MudIconButton Size="@Size.Small"
                                       Color="Color.Primary"
                                       Icon="@Icons.Material.Filled.Delete"
                                       aria-label="delete"
                                       OnClick="@(async () => await OnDelete(context.Item))" />
                    </MudTooltip>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </MudDataGrid>
</div>

<style>
    /* .mud-grid-no-scroll-x {
            overflow-x: hidden !important;
        } */
    .mud-table-sticky-header {
        position: sticky;
        top: 0;
        z-index: 1;
        background-color: var(--mud-palette-surface);
    }
</style>

@code {
    [Parameter] public IEnumerable<RfqDrawingPartNumberUxModel?> PartNumbers { get; set; } = new List<RfqDrawingPartNumberUxModel>();
    [Parameter] public EventCallback<RfqDrawingPartNumberUxModel> OnPartNumberDeleted { get; set; }
    [Parameter] public EventCallback<RfqDrawingPartNumberUxModel> OnPartNumberUpdated { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(1);
    }

    private string RowStyleFunc(RfqDrawingPartNumberUxModel item, int index)
    {
        if (item == null)
        {
            return string.Empty;
        }

        // Return color based on Status property
        string color = item.Status switch
        {
            RfqDrawingPartNumberStatus.Completed => "background-color: #66BB6A;",
            RfqDrawingPartNumberStatus.ContainsMatch => "background-color: lightyellow;",
            RfqDrawingPartNumberStatus.ExactMatch => "background-color: lightcoral;",
            RfqDrawingPartNumberStatus.AlternativePartSelected => "background-color: lightblue;",
            RfqDrawingPartNumberStatus.NprRequested => "background-color: lightmagenta;",
            _ => string.Empty,
        };

        // Special case: if ContainsMatch and has a priced result, use lighter green
        if (item.Status == RfqDrawingPartNumberStatus.ContainsMatch
            && item.SearchResultPartNumbers != null
            && item.SearchResultPartNumbers.Count > 0
            && item.SearchResultPartNumbers.Any(x => (x?.DrawingPartNumberPrice ?? 0.0m) > 0.0m))
        {
            color = "background-color: #A5D6A7;";
        }

        return color;
    }

    private async Task OnSearch(RfqDrawingPartNumberUxModel item)
    {
        if (item == null)
        {
            Logger.GenericLogInformation($"No part number found for null item...");
            await DialogService.ShowMessageBoxAsync("Search Part Number", $"No part number found for null item...");
            return;
        }

        // Just in case this was previously searched
        item.SearchResultPartNumbers.Clear();
        item.Comments = "";

        Logger.GenericLogInformation($"Searching for part number: {item.CustomerPartNumber}");

        var cleanedUpPn = item.CustomerPartNumber?.Replace("-", "").Replace(" ", "").ToUpperInvariant();
        if (string.IsNullOrEmpty(cleanedUpPn))
        {
            Logger.GenericLogInformation($"No valid part number found for item with Row ID: {item.RowId}");
            await DialogService.ShowMessageBoxAsync("Search Part Number", $"No valid part number found for item with Row ID: {item.RowId}");
            return;
        }

        try
        {
            // Call SearchEmacsContainsCustomerPn
            if (item.CustomerPartNumber == null)
            {
                Logger.GenericLogInformation("CustomerPartNumber is null");
                return;
            }

            SearchPartPricesGrpcResponse response = await RfqUxClientService.SearchPartPricesAsync(
                new List<string> { item.CustomerPartNumber });

            PriceResponse? priceResponse = response.PriceResponse
                .FirstOrDefault(pr =>
                    string.Equals(
                        pr.CustomerPartNumber,
                        item.CustomerPartNumber,
                        StringComparison.OrdinalIgnoreCase));

            if(priceResponse?.PriceInformation != null && priceResponse.PriceInformation.Count>0)
            {
                // Show custom dialog with MudList
                int index = 0;

                var commentData = new RfqDrawingPartNumberUxSearchResult();
                commentData.User = "System";
                commentData.Timestamp = DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm:ss.fffZ");
                commentData.Action = "Individual search";

                // just add all to the search list
                foreach (var priceInfo in priceResponse.PriceInformation)
                {
                    var matchedPartNumber = new RfqDrawingPartNumberUxModel();
                    matchedPartNumber.IsExactMatch = priceInfo.SumitomoNumber
                                                                .ToUpperInvariant()
                                                                .CompareTo(item.CustomerPartNumber.ToUpperInvariant()) == 0;
                    matchedPartNumber.Index = index++;
                    matchedPartNumber.DrawingPartNumber = priceInfo.SumitomoNumber;
                    matchedPartNumber.DrawingPartNumberPrice = priceInfo.Price is null ? 0.0m : (decimal)priceInfo.Price;
                    item.SearchResultPartNumbers.Add(matchedPartNumber);
                }

                DialogParameters parameters = new DialogParameters
                {
                    { "SearchedPartNumber", item },
                };

                DialogOptions options = new DialogOptions
                {
                    MaxWidth = MaxWidth.Large,
                    FullWidth = true,
                    CloseOnEscapeKey = true,
                    BackdropClick = false
                };

                IDialogReference dialog = await DialogService.ShowAsync<SearchPartNumberDialog>(
                    "Search Results",
                    parameters,
                    options
                );

                // Wait for dialog result
                DialogResult? result = await dialog.Result;

                if (result != null && !result.Canceled && result.Data is RfqDrawingPartNumberUxModel updatedItem)
                {
                    try
                    {
                        Logger.GenericLogInformation($"Search data applied to part number: {updatedItem.CustomerPartNumber}/{updatedItem.DrawingPartNumber}");

                        // Call the service to update the part number
                        bool success = await RfqUxClientService.UpdateRfqDrawingPartNumber(updatedItem);

                        if (success)
                        {
                            // Update the original item's properties with the updated values
                            item.DrawingPartNumber = updatedItem.DrawingPartNumber;
                            item.DrawingPartNumberPrice = updatedItem.DrawingPartNumberPrice;
                            item.SwappedPartNumber = updatedItem.SwappedPartNumber;
                            item.SwappedPartNumberPrice = updatedItem.SwappedPartNumberPrice;
                            item.PriceSource = updatedItem.PriceSource;
                            item.IsExactMatch = updatedItem.IsExactMatch;
                            item.IsSwapped = updatedItem.IsSwapped;
                            item.Comments = updatedItem.Comments;

                            item.SearchResultPartNumbers.Clear();
                            item.SearchResultPartNumbers.AddRange(updatedItem.SearchResultPartNumbers);

                            Logger.GenericLogInformation($"Successfully updated part number with NPR data: {updatedItem.CustomerPartNumber}/{updatedItem.DrawingPartNumber}");
                            Snackbar.Add($"Part number {updatedItem.CustomerPartNumber}/{updatedItem.DrawingPartNumber} updated with NPR data", Severity.Success);

                            // Notify parent component to refresh and potentially move between lists
                            await OnPartNumberUpdated.InvokeAsync(updatedItem);

                            StateHasChanged();
                        }
                        else
                        {
                            Logger.GenericLogInformation($"Failed to update part number: {updatedItem.CustomerPartNumber}/{updatedItem.DrawingPartNumber}");
                            Snackbar.Add($"Failed to update part number {updatedItem.CustomerPartNumber}/{updatedItem.DrawingPartNumber}", Severity.Error);
                        }
                    }
                    catch (Exception ex)
                    {
                        Logger.GenericLogError($"Error updating part number with NPR data: {updatedItem.CustomerPartNumber}/{updatedItem.DrawingPartNumber}", ex);
                        Snackbar.Add($"Error updating part number: {ex.Message}", Severity.Error);
                    }
                }
                else
                {
                    Logger.GenericLogInformation("Search dialog was closed without applying NPR data");
                }
            }
            else
            {
                string message = $"No results found for part number: {item.CustomerPartNumber}";
                Logger.GenericLogInformation(message);

                // Show empty results dialog

                DialogParameters parameters = new DialogParameters
                {
                    { "SearchedPartNumber", item },
                };
                // DialogParameters parameters = new DialogParameters
                // {
                //     { "SearchedPartNumber", item },
                //     { "SearchResults", new List<string?>() },
                // };

                DialogOptions options = new DialogOptions
                {
                    MaxWidth = MaxWidth.Large,
                    FullWidth = true,
                    CloseOnEscapeKey = true,
                    BackdropClick = false
                };

                await DialogService.ShowAsync<SearchPartNumberDialog>(
                    "Search Results",
                    parameters,
                    options
                );
            }
        }
        catch (Exception ex)
        {
            Logger.GenericLogError($"Error searching for part number: {item.CustomerPartNumber}/{item.DrawingPartNumber}", ex);
            await DialogService.ShowMessageBoxAsync(
                "Error",
                $"An error occurred while searching: {ex.Message}"
            );
        }
    }

    private async Task OnEdit(RfqDrawingPartNumberUxModel item)
    {
        if (item == null)
        {
            Logger.GenericLogInformation("Edit called with null item");
            return;
        }

        DialogParameters parameters = new DialogParameters
        {
            { "OriginalItem", item }
        };

        DialogOptions options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseOnEscapeKey = true,
            BackdropClick = false
        };

        IDialogReference dialog = await DialogService.ShowAsync<EditPartNumberDialog>(
            "Edit Part Number",
            parameters,
            options
        );

        DialogResult? result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is RfqDrawingPartNumberUxModel editedItem)
        {
            try
            {
                Logger.GenericLogInformation($"Updating part number: {editedItem.CustomerPartNumber}/{editedItem.DrawingPartNumber} (Row ID: {editedItem.RowId})");

                // Call the service to update the part number
                bool success = await RfqUxClientService.UpdateRfqDrawingPartNumber(editedItem);

                if (success)
                {
                    // Update the original item with edited values
                    item.DrawingPartNumber = editedItem.DrawingPartNumber;
                    item.DrawingPartNumberPrice = editedItem.DrawingPartNumberPrice;
                    item.SwappedPartNumber = editedItem.SwappedPartNumber;
                    item.SwappedPartNumberPrice = editedItem.SwappedPartNumberPrice;
                    item.PriceSource = editedItem.PriceSource;
                    item.IsExactMatch = editedItem.IsExactMatch;
                    item.IsSwapped = editedItem.IsSwapped;
                    item.Comments = editedItem.Comments;

                    Logger.GenericLogInformation($"Successfully updated part number: {editedItem.CustomerPartNumber}/{editedItem.DrawingPartNumber}");
                    Snackbar.Add($"Part number {editedItem.CustomerPartNumber}/{editedItem.DrawingPartNumber} updated successfully", Severity.Success);

                    // Notify parent component
                    await OnPartNumberUpdated.InvokeAsync(editedItem);

                    StateHasChanged();
                }
                else
                {
                    Logger.GenericLogInformation($"Failed to update part number: {editedItem.CustomerPartNumber}/{editedItem.DrawingPartNumber}");
                    Snackbar.Add($"Failed to update part number {editedItem.CustomerPartNumber}/{editedItem.DrawingPartNumber}", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Logger.GenericLogError($"Error updating part number: {editedItem.CustomerPartNumber}/{editedItem.DrawingPartNumber}", ex);
                await DialogService.ShowMessageBoxAsync(
                    "Error",
                    $"An error occurred while updating the part number: {ex.Message}"
                );
            }
        }
        else
        {
            Logger.GenericLogInformation($"Edit cancelled for part number: {item.CustomerPartNumber}");
        }
    }

    private async Task OnDelete(RfqDrawingPartNumberUxModel item)
    {
        if (item == null)
        {
            Logger.GenericLogInformation("Delete called with null item");
            return;
        }

        // Build confirmation message with part number details
        System.Text.StringBuilder messageBuilder = new System.Text.StringBuilder();
        messageBuilder.AppendLine("Are you sure you want to delete this part number?");
        messageBuilder.AppendLine();
        messageBuilder.AppendLine($"Row ID: {item.RowId}");
        messageBuilder.AppendLine($"RFQ ID: {item.RfqId}");
        messageBuilder.AppendLine($"Customer Part Number: {item.CustomerPartNumber ?? "N/A"}");
        messageBuilder.AppendLine($"Drawing Part Number: {item.DrawingPartNumber ?? "N/A"}");
        messageBuilder.AppendLine($"Drawing Part Number Price: {(item.DrawingPartNumberPrice > 0 ? $"${item.DrawingPartNumberPrice.ToString("C5")}" : "N/A")}");
        messageBuilder.AppendLine($"Dummy/Alt. Part Number: {item.SwappedPartNumber ?? "N/A"}");
        messageBuilder.AppendLine($"Dummy/Alt. Price: {(item.SwappedPartNumberPrice > 0 ? $"${item.SwappedPartNumberPrice.ToString("C5")}" : "N/A")}");
        messageBuilder.AppendLine($"Price Source: {item.PriceSource ?? "N/A"}");
        messageBuilder.AppendLine($"Is Exact Match: {(item.IsExactMatch == true ? "YES" : "NO")}");
        messageBuilder.AppendLine($"Is Swapped: {(item.IsSwapped == true ? "YES" : "NO")}");
        messageBuilder.AppendLine($"Is Matched: {item.IsCompleted}");
        messageBuilder.AppendLine($"Comments: {item.Comments ?? "N/A"}");

        bool? result = await DialogService.ShowMessageBoxAsync(
            "Confirm Delete",
            messageBuilder.ToString(),
            yesText: "Delete",
            cancelText: "Cancel"
        );

        if (result == true)
        {
            try
            {
                Logger.GenericLogInformation($"Deleting part number: {item.CustomerPartNumber}/{item.DrawingPartNumber} (Row ID: {item.RowId})");

                // Call the service to delete the part number
                bool success = await RfqUxClientService.DeleteRfqDrawingPartNumbers(new List<RfqDrawingPartNumberUxModel> { item });

                if (success)
                {
                    Logger.GenericLogInformation($"Successfully deleted part number: {item.CustomerPartNumber}/{item.DrawingPartNumber}");
                    Snackbar.Add($"Part number {item.CustomerPartNumber}/{item.DrawingPartNumber} deleted successfully", Severity.Success);

                    // Notify parent component to remove the item
                    await OnPartNumberDeleted.InvokeAsync(item);
                }
                else
                {
                    Logger.GenericLogInformation($"Failed to delete part number: {item.CustomerPartNumber}/{item.DrawingPartNumber}");
                    Snackbar.Add($"Failed to delete part number {item.CustomerPartNumber}/{item.DrawingPartNumber}", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Logger.GenericLogError($"Error deleting part number: {item.CustomerPartNumber}/{item.DrawingPartNumber}", ex);
                await DialogService.ShowMessageBoxAsync(
                    "Error",
                    $"An error occurred while deleting the part number: {ex.Message}"
                );
            }
        }
        else
        {
            Logger.GenericLogInformation($"Delete cancelled for part number: {item.CustomerPartNumber}/{item.DrawingPartNumber}");
        }
    }
}