    private async Task ShowDatasetStatusAsync()
    {
        try
        {
            Logger.GenericLogInformation($"EditRfq.ShowDatasetStatusAsync - Displaying status for {TotalParts} parts ({MatchedParts.Count} matched, {UnmatchedParts.Count} unmatched)");

            DialogParameters statusParams = new DialogParameters
            {
                { "MatchedParts", MatchedParts },
                { "UnmatchedParts", UnmatchedParts }
            };

            DialogOptions statusOptions = new DialogOptions
            {
                MaxWidth = MaxWidth.Large,
                FullWidth = true,
                CloseOnEscapeKey = true,
                BackdropClick = false
            };

            await DialogService.ShowAsync<DatasetStatusDialog>(
                "Dataset Status",
                statusParams,
                statusOptions
            );
        }
        catch (Exception ex)
        {
            Logger.GenericLogError("EditRfq.ShowDatasetStatusAsync - Error showing dataset status", ex);
            Snackbar.Add($"Error displaying status: {ex.Message}", Severity.Error);
        }
    }
