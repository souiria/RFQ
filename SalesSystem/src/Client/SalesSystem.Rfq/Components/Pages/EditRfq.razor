    #region File handling
    private void OnFilesChanged()
    {
        StateHasChanged();
    }
    private async Task HandleFileRemoval(FileObjectUx fileObject)
    {
        try
        {
            Logger.GenericLogInformation($"CreateRfq.HandleFileRemoval - Starting removal for file: {fileObject.DisplayName} (ID: {fileObject.Id})");

            // Check if file can be safely removed
            if (fileObject.CanBeRemovedSafely)
            {
                // Remove completely from collection to prevent InputFile issues
                bool removed = FileObjects.Remove(fileObject);

                if (removed)
                {
                    // Reset the FileManager's InputFile component to clear internal state
                    if (componentFileManager != null)
                    {
                        await componentFileManager.ResetInputFileAsync();
                    }

                    Logger.GenericLogInformation($"CreateRfq.HandleFileRemoval - Completely removed file: {fileObject.DisplayName}");
                    Snackbar.Add($"File '{fileObject.DisplayName}' removed successfully", Severity.Success);
                }
                else
                {
                    Logger.GenericLogInformation($"CreateRfq.HandleFileRemoval - File not found in collection: {fileObject.DisplayName}");
                }
            }
            else
            {
                // Keep in collection but mark as deleted for uploaded files
                fileObject.Status = UxObjectStatus.Deleted;
                Logger.GenericLogInformation($"CreateRfq.HandleFileRemoval - Marked uploaded file as deleted: {fileObject.DisplayName}");
                Snackbar.Add($"File '{fileObject.DisplayName}' marked as deleted", Severity.Info);
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.GenericLogError($"CreateRfq.HandleFileRemoval - Error removing file: {fileObject.DisplayName}", ex);
            Snackbar.Add($"Error removing file: {ex.Message}", Severity.Error);
        }
    }
    #endregion

    private async Task HandlePartNumberDeleted(RfqDrawingPartNumberUx deletedItem)
    {
        try
        {
            // Remove from the appropriate collection
            if (deletedItem.IsMatched)
            {
                MatchedParts.Remove(deletedItem);
                Logger.GenericLogInformation($"EditRfq.HandlePartNumberDeleted - Removed matched part: {deletedItem.CustomerPartNumber}");
            }
            else
            {
                UnmatchedParts.Remove(deletedItem);
                Logger.GenericLogInformation($"EditRfq.HandlePartNumberDeleted - Removed unmatched part: {deletedItem.CustomerPartNumber}");
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.GenericLogError($"EditRfq.HandlePartNumberDeleted - Error handling deletion of part: {deletedItem.CustomerPartNumber}", ex);
        }

        await Task.CompletedTask;
    }

    private async Task HandlePartNumberUpdated(RfqDrawingPartNumberUx updatedItem)
    {
        try
        {
            // Find the item in both lists
            var matchedItem = MatchedParts.FirstOrDefault(p => p?.RowId == updatedItem.RowId);
            var unmatchedItem = UnmatchedParts.FirstOrDefault(p => p?.RowId == updatedItem.RowId);

            // Determine current location
            bool isInMatchedList = matchedItem != null;
            bool isInUnmatchedList = unmatchedItem != null;

            // Check if the IsMatched status changed and item needs to move between lists
            if (updatedItem.IsMatched && isInUnmatchedList)
            {
                // Move from unmatched to matched
                UnmatchedParts.Remove(unmatchedItem);
                MatchedParts.Add(updatedItem);
                Logger.GenericLogInformation($"EditRfq.HandlePartNumberUpdated - Moved part to matched: {updatedItem.CustomerPartNumber}");
            }
            else if (!updatedItem.IsMatched && isInMatchedList)
            {
                // Move from matched to unmatched
                MatchedParts.Remove(matchedItem);
                UnmatchedParts.Add(updatedItem);
                Logger.GenericLogInformation($"EditRfq.HandlePartNumberUpdated - Moved part to unmatched: {updatedItem.CustomerPartNumber}");
            }
            else if (isInMatchedList)
            {
                // Update in place in matched list
                var index = MatchedParts.IndexOf(matchedItem);
                if (index >= 0)
                {
                    MatchedParts[index] = updatedItem;
                }
                Logger.GenericLogInformation($"EditRfq.HandlePartNumberUpdated - Updated matched part: {updatedItem.CustomerPartNumber}");
            }
            else if (isInUnmatchedList)
            {
                // Update in place in unmatched list
                var index = UnmatchedParts.IndexOf(unmatchedItem);
                if (index >= 0)
                {
                    UnmatchedParts[index] = updatedItem;
                }
                Logger.GenericLogInformation($"EditRfq.HandlePartNumberUpdated - Updated unmatched part: {updatedItem.CustomerPartNumber}");
            }

            // Force UI refresh
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.GenericLogError($"EditRfq.HandlePartNumberUpdated - Error handling update of part: {updatedItem.CustomerPartNumber}", ex);
        }

        await Task.CompletedTask;
    }
