    #region Search All
    private async Task SearchAllPartNumbersAsync()
    {
        if (InProgressParts.Count == 0)
        {
            Snackbar.Add("No unmatched parts to search", Severity.Info);
            return;
        }

        _isSearchingAll = true;
        _searchCancellationTokenSource = new CancellationTokenSource();

        try
        {
            Logger.GenericLogInformation($"EditRfq.SearchAllInProgressPartsAsync - Starting search for {InProgressParts.Count} unmatched parts");

            int totalCount = InProgressParts.Count;

            // Create progress state
            var progressState = new SearchProgressState(totalCount, _searchCancellationTokenSource);

            // Create progress dialog parameters
            DialogParameters progressParams = new DialogParameters
            {
                { "ProgressState", progressState }
            };

            DialogOptions progressOptions = new DialogOptions
            {
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
                CloseOnEscapeKey = false,
                BackdropClick = true
            };

            IDialogReference progressDialog = await DialogService.ShowAsync<SearchProgressDialog>(
                "Search Progress",
                progressParams,
                progressOptions
            );

            // List to track parts that need to be moved (ONLY exact matches)
            List<RfqDrawingPartNumberUxModel> partsToMove = new List<RfqDrawingPartNumberUxModel>();

            int processedCount = 0;
            int totalSearched = 0;
            int totalCompleted = 0;  // Only exact matches
            int totalInProgress = 0;
            int multiMatchCount = 0;

            // Process each unmatched part
            foreach (RfqDrawingPartNumberUxModel? part in InProgressParts.ToList())
            {
                if (_searchCancellationTokenSource.Token.IsCancellationRequested)
                {
                    Logger.GenericLogInformation("EditRfq.SearchAllInProgressPartsAsync - Search cancelled by user");
                    break;
                }

                if (part == null || string.IsNullOrWhiteSpace(part.CustomerPartNumber))
                {
                    continue;
                }

                string currentPartNumber = part.CustomerPartNumber;
                Logger.GenericLogInformation($"EditRfq.SearchAllInProgressPartsAsync - Searching part {processedCount + 1}/{totalCount}: {currentPartNumber}");

                #region search part number in EMACS
                try
                {
                    // Clean up part number
                    string cleanedUpPn = part.CustomerPartNumber.Replace("-", "").Replace(" ", "").ToUpperInvariant();

                    // Search EMACS for Sumitomo part numbers
                    SearchResultUxModel emacsExactResponse = await RfqUxClientService.SearchEmacsExactCustomerPn(cleanedUpPn);
                    SearchResultUxModel emacsContainsResponse = await RfqUxClientService.SearchEmacsContainsCustomerPn(cleanedUpPn);

                    totalSearched++;

                    if (emacsExactResponse.IsSuccessful && emacsExactResponse.StringList != null && emacsExactResponse.StringList.Count > 0)
                    {
                        part.Status = RfqDrawingPartNumberStatus.ExactMatch;

                        foreach (var emacsPart in emacsExactResponse.StringList)
                        {
                            Logger.GenericLogInformation($"EditRfq.SearchAllInProgressPartsAsync - EMACS Exact match found for: {currentPartNumber} -> {emacsPart}");
                            var nprPartSearch = await RfqUxClientService.SearchNprSewsePn(emacsPart);
                            if (nprPartSearch.IsSuccessful && nprPartSearch.StringList != null && nprPartSearch.StringList.Count > 0)
                            {
                                part.SearchResultPartNumbers.AddRange(nprPartSearch.ToCompletedPartNumbersList(true));
                                part.MultiMatch = nprPartSearch.StringList.Count > 1;

                                Logger.GenericLogInformation($"EditRfq.SearchAllInProgressPartsAsync - NPR Exact match found for EMACS part: {emacsPart} -> {nprPartSearch.StringList.Count}");
                            }
                            else
                            {
                                var exactPartNoPrice = new RfqDrawingPartNumberUxModel();
                                exactPartNoPrice.CustomerPartNumber = part.CustomerPartNumber;
                                exactPartNoPrice.DrawingPartNumber = emacsPart;
                                exactPartNoPrice.IsExactMatch = true;
                                part.SearchResultPartNumbers.Add(exactPartNoPrice);
                                Logger.GenericLogInformation($"EditRfq.SearchAllInProgressPartsAsync - No NPR Exact match found for EMACS part: {emacsPart}");
                            }
                        }
                    }
                    else
                    {
                        Logger.GenericLogInformation($"EditRfq.SearchAllInProgressPartsAsync - No exact EMACS match for: {currentPartNumber}");
                    }

                    if (emacsContainsResponse.IsSuccessful && emacsContainsResponse.StringList != null && emacsContainsResponse.StringList.Count > 0)
                    {
                        part.Status = RfqDrawingPartNumberStatus.ContainsMatch;

                        foreach (var emacsPart in emacsContainsResponse.StringList)
                        {
                            Logger.GenericLogInformation($"EditRfq.SearchAllInProgressPartsAsync - EMACS Contains match found for: {currentPartNumber} -> {emacsPart}");
                            var nprPartSearch = await RfqUxClientService.SearchNprSewsePn(emacsPart);
                            if (nprPartSearch.IsSuccessful && nprPartSearch.StringList != null && nprPartSearch.StringList.Count > 0)
                            {
                                part.SearchResultPartNumbers.AddRange(nprPartSearch.ToCompletedPartNumbersList(false));
                                part.MultiMatch = part.MultiMatch == true ? true : nprPartSearch.StringList.Count > 1;

                                Logger.GenericLogInformation($"EditRfq.SearchAllInProgressPartsAsync - NPR Contains match found for EMACS part: {emacsPart} -> {nprPartSearch.StringList.Count}");
                            }
                            else
                            {
                                var containsPartNoPrice = new RfqDrawingPartNumberUxModel();
                                containsPartNoPrice.CustomerPartNumber = part.CustomerPartNumber;
                                containsPartNoPrice.DrawingPartNumber = emacsPart;
                                containsPartNoPrice.IsExactMatch = false;
                                part.SearchResultPartNumbers.Add(containsPartNoPrice);
                                Logger.GenericLogInformation($"EditRfq.SearchAllInProgressPartsAsync - No NPR Contains match found for EMACS part: {emacsPart}");
                            }
                        }
                    }
                    else
                    {
                        totalInProgress++;
                        Logger.GenericLogInformation($"EditRfq.SearchAllInProgressPartsAsync - No EMACS results (exact or contains) for: {currentPartNumber}");
                    }
                }
                catch (Exception ex)
                {
                    Logger.GenericLogError($"EditRfq.SearchAllInProgressPartsAsync - Error searching part: {currentPartNumber}", ex);
                    totalInProgress++;
                }
                #endregion

                processedCount++;

                // Update progress state
                progressState.UpdateProgress(
                    processedCount,
                    totalSearched,
                    totalCompleted,
                    totalInProgress - totalCompleted,
                    totalSearched - totalCompleted - (totalInProgress - totalCompleted),
                    multiMatchCount,
                    currentPartNumber
                );
            }

            // Move ONLY exact matched parts from InProgressParts to CompletedParts
            foreach (var part in partsToMove)
            {
                InProgressParts.Remove(part);
                CompletedParts.Add(part);
            }

            // Mark as complete
            progressState.Complete();

            Logger.GenericLogInformation($"EditRfq.SearchAllInProgressPartsAsync - Search complete. Searched: {totalSearched}, Exact Matches (Completed): {totalCompleted}, Contains/No Match (InProgress): {totalInProgress}, MultiMatch: {multiMatchCount}");

            // Close progress dialog after a short delay
            await Task.Delay(2000);
            progressDialog.Close();

            Snackbar.Add($"Search complete: {totalCompleted} exact matches moved to completed, {totalInProgress} kept in progress ({multiMatchCount} with multiple matches)", Severity.Success);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.GenericLogError("EditRfq.SearchAllInProgressPartsAsync - Error during search all operation", ex);
            Snackbar.Add($"Error during search: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSearchingAll = false;
            _searchCancellationTokenSource?.Dispose();
            _searchCancellationTokenSource = null;
        }
    }
