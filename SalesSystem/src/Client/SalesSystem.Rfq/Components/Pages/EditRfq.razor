@page "/editRfq/{UserId:guid}/{RfqProjectId:long}"

@using Google.Protobuf.WellKnownTypes
@using SalesSystem.Rfq.Components.Pages.Components
@using SalesSystem.Rfq.Components.Pages.Dialogs
@using SalesSystem.Rfq.Enums
@using SalesSystem.Rfq.Extensions
@using SalesSystem.Rfq.Models

@inject ISnackbar Snackbar
@inject RfqUxClientService RfqUxClientService
@inject ILogger<EditRfq> Logger
@inject IDialogService DialogService
@inject NavigationManager NavigationManager

@rendermode InteractiveServer

@if (IsLoading || RfqProject == null)
{
    <MudContainer Class="d-flex justify-center align-center" Style="height: calc(100vh - 128px);">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large">
            <ChildContent>
                <MudText Typo="Typo.subtitle2">
                    Loading...
                </MudText>
            </ChildContent>
        </MudProgressCircular>
    </MudContainer>
}
else
{
    <MudText Typo="Typo.h5" Class="mb-auto" Align="Align.Center">Edit RFI/RFQ @RfqProject.RfqNumber</MudText>
    <MudGrid Class="position-fixed">
        <MudItem xs="12">
            <MudPaper Class="d-flex flex-row" Style="height:150px;">
                @* Region label *@
                <MudPaper Style="width: 48px; background-color: var(--mud-palette-primary); position: relative; overflow: visible;">
                    <MudText Style="transform: rotate(-90deg); transform-origin: left bottom; white-space: nowrap; position: absolute; bottom: 20px; left: 36px; font-weight: 500; color: white;"
                             Typo="Typo.h6">
                        Edit RFQ/RFI
                    </MudText>
                </MudPaper>

                @* Column 1: Customer + Reason *@
                <MudPaper Class="pa-4" Style="flex: 0 0 20%; max-width:20%; min-width: 20%;">
                    <MudStack>
                        <MudSelect T="string"
                                   Value="@RfqProject.CustomerBusinessUnitId"
                                   For="@(() => RfqProject.CustomerBusinessUnitId)"
                                   ValueChanged="OnCustomerValueChanged"
                                   Label="Customer"
                                   Placeholder="Please Select"
                                   AdornmentIcon="@Icons.Material.Filled.People"
                                   AdornmentColor="Color.Primary">
                            @foreach (var customer in RfqUxClientService.Customers)
                            {
                                <MudSelectItem Value="@customer?.Id">@customer?.CustomerBusinessGroupName</MudSelectItem>
                            }
                        </MudSelect>
                        <MudSelect T="int?"
                                   Value="@(RfqProject.RfqReasonId == 0 ? null : (int?)RfqProject.RfqReasonId)"
                                   ValueChanged="OnReasonValueChanged"
                                   Label="Reason"
                                   Placeholder="Please Select"
                                   AdornmentIcon="@Icons.Material.Filled.Checklist"
                                   AdornmentColor="Color.Primary">
                            @foreach (var reason in RfqUxClientService.Reasons)
                            {
                                <MudSelectItem Value="@((int?)reason.RowId)">@reason.RfqReasonTitle</MudSelectItem>
                            }
                        </MudSelect>
                    </MudStack>
                </MudPaper>

                @* Column 2: Project + VehicleVolume *@
                <MudPaper Class="pa-4" Style="flex: 0 0 20%; max-width:20%; min-width: 20%;">
                    <MudStack>
                        <MudAutocomplete T="RqfCustomerProjectAssociationUxModel"
                                         @ref="_projectAutocomplete"
                                         @bind-Value="selectedProject"
                                         Label="Project"
                                         Placeholder="Search project..."
                                         SearchFunc="@SearchProjects"
                                         ToStringFunc="@(p => p != null ? $"{p.ProjectName} - {p.CustomerName}" : "")"
                                         Strict="false"
                                         ResetValueOnEmptyText="false"
                                         CoerceText="true"
                                         CoerceValue="true"
                                         SelectValueOnTab="true"
                                         AdornmentIcon="@Icons.Material.Filled.DesignServices"
                                         AdornmentColor="Color.Primary"
                                         Dense="true"
                                         Clearable="true"
                                         DebounceInterval="250"
                                         MinCharacters="0"
                                         ShowProgressIndicator="true"
                                         MaxItems="100">
                            <ItemTemplate Context="project">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.body2">
                                        <strong>@project.ProjectName</strong>
                                    </MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @project.CustomerName
                                    </MudText>
                                </MudStack>
                            </ItemTemplate>
                            <NoItemsTemplate>
                                <MudText Typo="Typo.body2" Align="Align.Center" Class="pa-2">
                                    No projects found matching your search.
                                </MudText>
                            </NoItemsTemplate>
                        </MudAutocomplete>

                        <MudNumericField @bind-Value="@RfqProject.VehicleVolume"
                                         Label="Vehicle Volume"
                                         Variant="Variant.Text"
                                         Min="0" />
                    </MudStack>
                </MudPaper>

                @* Column 3: Deadline + IsActive *@
                <MudPaper Class="pa-4" Style="flex: 1 1 20%; max-width:20%; min-width: 192px;">
                    <MudStack>
                        <MudDatePicker Label="Deadline"
                                       @bind-Date="RfqProject.RfqResponseDeadline"
                                       DateFormat="dd.MM.yyyy" />
                        <MudCheckBox Label="Is Active"
                                     @bind-Value="RfqProject.IsActive"
                                     Disabled="true"/>
                    </MudStack>
                </MudPaper>

                @* Column 4: FileManager *@
                <MudPaper Class="pa-2 w-100" Style="flex: 0 0 15%; max-width:15%; min-width: 192px;">
                    <FileManager @ref="componentFileManager"
                                 FileObjects="FileObjects"
                                 OnFilesChanged="OnFilesChanged"
                                 OnUploadClicked="@UploadFilesAsync"
                                 UploadDisabled="@(FileObjects.Count == 0)" />
                </MudPaper>

                @* Controls – scrollable inner wrapper *@
                <MudPaper Class="pa-0"
                          Style="height: 150px; overflow: hidden; flex-shrink: 0;">
                    <div style="height: 100%; overflow-y: auto; padding: 6px;">
                        <MudStack Row Spacing="2">
                            @* Column 1: Search & NPR actions *@
                            <MudStack Spacing="1">
                                <MudTooltip Text="Search All InProgress Parts">
                                    <MudButton Color="Color.Info"
                                               OnClick="@SearchAllPartNumbersAsync"
                                               Variant="Variant.Filled"
                                               Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.TravelExplore"
                                               FullWidth="true"
                                               Disabled="@(InProgressParts.Count == 0 || _isSearchingAll)">
                                        Search
                                    </MudButton>
                                </MudTooltip>
                                <MudTooltip Text="Create NPR Requests for ALL InProgress Parts">
                                    <MudButton Color="Color.Info"
                                               OnClick="@NprAllInProgressPartsAsync"
                                               Variant="Variant.Filled"
                                               Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.AddTask"
                                               FullWidth="true"
                                               Disabled="@(IsCreateNprRequestsPermitted)">
                                        Add NPRs
                                    </MudButton>
                                </MudTooltip>
                            </MudStack>

                            @* Column 2: Status, Reload, Update *@
                            <MudStack Spacing="1">
                                <MudTooltip Text="RFQ Project Stats and Statistics">
                                    <MudButton Color="Color.Dark"
                                               OnClick="@ShowDatasetStatusAsync"
                                               Variant="Variant.Filled"
                                               Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.Assessment"
                                               FullWidth="true"
                                               Disabled="@(TotalParts == 0)">
                                        Status
                                    </MudButton>
                                </MudTooltip>
                                <MudTooltip Text="Reload from DB and Drop Changes">
                                    <MudButton Color="Color.Warning"
                                               OnClick="@ReloadDataAsync"
                                               Variant="Variant.Filled"
                                               Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.Repeat"
                                               FullWidth="true">
                                        Reload
                                    </MudButton>
                                </MudTooltip>
                                <MudTooltip Text="Save to DB">
                                    <MudButton Color="Color.Primary"
                                               OnClick="@SaveDataAsync"
                                               Variant="Variant.Filled"
                                               Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.Save"
                                               FullWidth="true">
                                        Update
                                    </MudButton>
                                </MudTooltip>
                            </MudStack>
                        </MudStack>
                    </div>
                </MudPaper>

            </MudPaper>
        </MudItem>

        <MudItem xs="12" Class="pt-2">
            <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-3">
                <MudTabPanel Text="Parts Lists" Icon="@Icons.Material.Filled.Api" BadgeData='"PROJ"' BadgeColor="Color.Info">
                    <div class="d-flex flex-column" style="height: calc(100vh - 364px); overflow: hidden;">
                        <PartNumberSection PartNumbers="@InProgressParts"
                                           Label="In progress"
                                           BackgroundColor="var(--mud-palette-warning)"
                                           InitiallyExpanded="true"
                                           OnPartNumberDeleted="@HandlePartNumberDeleted"
                                           OnPartNumberUpdated="@HandlePartNumberUpdated" />
                        <MudDivider Style="margin: 4px 0;" />
                        <PartNumberSection PartNumbers="@CompletedParts"
                                           Label="Completed"
                                           BackgroundColor="var(--mud-palette-success)"
                                           InitiallyExpanded="false"
                                           OnPartNumberDeleted="@HandlePartNumberDeleted"
                                           OnPartNumberUpdated="@HandlePartNumberUpdated" />
                    </div>
                </MudTabPanel>
                <MudTabPanel Text="BOM Files" Icon="@Icons.Material.Filled.Api" BadgeData='"BOM"' BadgeColor="Color.Success">
                    <div class="d-flex flex-column" style="height: calc(100vh - 364px); overflow: hidden;">
                        <FileCards @ref="componentFileCards"
                                   FileObjects="FileObjects"
                                   OnRemoveFile="HandleFileRemoval" />
                    </div>
                </MudTabPanel>
                <MudTabPanel Text="@($"NPRs")"
                             Disabled="@(RfqProject.NprRequests == null || RfqProject.NprRequests.Count == 0)"
                             Icon="@Icons.Material.Filled.RequestPage" BadgeData="@(RfqProject.NprRequests?.Count ?? 0)" BadgeColor="Color.Primary">
                    <div class="d-flex flex-column" style="height: calc(100vh - 364px); overflow: hidden;">
                        @if (RfqProject.NprRequests != null && RfqProject.NprRequests.Count > 0)
                        {
                            <NprRequestsEditor @ref="componentNprEditor" RfqProject="RfqProject" />
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Info" Class="ma-4">
                                No NPR requests available. Use the "Add NPRs" button to create NPR requests for in-progress parts.
                            </MudAlert>
                        }
                    </div>
                </MudTabPanel>
            </MudTabs>
        </MudItem>
    </MudGrid>
}

@code {
    // Reference to the FileManager component
    FileManager? componentFileManager;
    FileCards? componentFileCards;
    NprRequestsEditor? componentNprEditor;
    List<FileObjectUxModel> FileObjects { get; set; } = new List<FileObjectUxModel>();

    // Search All state tracking
    private bool _isSearchingAll = false;
    private CancellationTokenSource? _searchCancellationTokenSource;

    // Reference to autocomplete for reset
    private MudAutocomplete<RqfCustomerProjectAssociationUxModel>? _projectAutocomplete;

    // Helper property for total parts count
    private int TotalParts => CompletedParts.Count + InProgressParts.Count;

    // Form related
    bool IsLoading { get; set; } = true;
    RqfProjectUxModel? RfqProject { get; set; }

    // Simplified project selection (like CreateRfq)
    private RqfCustomerProjectAssociationUxModel? selectedProject { get; set; }

    // Track previous selected project to detect changes
    private RqfCustomerProjectAssociationUxModel? _previousSelectedProject;

    [Parameter] public Guid? UserId { get; set; }
    [Parameter] public long RfqProjectId { get; set; }

    // Part numbers data - changed to List for mutability
    List<RfqDrawingPartNumberUxModel?> CompletedParts = new List<RfqDrawingPartNumberUxModel?>();
    List<RfqDrawingPartNumberUxModel?> InProgressParts = new List<RfqDrawingPartNumberUxModel?>();

    protected override async Task OnInitializedAsync()
    {
        if (UserId == null || UserId == Guid.Empty)
        {
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add("UserId is missing in the URL", Severity.Error);
            Logger.GenericLogInformation("EditRfq.OnInitializedAsync - UserId is missing in the URL");
            IsLoading = false;
            NavigationManager.NavigateTo("/");
        }

        try
        {
            if (await LoadDataAsync())
            {
                await LoadNprRequests();
            }
        }
        catch (Exception ex)
        {
            Logger.GenericLogError("EditRfq.OnInitializedAsync - Error loading RFQ project", ex);
            Snackbar.Add("Error loading RFQ project", Severity.Error);
            NavigationManager.NavigateTo("/");
        }
    }

    #region Load rfq data
    async Task<bool> LoadDataAsync()
    {
        if (RfqUxClientService.Customers.Count == 0)
        {
            Func<Guid, Task<int>> guidAsyncService = RfqUxClientService.GetCustomersByUserIdAsync;
            (long timing, int count) = await guidAsyncService.TimeAsyncGuidIntService((Guid)UserId!);
            Logger.GenericLogInformation($"EditRfq.OnInitializedAsync - Loaded {count} customers for UserId {UserId} in {timing}ms");
        }

        if (RfqUxClientService.Reasons.Count == 0)
        {
            Func<Task<int>> guidAsyncService = RfqUxClientService.GetRfqReasonsAsync;
            (long timing, int count) = await guidAsyncService.TimeAsyncVoidIntService();
            Logger.GenericLogInformation($"EditRfq.OnInitializedAsync - Loaded {count} reasons in {timing}ms");
        }

        return await LoadRfqAndPartNumbersAsync();
    }

    async Task<bool> LoadRfqAndPartNumbersAsync()
    {
        bool success = false;
        // get the project
        var rfqProject = await RfqUxClientService.GetRfqProjectByIdAsync(RfqProjectId);
        if (rfqProject == null)
        {
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add($"RFQ Project with Id {RfqProjectId} not found", Severity.Error);
            Logger.GenericLogInformation($"EditRfq.OnInitializedAsync - RFQ Project with Id {RfqProjectId} not found");
            NavigationManager.NavigateTo("/");
            return success;
        }
        else
        {
            Logger.GenericLogInformation($"EditRfq.OnInitializedAsync - Retrieved RFQ Project with Id {rfqProject.RowId} - {rfqProject.RfqNumber} - Customer {rfqProject.CustomerBusinessUnitGuid} / {rfqProject.CustomerBusinessGroupCode} - Project {rfqProject.ProjectGuid} / {rfqProject.ProjectName}");
        }

        if (RfqUxClientService.CustomerProjectAssociations.Count == 0)
        {
            Func<string, Task<int>> stringAsyncService = RfqUxClientService.GetProjectAssociationsByCustomerIdAsync;
            (long timing, int count) = await stringAsyncService.TimeAsyncStringIntService(rfqProject.CustomerBusinessUnitGuid);
            Logger.GenericLogInformation($"EditRfq.OnInitializedAsync - Loaded {count} customerProjectAssociations for CustomerBusinessUnitGuid {rfqProject.CustomerBusinessUnitGuid} in {timing}ms");
        }

        RfqProject = rfqProject.ToUx();
        if (RfqProject == null)
        {
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add($"Error mapping RFQ Project with Id {RfqProjectId}", Severity.Error);
            Logger.GenericLogInformation($"EditRfq.OnInitializedAsync - Error mapping RFQ Project with Id {RfqProjectId}");
            NavigationManager.NavigateTo("/");
            return success;
        }
        else
        {
            // Set the selected project from the loaded RfqProject
            selectedProject = RfqUxClientService.CustomerProjectAssociations
                .FirstOrDefault(p => p.ProjectId == RfqProject.ProjectId);

            _previousSelectedProject = selectedProject;

            IsLoading = false;
            success = true;
            Logger.GenericLogInformation($"EditRfq.OnInitializedAsync - Loaded RFQ Project with Id {RfqProject.RowId} - {RfqProject.RfqNumber} {RfqProject.ProjectId}");
        }

        // get the part numbers
        int partNumbersCount = await RfqUxClientService.GetRfqDrawingPartNumbersByRfqIdAsync(RfqProjectId);
        if (partNumbersCount > 0)
        {
            CompletedParts = RfqUxClientService.RfqDrawingPartNumbers.Where(x => x?.IsCompleted == true).ToList();
            InProgressParts = RfqUxClientService.RfqDrawingPartNumbers.Where(x => !x?.IsCompleted == true).ToList();
        }

        return success;
    }
    #endregion

    #region Load npr requests
    public bool IsCreateNprRequestsPermitted
    {
        get
        {
            int nprRequestAlreadyExists = 0;

            foreach (RfqDrawingPartNumberUxModel? drawingPartNumber in InProgressParts)
            {
                if (RfqProject?.NprRequests.Any(x => x.CustomerPartNumber == drawingPartNumber?.CustomerPartNumber) == true)
                {
                    nprRequestAlreadyExists++;
                }
            }

            return InProgressParts.Count <= nprRequestAlreadyExists;
        }
    }

    async Task LoadNprRequests()
    {
        await Task.Delay(1);
        List<RfqNprRequestUxModel>? nprRequests = await RfqUxClientService.GetNprRequestsByRfqNumberAsync(RfqProject?.RfqNumber);
        if (nprRequests != null)
        {
            RfqProject!.NprRequests = nprRequests;
        }
    }

    // it should be in the ux service
    RfqNprRequestUxModel? GetRfqNprRequestByCustomerNumber(RfqDrawingPartNumberUxModel part)
    {
        return RfqProject?.NprRequests.FirstOrDefault(x => x.CustomerPartNumber?.Trim().ToLowerInvariant() == part.CustomerPartNumber?.Trim().ToLowerInvariant());
    }

    // NprAllInProgressPartsAsync - creates flat list of requests
    private async Task NprAllInProgressPartsAsync()
    {
        if (RfqProject == null)
        {
            Snackbar.Add("No Rfq Project to process for NPR", Severity.Error);
            return;
        }

        if (InProgressParts.Count == 0)
        {
            Snackbar.Add("No unmatched parts to process for NPR", Severity.Info);
            return;                                                                                                             
        }

        try
        {
            bool? confirm = await DialogService.ShowMessageBox(
                "Confirm NPR All",
                $"Are you sure you want to create NPR requests for all {InProgressParts.Count} unmatched part(s)? This will UPDATE CHANGES.",
                yesText: "Create NPR for All",
                cancelText: "Cancel"
            );

            if (confirm != true) return;

            Logger.GenericLogInformation($"EditRfq.NprAllInProgressPartsAsync - Creating NPR for {InProgressParts.Count} unmatched parts");

            await SaveDataAsync();

            List<RfqNprRequestUxModel> nprRequests = new List<RfqNprRequestUxModel>();
            DateTime now = DateTime.UtcNow;

            // check against all npr requests for duplicates
            int count = await RfqUxClientService.GetAllNprRequestsAsync();
            if(count > 0)
            {
                // some records already there
                List<RfqNprRequestUxModel> preExistingNprRequests = new();
                List<RfqDrawingPartNumberUxModel> toNewNprRequests = new();

                // look for same customer part and different rfq project
                foreach (RfqDrawingPartNumberUxModel? r in InProgressParts)
                {
                    if (r is null)
                    {
                        continue;
                    }

                    RfqNprRequestUxModel? found = RfqUxClientService.NprRequests.FirstOrDefault(x => (r?.CustomerPartNumber == x?.CustomerPartNumber && x?.CustomerRfqNo != RfqProject.RfqNumber));
                    if (found != null)
                    {
                        preExistingNprRequests.Add(found);
                    }
                    else
                    {
                        toNewNprRequests.Add(r);
                    }
                }

                confirm = await DialogService.ShowMessageBox(
                    "Commit NPR Requests",
                    $"Are you sure you want to create {toNewNprRequests.Count} NPR requests and take over {preExistingNprRequests.Count} older NPR requests? This will UPDATE CHANGES.",
                    yesText: $"Commit {toNewNprRequests.Count + preExistingNprRequests.Count} NPR requests",
                    cancelText: "Cancel"
                );

                if (confirm != true) return;

                // act if ok
                if(0 < toNewNprRequests.Count)
                {
                    // new ones
                    foreach (RfqDrawingPartNumberUxModel? part in toNewNprRequests)
                    {
                        if (part != null)
                        {
                            //check if the part does not already has a npr request created in another project
                            RfqNprRequestUxModel? nprRequest = GetRfqNprRequestByCustomerNumber(part);
                            if (nprRequest == null)
                            {
                                nprRequest = part.ToNprRequest(RfqProject);
                                nprRequest.CustomerRfqNo= RfqProject.RfqNumber;
                                nprRequest.Created = now;
                                nprRequest.Updated = now;
                                nprRequest.UxStatus = UxObjectStatus.Created;
                                nprRequests.Add(nprRequest);
                            }
                        }
                    }

                    // persist
                    RfqProject.NprRequests.Clear();
                    List<RfqNprRequestUxModel> response = await RfqUxClientService.CreateNprRequestsAsync(nprRequests);
                    RfqProject.NprRequests.AddRange(response);

                    Snackbar.Add($"Successfully created new NPR request set for {toNewNprRequests.Count} part(s)", Severity.Success);
                    StateHasChanged();
                }

                if (0 < preExistingNprRequests.Count)
                {
                    // update pre-existing ones
                    foreach (var r in preExistingNprRequests)
                    {
                        r.CustomerRfqNo = RfqProject.RfqNumber;
                        r.Updated = DateTime.UtcNow;
                        r.UxStatus = UxObjectStatus.Updated;
                    }

                    // persist
                    List<RfqNprRequestUxModel> response = await RfqUxClientService.UpdateNprRequestsAsync(preExistingNprRequests);
                    RfqProject.NprRequests.AddRange(response);

                    Snackbar.Add($"Successfully updated pre-existing {preExistingNprRequests.Count} NPR request(s)", Severity.Success);
                    StateHasChanged();
                }
            }
            else
            {
                // no npr requests yet
                foreach (RfqDrawingPartNumberUxModel? part in InProgressParts.ToList())
                {
                    if (part != null)
                    {
                        //check if the part does not already has a npr request created in another project
                        RfqNprRequestUxModel? nprRequest = GetRfqNprRequestByCustomerNumber(part);
                        if (nprRequest == null)
                        {
                            nprRequest = part.ToNprRequest(RfqProject);
                            nprRequest.CustomerRfqNo = RfqProject.RfqNumber;
                            nprRequest.Created = now;
                            nprRequest.Updated = now;
                            nprRequest.UxStatus = UxObjectStatus.Created;
                            nprRequests.Add(nprRequest);
                        }
                    }
                }

                List<RfqNprRequestUxModel> response = await RfqUxClientService.CreateNprRequestsAsync(nprRequests);
                RfqProject.NprRequests = response;

                Snackbar.Add($"Successfully created NPR request set for {InProgressParts.Count} part(s)", Severity.Success);
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Logger.GenericLogError("EditRfq.NprAllInProgressPartsAsync - Error creating NPR for parts", ex);
            Snackbar.Add($"Error creating NPR requests: {ex.Message}", Severity.Error);
        }
    }
    #endregion

    // Watch for project selection changes
    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);

        if (!firstRender)
        {
            // Update RfqProject.ProjectId when selectedProject changes
            if (selectedProject != _previousSelectedProject)
            {
                if (selectedProject != null)
                {
                    RfqProject!.ProjectId = selectedProject.ProjectId!;
                    Logger.GenericLogInformation($"EditRfq.OnAfterRender - Project changed to {selectedProject.Id} - {selectedProject.ProjectName}");
                }
                else
                {
                    RfqProject!.ProjectId = "";
                    Logger.GenericLogInformation($"EditRfq.OnAfterRender - Project cleared");
                }

                _previousSelectedProject = selectedProject;
            }
        }
    }

    #region Customer
    async Task OnCustomerValueChanged(string value)
    {
        RfqProject!.CustomerBusinessUnitId = value;

        var customer = RfqUxClientService.Customers.FirstOrDefault(c => c?.Id == value);
        if (customer == null)
        {
            Logger.GenericLogInformation($"EditRfq.OnCustomerValueChanged - Customer with ID '{value}' not found");
            return;
        }

        Logger.GenericLogInformation($"EditRfq.OnCustomerValueChanged - Customer changed to {customer.Id} - {customer.CustomerBusinessGroupName}");

        // Clear selected project when customer changes (like CreateRfq)
        selectedProject = null;
        _previousSelectedProject = null;
        RfqProject.ProjectId = "";

        // Reset the autocomplete component
        if (_projectAutocomplete != null)
        {
            await _projectAutocomplete.ClearAsync();
        }

        try
        {
            await GetProjectAssociationsByCustomerName(customer.CustomerBusinessGroupName);
        }
        catch (Exception ex)
        {
            Logger.GenericLogError($"EditRfq.OnCustomerValueChanged - Failed to load customer projects for customer '{customer.CustomerBusinessGroupName}'", ex);
        }

        StateHasChanged();
    }

    async Task GetProjectAssociationsByCustomerName(string? customerBusinessGroupName)
    {
        if (!string.IsNullOrWhiteSpace(RfqProject!.CustomerBusinessUnitId))
        {
            CustomerUxModel? customer = RfqUxClientService.Customers.FirstOrDefault(c => c?.CustomerBusinessGroupName == customerBusinessGroupName);

            if (customer != null && Guid.TryParse(customer.Id, out Guid customerId))
            {
                await RfqUxClientService.GetProjectAssociationsByCustomerIdAsync(customerId.ToString());
                StateHasChanged();
            }
            else
            {
                Logger.GenericLogInformation($"EditRfq.GetProjectAssociationsByCustomerName - Customer not found or invalid ID for '{customerBusinessGroupName}'");
            }
        }
    }
    #endregion

    #region Project Autocomplete
    // Search function for MudAutocomplete (same as CreateRfq)
    private async Task<IEnumerable<RqfCustomerProjectAssociationUxModel>> SearchProjects(string searchText, CancellationToken cancellationToken)
    {
        await Task.Delay(0, cancellationToken);

        // If no search text, return all projects (sorted)
        if (string.IsNullOrWhiteSpace(searchText))
        {
            return RfqUxClientService.CustomerProjectAssociations
                .OrderBy(p => p.ProjectName)
                .ThenBy(p => p.CustomerName);
        }

        // Search across project name and customer name
        return RfqUxClientService.CustomerProjectAssociations
            .Where(p =>
                (p.ProjectName?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (p.CustomerName?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false))
            .OrderBy(p => p.ProjectName?.StartsWith(searchText, StringComparison.OrdinalIgnoreCase) == true ? 0 : 1)
            .ThenBy(p => p.ProjectName)
            .ThenBy(p => p.CustomerName);
    }
