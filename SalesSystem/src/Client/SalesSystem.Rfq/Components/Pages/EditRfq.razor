    private async Task HandlePartNumberDeleted(RfqDrawingPartNumberUx deletedItem)
    {
        try
        {
            // Remove from the appropriate collection
            if (deletedItem.IsCompleted)
            {
                CompletedParts.Remove(deletedItem);
                Logger.GenericLogInformation($"EditRfq.HandlePartNumberDeleted - Removed matched part: {deletedItem.CustomerPartNumber}");
            }
            else
            {
                InProgressParts.Remove(deletedItem);
                Logger.GenericLogInformation($"EditRfq.HandlePartNumberDeleted - Removed unmatched part: {deletedItem.CustomerPartNumber}");
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.GenericLogError($"EditRfq.HandlePartNumberDeleted - Error handling deletion of part: {deletedItem.CustomerPartNumber}", ex);
        }

        await Task.CompletedTask;
    }

    private async Task HandlePartNumberUpdated(RfqDrawingPartNumberUx updatedItem)
    {
        try
        {
            // Find the item in both lists
            var matchedItem = CompletedParts.FirstOrDefault(p => p?.RowId == updatedItem.RowId);
            var unmatchedItem = InProgressParts.FirstOrDefault(p => p?.RowId == updatedItem.RowId);

            // Determine current location
            bool isInCompletedList = matchedItem != null;
            bool isInInProgressList = unmatchedItem != null;

            // Check if the IsCompleted status changed and item needs to move between lists
            if (updatedItem.IsCompleted && isInInProgressList)
            {
                // Move from unmatched to matched
                InProgressParts.Remove(unmatchedItem);
                CompletedParts.Add(updatedItem);
                Logger.GenericLogInformation($"EditRfq.HandlePartNumberUpdated - Moved part to matched: {updatedItem.CustomerPartNumber}");
            }
            else if (!updatedItem.IsCompleted && isInCompletedList)
            {
                // Move from matched to unmatched
                CompletedParts.Remove(matchedItem);
                InProgressParts.Add(updatedItem);
                Logger.GenericLogInformation($"EditRfq.HandlePartNumberUpdated - Moved part to unmatched: {updatedItem.CustomerPartNumber}");
            }
            else if (isInCompletedList)
            {
                // Update in place in matched list
                var index = CompletedParts.IndexOf(matchedItem);
                if (index >= 0)
                {
                    CompletedParts[index] = updatedItem;
                }
                Logger.GenericLogInformation($"EditRfq.HandlePartNumberUpdated - Updated matched part: {updatedItem.CustomerPartNumber}");
            }
            else if (isInInProgressList)
            {
                // Update in place in unmatched list
                var index = InProgressParts.IndexOf(unmatchedItem);
                if (index >= 0)
                {
                    InProgressParts[index] = updatedItem;
                }
                Logger.GenericLogInformation($"EditRfq.HandlePartNumberUpdated - Updated unmatched part: {updatedItem.CustomerPartNumber}");
            }

            // Force UI refresh
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.GenericLogError($"EditRfq.HandlePartNumberUpdated - Error handling update of part: {updatedItem.CustomerPartNumber}", ex);
        }

        await Task.CompletedTask;
    }
}
