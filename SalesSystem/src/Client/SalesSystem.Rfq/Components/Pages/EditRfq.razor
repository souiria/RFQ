@page "/editRfq/{RfqProjectId:long}"
@* @page "/editRfq/{UserId:guid}/{RfqProjectId:long}" *@

@using SalesSystem.Rfq.Components.Pages.Components
@using SalesSystem.Rfq.ViewModels
@inherits MvvmComponentBase<EditRfqViewModel>

@rendermode InteractiveServer
<style>
    .edit-rfq-panel {
        height: calc(100vh - 224px);
        display: flex;
        flex-direction: column;
        overflow: auto;
    }
    .compact-input {
        padding-top: 0px;
        padding-bottom: 0px;
    }
</style>
@if (ViewModel.IsLoading || ViewModel.RfqProject == null)
{
    <MudContainer Class="d-flex justify-center align-center" Style="height: calc(100vh - 128px);">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large">
            <ChildContent>
                <MudText Typo="Typo.subtitle2">
                    Loading...
                </MudText>
            </ChildContent>
        </MudProgressCircular>
    </MudContainer>
}
else
{
    <MudText Typo="Typo.h5" Class="mb-auto" Align="Align.Center">Edit @ViewModel.RfqProject.RfqNumber (@ViewModel.RfqProject.CustomerCode / @ViewModel.RfqProject.ProjectName - @ViewModel.RfqProject.CarModelName)</MudText>
    <MudGrid Class="position-fixed">
        <MudItem xs="12">
            <MudStack Row="true">
                @* Region label *@
                <MudPaper Style="width: 48px; background-color: var(--mud-palette-primary); position: relative; overflow: visible;">
                    <MudText Style="transform: rotate(-90deg); transform-origin: left bottom; white-space: nowrap; position: absolute; bottom: 10px; left: 36px; font-weight: 500; color: white;"
                             Typo="Typo.h6">
                        Rfq
                    </MudText>
                </MudPaper>

                <MudSelect T="int?"
                           Value="@(ViewModel.RfqProject.RfqReasonId == 0 ? null : (int?)ViewModel.RfqProject.RfqReasonId)"
                           ValueChanged="ViewModel.OnReasonValueChanged"
                           Label="Reason"
                           Placeholder="Please Select"
                           AdornmentIcon="@Icons.Material.Filled.Checklist"
                           AdornmentColor="Color.Primary">
                    @foreach (var reason in ViewModel.Reasons)
                    {
                        <MudSelectItem T="int?" Value="@((int?)reason.RowId)">@reason.RfqReasonTitle</MudSelectItem>
                    }
                </MudSelect>
                <MudNumericField @bind-Value="@ViewModel.RfqProject.VehicleVolume"
                                 T="int"
                                 Label="Vehicle Volume"
                                 Variant="Variant.Text"
                                 Min="0" 
                                 HideSpinButtons="true"
                                 Class="compact-input"/>
                <MudDatePicker Label="Deadline"
                               @bind-Date="ViewModel.RfqProject.RfqResponseDeadline"
                               DateFormat="dd.MM.yyyy" />

                @* Controls – scrollable inner wrapper *@

                        <MudStack Row
                                  AlignItems="AlignItems.Center"
                                  Spacing="2">
                            @* Column 1: Search & Status *@
                                <MudTooltip Text="Search All InProgress Parts">
                                    <MudButton Color="Color.Info"
                                               OnClick="@ViewModel.SearchAllPartNumbersAsync"
                                               Variant="Variant.Filled"
                                               Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.TravelExplore"
                                               FullWidth="true"
                                               Disabled="@(ViewModel.InProgressParts.Count == 0 || ViewModel.IsSearchingAll)"
                                               Class="mud-text-nowrap">
                                        Search
                                    </MudButton>
                                </MudTooltip>
                                <MudTooltip Text="RFQ Project Stats and Statistics">
                                    <MudButton Color="Color.Dark"
                                               OnClick="@ViewModel.ShowDatasetStatusAsync"
                                               Variant="Variant.Filled"
                                               Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.Assessment"
                                               FullWidth="true"
                                               Disabled="@(ViewModel.TotalParts == 0)"
                                               Class="mud-text-nowrap">
                                        Status
                                    </MudButton>
                                </MudTooltip>

                            @* Column 2: NPR handling *@
                                <MudTooltip Text="Create NPR Requests for ALL InProgress Parts">
                                    <MudButton Color="Color.Info"
                                               OnClick="@ViewModel.NprAllInProgressPartsAsync"
                                               Variant="Variant.Filled"
                                               Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.AddTask"
                                               FullWidth="true"
                                               Disabled="@(ViewModel.IsCreateNprRequestsPermitted)"
                                               Class="mud-text-nowrap">
                                        Add&nbsp;NPRs
                                    </MudButton>
                                </MudTooltip>
                                <MudTooltip Text="Submit existing NPR Requests to the NPR API">
                                    <MudButton Color="Color.Success"
                                               OnClick="@ViewModel.SubmitNprRequestsAsync"
                                               Variant="Variant.Filled"
                                               Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.CloudUpload"
                                               FullWidth="true"
                                               Disabled="@(ViewModel.IsSubmittingNprs || ViewModel.RfqProject?.NprRequests == null || ViewModel.RfqProject.NprRequests.Count == 0)"
                                               Class="mud-text-nowrap">
                                        Submit&nbsp;NPRs
                                    </MudButton>
                                </MudTooltip>
                                

                            @* Column 3: Reload, Update *@
                                <MudTooltip Text="Reload from DB and Drop Changes">
                                    <MudButton Color="Color.Warning"
                                               OnClick="@ViewModel.ReloadDataAsync"
                                               Variant="Variant.Filled"
                                               Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.Repeat"
                                               FullWidth="true"
                                               Class="mud-text-nowrap">
                                        Reload
                                    </MudButton>
                                </MudTooltip>
                                <MudTooltip Text="Save to DB">
                                    <MudButton Color="Color.Primary"
                                               OnClick="@ViewModel.SaveDataAsync"
                                               Variant="Variant.Filled"
                                               Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.Save"
                                               FullWidth="true"
                                               Class="mud-text-nowrap">
                                        Update
                                    </MudButton>
                                </MudTooltip>
                        </MudStack>


            </MudStack>
        </MudItem>

        <MudItem xs="12" Class="pt-2">
                <MudTabs Elevation="2"
                         Rounded="true"
                         ApplyEffectsToContainer="true"
                         MinimumTabWidth="16vw"
                         Style="height: 100%; overflow: hidden;"
                         @bind-ActivePanelIndex="ViewModel.ActiveTabIndex">
                    <MudTabPanel Text="BOM Files"
                                 Icon="@Icons.Material.Filled.Api"
                                 BadgeData='"BOM"'
                                 BadgeColor="Color.Success">
                        <div class="edit-rfq-panel">
                            @if(ViewModel.Composites.Count > 0)
                            {
                                <Composites @ref="_CompositesRef"
                                            DsiComposites="@ViewModel.Composites"
                                            PreselectedIds="@ViewModel.PreselectedDerivativeIds"
                                            OnComponentsSelected="@ViewModel.HandleComponentsSelectedAsync" />
                            }
                        </div>
                    </MudTabPanel>
                    <MudTabPanel Text="Parts Lists" Icon="@Icons.Material.Filled.Api" BadgeData='"PROJ"' BadgeColor="Color.Info">
                        <RfqPartsListPanel CompletedParts="@ViewModel.CompletedParts"
                                           InProgressParts="@ViewModel.InProgressParts"
                                           OnPartsChanged="StateHasChanged" />
                    </MudTabPanel>
                    <MudTabPanel Text="@($"NPRs")"
                                 Disabled="@(ViewModel.RfqProject.NprRequests == null || ViewModel.RfqProject.NprRequests.Count == 0)"
                                 Icon="@Icons.Material.Filled.RequestPage"
                                 BadgeData="@(ViewModel.RfqProject.NprRequests?.Count ?? 0)"
                                 BadgeColor="Color.Primary">
                        <div class="edit-rfq-panel">
                            @if (ViewModel.RfqProject.NprRequests != null && ViewModel.RfqProject.NprRequests.Count > 0)
                            {
                                <NprRequestsEditor @ref="_ComponentNprEditor" RfqProject="@ViewModel.RfqProject" GlobalValue="@ViewModel.GlobalValue"/>
                            }
                            else
                            {
                                <MudAlert Severity="Severity.Info" Class="ma-4">
                                    No NPR requests available. Use the "Add NPRs" button to create NPR requests for in-progress parts.
                                </MudAlert>
                            }
                        </div>
                    </MudTabPanel>
                </MudTabs>
        </MudItem>
    </MudGrid>
}

