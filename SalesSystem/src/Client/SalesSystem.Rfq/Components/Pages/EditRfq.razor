    private async Task ClearPartNumbersAsync()
    {
        await Task.Delay(1);

        // Show confirmation dialog
        bool? confirm = await DialogService.ShowMessageBox(
            "Confirm Clear all P/Ns",
            $"Are you sure you want to clear ALL {TotalParts} part number(s)?",
            yesText: "Clear All",
            cancelText: "Cancel"
        );

        if (confirm == true)
        {
            Logger.GenericLogInformation("EditRfq.DeletePNsAsync - User cancelled clear P/Ns operation");
            CompletedParts.Clear();
            InProgressParts.Clear();
            StateHasChanged();

            return;
        }
    }
    private async Task DeleteRfqAsync()
    {
        // Show confirmation dialog
        bool? confirm = await DialogService.ShowMessageBox(
            $"Confirm deleting RFQ {RfqProject!.RfqNumber}",
            $"Are you sure you want to also delete ALL {TotalParts} part number(s) linked to this RFQ? This action cannot be undone.",
            yesText: "Delete All",
            cancelText: "Cancel"
        );

        if (confirm != true)
        {
            Logger.GenericLogInformation("EditRfq.DeleteRfqAsync - User cancelled delete operation");
            return;
        }

        CancellationTokenSource cancellationTokenSource = new CancellationTokenSource();

        try
        {
            var result = await RfqUxClientService.DeleteRfqProjectByRowIdAsync(RfqProject!.RowId);
            if (result.SaveSuccess)
            {
                Snackbar.Add($"Successfully deleted RFQ {RfqProject.RfqNumber} and all linked part numbers", Severity.Success);
                Logger.GenericLogInformation($"EditRfq.DeleteRfqAsync - Successfully deleted RFQ {RfqProject.RfqNumber} and all linked part numbers");
            }
            else
            {
                Snackbar.Add($"Error deleting RFQ {RfqProject.RfqNumber}", Severity.Error);
                Logger.GenericLogInformation($"EditRfq.DeleteRfqAsync - Error deleting RFQ {RfqProject.RfqNumber}");
            }

            NavigationManager.NavigateTo("/");

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.GenericLogError($"EditRfq.DeletePNsAsync - Unexpected error during data deletion {ex.Message}", ex);
            Snackbar.Add($"Error deleting part numbers: {ex.Message}", Severity.Error);
        }
        finally
        {
            cancellationTokenSource?.Dispose();
        }
    }

    private async Task SaveDataAsync()
    {

        List<RfqDrawingPartNumberUx?> allParts = new();
        allParts.AddRange(CompletedParts);
        allParts.AddRange(InProgressParts);

        await Task.Delay(0);
        try
        {
            var partsUpdateResult = await RfqUxClientService.UpdateRfqDrawingPartNumbersAsync(allParts);
            var rfqUpdateResult = await RfqUxClientService.UpdateRfqProjectAsync(RfqProject!);
            if(partsUpdateResult.Success && rfqUpdateResult.Success)
            {
                Snackbar.Add("Data refreshed successfully", Severity.Success);
                Logger.GenericLogInformation("EditRfq.SaveDataAsync - Data refreshed successfully");
                // reload Rfq and Part numbers
                await LoadRfqAndPartNumbersAsync();
            }
            else
            {
                Snackbar.Add("Error refreshing data", Severity.Error);
                Logger.GenericLogInformation("EditRfq.SaveDataAsync - Error refreshing data");
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.GenericLogError($"EditRfq.RefreshDataAsync - Unexpected error during data refresh {ex.Message}", ex);
        }
    }
