@page "/editRfq/{UserId:guid}/{RfqProjectId:long}"

@using Google.Protobuf.WellKnownTypes
@using SalesSystem.Rfq.Components.Pages.Dialogs
@using SalesSystem.Rfq.Extensions
@using SalesSystem.Rfq.Models
@using SalesSystem.Rfq.Components.Pages.Components

@inject ISnackbar Snackbar
@inject RfqUxClientService RfqUxClientService
@inject ILogger<EditRfq> Logger
@inject IDialogService DialogService
@inject NavigationManager NavigationManager

@rendermode InteractiveServer

@if (IsLoading || RfqProject == null)
{
    <MudContainer Class="d-flex justify-center align-center" Style="height: calc(100vh - 128px);">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large">
            <ChildContent>
                <MudText Typo="Typo.subtitle2">
                    Loading...
                </MudText>
            </ChildContent>
        </MudProgressCircular>
    </MudContainer>
}
else
{
    <MudText Typo="Typo.h5" Class="mb-auto" Align="Align.Center">Edit RFI/RFQ</MudText>
    <MudGrid Class="position-fixed">
        <MudItem xs="12">
            <MudPaper Class="d-flex flex-row" Style="height:150px;">
                @* Region label *@
                <MudPaper Style="width: 48px; background-color: var(--mud-palette-primary); position: relative; overflow: visible;">
                    <MudText Style="transform: rotate(-90deg); transform-origin: left bottom; white-space: nowrap; position: absolute; bottom: 20px; left: 36px; font-weight: 500; color: white;" 
                             Typo="Typo.h6">
                        Edit RFQ/RFI
                    </MudText>
                </MudPaper>
                <MudPaper Class="pa-4">
                    <MudStack>
                        <MudSelect T="string"
                                   Value="@RfqProject.CustomerBusinessUnitId"
                                   For="@(() => RfqProject.CustomerBusinessUnitId)"
                                   ValueChanged="OnCustomerValueChanged"
                                   Label="Customer"
                                   Placeholder="Please Select"
                                   AdornmentIcon="@Icons.Material.Filled.People"
                                   AdornmentColor="Color.Primary">
                            @foreach (var customer in RfqUxClientService.Customers)
                            {
                                <MudSelectItem Value="@customer?.Id">@customer?.CustomerBusinessGroupName</MudSelectItem>
                            }
                        </MudSelect>
                        <MudSelect T="int?"
                                   Value="@(RfqProject.RfqReasonId == 0 ? null : (int?)RfqProject.RfqReasonId)"
                                   ValueChanged="OnReasonValueChanged"
                                   Label="Reason"
                                   Placeholder="Please Select"
                                   AdornmentIcon="@Icons.Material.Filled.Checklist"
                                   AdornmentColor="Color.Primary">
                            @foreach (var reason in RfqUxClientService.Reasons)
                            {
                                <MudSelectItem Value="@((int?)reason.RowId)">@reason.RfqReasonTitle</MudSelectItem>
                            }
                        </MudSelect>

                    </MudStack>
                </MudPaper>

                <MudPaper Class="pa-4">
                    <MudStack>
                        <MudSelect T="string"
                                   Value="@RfqProject.ProjectId"
                                   For="@(() => RfqProject.ProjectId)"
                                   ValueChanged="OnCustomerProjectValueChanged"
                                   Label="Project"
                                   Placeholder="Please Select"
                                   AdornmentIcon="@Icons.Material.Filled.DesignServices"
                                   AdornmentColor="Color.Primary">
                            @foreach (var association in RfqUxClientService.CustomerProjectAssociations)
                            {
                                <MudSelectItem Value="@association.ProjectId">@association.ProjectName - @association.CustomerName</MudSelectItem>
                            }
                        </MudSelect>
                        <MudNumericField @bind-Value="@RfqProject.VehicleVolume"
                                         Label="Vehicle Volume"
                                         Variant="Variant.Text"
                                         Min="0" />
                    </MudStack>
                </MudPaper>

                <MudPaper Class="pa-4">
                    <MudStack>
@*                         <MudSelect T="string"
                                   Value="quotationValue"
                                   For="@(() => quotationValue)"
                                   ValueChanged="OnQuotationValueChanged"
                                   Label="Quotation Number"
                                   Placeholder="Please Select"
                                   Disabled="uploadedSuccessfully"
                                   AdornmentIcon="@Icons.Material.Filled.RequestQuote"
                                   AdornmentColor="Color.Primary">
                            @foreach (string quotationNumber in RfqUxClientService.QuotationNumbers)
                            {
                                <MudSelectItem Value="@quotationNumber">@quotationNumber</MudSelectItem>
                            }
                        </MudSelect> *@
                        <MudDatePicker Label="Date Format"
                                       @bind-Date="RfqProject.RfqResponseDeadline"
                                       DateFormat="dd.MM.yyyy" />
                    </MudStack>
                </MudPaper>

                <MudPaper Class="d-flex flex-grow-1 pa-4 w-100">
                    <FileManager @ref="componentFileManager"
                                 FileObjects="FileObjects"
                                 OnFilesChanged="OnFilesChanged" />
                </MudPaper>

                @* Controls  *@
                <MudPaper Class="d-flex align-end pa-4">
                    <MudStack Row>
                        <MudItem>
                            <MudStack>
                                <MudButton Color="Color.Info"
                                           OnClick="@SearchAllUnmatchedPartsAsync"
                                           Variant="Variant.Filled"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.TravelExplore"
                                           FullWidth="false"
                                           Disabled="@(UnmatchedParts.Count == 0 || _isSearchingAll)">
                                    Search All
                                </MudButton>
                                <MudButton Color="Color.Info"
                                           OnClick="@NprAllUnmatchedPartsAsync"
                                           Variant="Variant.Filled"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.TravelExplore"
                                           FullWidth="false"
                                           Disabled="@(UnmatchedParts.Count == 0 || _isSearchingAll)">
                                    Npr All
                                </MudButton>
                            </MudStack>
                        </MudItem>
                        <MudItem>
                            <MudStack>
                                <MudButton Color="Color.Secondary"
                                           OnClick="@FlipAllMatchedPartsAsync"
                                           Variant="Variant.Filled"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.SwapVert"
                                           FullWidth="false"
                                           Disabled="@(MatchedParts.Count == 0)">
                                    Flip All
                                </MudButton>
                                <MudButton Color="Color.Dark"
                                           OnClick="@ShowDatasetStatusAsync"
                                           Variant="Variant.Filled"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Assessment"
                                           FullWidth="false"
                                           Disabled="@(TotalParts == 0)">
                                    Status
                                </MudButton>
                            </MudStack>
                        </MudItem>
                        <MudItem>
                            <MudStack>
                                <MudButton Color="Color.Warning"
                                           OnClick="@ReloadDataAsync"
                                           Variant="Variant.Filled"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Repeat"
                                           FullWidth="false">
                                    Reload
                                </MudButton>
                                <MudButton Color="Color.Primary"
                                           OnClick="@RefreshDataAsync"
                                           Variant="Variant.Filled"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Refresh"
                                           FullWidth="false">
                                    Refresh
                                </MudButton>
                                <MudButton Color="Color.Primary"
                                           OnClick="@UploadFilesAsync"
                                           Variant="Variant.Filled"
                                           Disabled="FileObjects.Count==0"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Update"
                                           FullWidth="false">
                                    Upload
                                </MudButton>
                            </MudStack>
                        </MudItem>
                    </MudStack>

                </MudPaper>

            </MudPaper>
        </MudItem>
        <MudItem xs="12" Class="pt-2">
            <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-3">
                <MudTabPanel Text="Parts Lists">
                    @* Part Number Sections *@
                    <div class="d-flex flex-column" style="height: calc(100vh - 364px); overflow: hidden;">
                        @* Unmatched Parts Section *@
                        <PartNumberSection PartNumbers="@UnmatchedParts"
                                           Label="In progress"
                                           BackgroundColor="var(--mud-palette-warning)"
                                           InitiallyExpanded="true"
                                           OnPartNumberDeleted="@HandlePartNumberDeleted"
                                           OnPartNumberUpdated="@HandlePartNumberUpdated" />
                        @* Separator *@
                        <MudDivider Style="margin: 4px 0;" />
                        @* Matched Parts Section *@
                        <PartNumberSection PartNumbers="@MatchedParts"
                                           Label="Completed"
                                           BackgroundColor="var(--mud-palette-success)"
                                           InitiallyExpanded="false"
                                           OnPartNumberDeleted="@HandlePartNumberDeleted"
                                           OnPartNumberUpdated="@HandlePartNumberUpdated" />
                    </div>
                </MudTabPanel>
                <MudTabPanel Text="BOM Files">
                    <div class="d-flex flex-column" sDrawingtyle="height: calc(100vh - 364px)Drawing; overflow: hidden;">
                        @* File Cards Section *@
                        <FileCards @rDrawingef="componentFileCards"
                                   FileObjects="FileObjects"
                                   OnRemoveFile="HandleFileRemoval" />
                    </div>
                </MudTabPanel>
            </MudTabs>
        </MudItem>
    </MudGrid>
}

@code {

    // Reference to the FileManager component
    FileManager? componentFileManager;
    // FileCards? componentFileCards;
    List<FileObjectUx> FileObjects { get; set; } = new List<FileObjectUx>();

    // Search All state tracking
    private bool _isSearchingAll = false;
    private CancellationTokenSource? _searchCancellationTokenSource;

    // Helper property for total parts count
    private int TotalParts => MatchedParts.Count + UnmatchedParts.Count;

    // Form related
    bool IsLoading { get; set; } = true;
    RfqProjectUx? RfqProject { get; set; }

    [Parameter] public Guid? UserId { get; set; }
    [Parameter] public long RfqProjectId { get; set; }

    // Part numbers data - changed to List for mutability
    List<RfqDrawingPartNumberUx?> MatchedParts = new List<RfqDrawingPartNumberUx?>();
    List<RfqDrawingPartNumberUx?> UnmatchedParts = new List<RfqDrawingPartNumberUx?>();

    protected override async Task OnInitializedAsync()
    {
        if (UserId == null || UserId == Guid.Empty)
        {
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add("UserId is missing in the URL", Severity.Error);
            Logger.GenericLogInformation("EditRfq.OnInitializedAsync - UserId is missing in the URL");
            IsLoading = false;
            NavigationManager.NavigateTo("/");
        }

        try
        {
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Logger.GenericLogError("EditRfq.OnInitializedAsync - Error loading RFQ project", ex);
            Snackbar.Add("Error loading RFQ project", Severity.Error);
            NavigationManager.NavigateTo("/");
        }
    }

    async Task LoadDataAsync()
    {
        if (RfqUxClientService.Customers.Count == 0)
        {
            Func<Guid, Task<int>> guidAsyncService = RfqUxClientService.GetCustomersByUserIdAsync;
            (long timing, int count) = await guidAsyncService.TimeAsyncGuidIntService((Guid)UserId!);
            Logger.GenericLogInformation($"EditRfq.OnInitializedAsync - Loaded {count} customers for UserId {UserId} in {timing}ms");
        }

        if (RfqUxClientService.Reasons.Count == 0)
        {
            Func<Task<int>> guidAsyncService = RfqUxClientService.GetRfqReasonsAsync;
            (long timing, int count) = await guidAsyncService.TimeAsyncVoidIntService();
            Logger.GenericLogInformation($"EditRfq.OnInitializedAsync - Loaded {count} reasons in {timing}ms");
        }

        // get the project
        var rfqProject = await RfqUxClientService.GetRfqProjectByIdAsync(RfqProjectId);
        if (rfqProject == null)
        {
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add($"RFQ Project with Id {RfqProjectId} not found", Severity.Error);
            Logger.GenericLogInformation($"EditRfq.OnInitializedAsync - RFQ Project with Id {RfqProjectId} not found");
            NavigationManager.NavigateTo("/");
            return;
        }
        else
        {
            Logger.GenericLogInformation($"EditRfq.OnInitializedAsync - Retrieved RFQ Project with Id {rfqProject.RowId} - {rfqProject.RfqNumber} - Customer {rfqProject.CustomerBusinessUnitGuid} / {rfqProject.CustomerBusinessGroupCode} - Project {rfqProject.ProjectGuid} / {rfqProject.ProjectName}");
        }

        if (RfqUxClientService.CustomerProjectAssociations.Count == 0)
        {
            Func<string, Task<int>> stringAsyncService = RfqUxClientService.GetProjectAssociationsByCustomerIdAsync;
            (long timing, int count) = await stringAsyncService.TimeAsyncStringIntService(rfqProject.CustomerBusinessUnitGuid);
            Logger.GenericLogInformation($"EditRfq.OnInitializedAsync - Loaded {count} customerProjectAssociations for CustomerBusinessUnitGuid {rfqProject.CustomerBusinessUnitGuid} in {timing}ms");
            // foreach (var item in RfqUxClientService.CustomerProjectAssociations)
            // {
            //     Logger.GenericLogInformation($"{item.Id}, {item.ProjectId}, {item.ProjectName}, {item.CustomerId}, {item.CustomerName}");
            // }
        }

        RfqProject = rfqProject.ToUx();
        if (RfqProject == null)
        {
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add($"Error mapping RFQ Project with Id {RfqProjectId}", Severity.Error);
            Logger.GenericLogInformation($"EditRfq.OnInitializedAsync - Error mapping RFQ Project with Id {RfqProjectId}");
            NavigationManager.NavigateTo("/");
        }
        else
        {
            IsLoading = false;
            Logger.GenericLogInformation($"EditRfq.OnInitializedAsync - Loaded RFQ Project with Id {RfqProject.RowId} - {RfqProject.RfqNumber} {RfqProject.ProjectId}");
        }

        // get the part numbers
        int partNumbersCount = await RfqUxClientService.GetRfqDrawingPartNumbersByRfqIdAsync(RfqProjectId);
        if (partNumbersCount > 0)
        {
            MatchedParts = RfqUxClientService.RfqDrawingPartNumbers.Where(x => x?.IsMatched == true).ToList();
            UnmatchedParts = RfqUxClientService.RfqDrawingPartNumbers.Where(x => !x?.IsMatched == true).ToList();
        }
    }


    #region Customer
    async Task OnCustomerValueChanged(string value)
    {
        RfqProject!.CustomerBusinessUnitId = value;

        var customer = RfqUxClientService.Customers.FirstOrDefault(c => c?.CustomerBusinessGroupName == value);
        if (customer == null)
        {
            Logger.GenericLogInformation($"EditRfq.OnCustomerValueChanged - Customer with name '{value}' not found");
            return;
        }
        await Task.Delay(0);
        Logger.GenericLogInformation($"EditRfq.OnCustomerValueChanged - Customer changed to {customer?.Id} - {customer?.CustomerBusinessGroupName}");

        try
        {
            await GetProjectAssociationsByCustomerName(customer!.CustomerBusinessGroupName);
        }
        catch (Exception ex)
        {
            Logger.GenericLogError($"EditRfq.OnCustomerValueChanged - Failed to load customer projects for customer '{RfqProject!.CustomerBusinessUnitId}'", ex);
        }
        StateHasChanged();
    }

    async Task GetProjectAssociationsByCustomerName(string? customerBusinessGroupName)
    {
        if (!string.IsNullOrWhiteSpace(RfqProject!.CustomerBusinessUnitId))
        {
            // CustomerUx? customer = RfqUxClientService.Customers.FirstOrDefault(c => c.Id == value);

            // if (customer != null)
            // {
            //     await RfqUxClientService.GetProjectAssociationsByCustomerIdAsync(customer.Id);
            //     StateHasChanged();
            // }
            CustomerUx? customer = RfqUxClientService.Customers.FirstOrDefault(c => c?.CustomerBusinessGroupName == customerBusinessGroupName);

            if (customer != null && Guid.TryParse(customer.Id, out Guid customerId))
            {
                await RfqUxClientService.GetProjectAssociationsByCustomerIdAsync(customerId.ToString());
                StateHasChanged();
            }
            else
            {
                Logger.GenericLogInformation($"CreateRfq.GetProjectAssociationsByCustomerName - Customer not found or invalid ID for '{customerBusinessGroupName}'");
            }
        }
    }

    private void OnCustomerProjectValueChanged(string value)
    {
        RfqProject!.ProjectId = value;

        var project = RfqUxClientService.CustomerProjectAssociations.FirstOrDefault(p => p.Id == value);
        Logger.GenericLogInformation($"Project changed to {project?.Id} - {project?.ProjectName}");

        StateHasChanged();
    }
    #endregion

    #region Reason
    async Task OnReasonValueChanged(int? value)
    {
        RfqProject!.RfqReasonId = value ?? 0;
        await Task.Delay(0);

        var reason = RfqUxClientService.Reasons.FirstOrDefault(r => r.RowId == (value ?? 0));
        Logger.GenericLogInformation($"EditRfq.OnReasonValueChanged - Reason changed to {reason?.RowId} - {reason?.RfqReasonTitle}");

        StateHasChanged();
    }
    #endregion

    #region Part Number
    private async Task FlipAllMatchedPartsAsync()
    {
        if (MatchedParts.Count == 0)
        {
            Snackbar.Add("No matched parts to flip", Severity.Info);
            Logger.GenericLogInformation("EditRfq.FlipAllMatchedPartsAsync - No matched parts available");
            return;
        }

        try
        {
            // Show confirmation dialog
            bool? confirm = await DialogService.ShowMessageBox(
                "Confirm Flip All",
                $"Are you sure you want to flip all {MatchedParts.Count} matched part(s) to unmatched? This will set IsExactMatch and IsMatched to false for all matched parts.",
                yesText: "Flip All",
                cancelText: "Cancel"
            );

            if (confirm != true)
            {
                Logger.GenericLogInformation("EditRfq.FlipAllMatchedPartsAsync - User cancelled flip operation");
                return;
            }

            Logger.GenericLogInformation($"EditRfq.FlipAllMatchedPartsAsync - Flipping {MatchedParts.Count} matched parts");

            // Create a list to hold parts that need to be moved
            List<RfqDrawingPartNumberUx> partsToFlip = new List<RfqDrawingPartNumberUx>();

            // Update all matched parts
            foreach (var part in MatchedParts.ToList()) // ToList() to avoid modification during iteration
            {
                if (part != null)
                {
                    part.IsExactMatch = false;
                    part.IsMatched = false;
                    partsToFlip.Add(part);

                    // Update via service
                    await RfqUxClientService.UpdateRfqDrawingPartNumber(part);

                    Logger.GenericLogInformation($"EditRfq.FlipAllMatchedPartsAsync - Flipped part: {part.CustomerPartNumber}/{part.DrawingPartNumber}/");
                }
            }

            // Move all flipped parts from MatchedParts to UnmatchedParts
            foreach (var part in partsToFlip)
            {
                MatchedParts.Remove(part);
                UnmatchedParts.Add(part);
            }

            Snackbar.Add($"Successfully flipped {partsToFlip.Count} part(s) to unmatched", Severity.Success);
            Logger.GenericLogInformation($"EditRfq.FlipAllMatchedPartsAsync - Successfully flipped {partsToFlip.Count} parts");

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.GenericLogError("EditRfq.FlipAllMatchedPartsAsync - Error flipping matched parts", ex);
            Snackbar.Add($"Error flipping parts: {ex.Message}", Severity.Error);
        }
    }

    private async Task UploadFilesAsync()
    {
        await Task.Delay(0);
        try
        {
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.GenericLogError($"EditRfq.UploadFilesAsync - Unexpected error during file load {ex.Message}", ex);
        }
    }

    private async Task ReloadDataAsync()
    {
        await Task.Delay(0);
        try
        {
            await LoadDataAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.GenericLogError($"EditRfq.ReloadDataAsync - Unexpected error during data reload {ex.Message}", ex);
        }
    }

    private async Task RefreshDataAsync()
    {
        await Task.Delay(0);
        try
        {
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.GenericLogError($"EditRfq.RefreshDataAsync - Unexpected error during data refresh {ex.Message}", ex);
        }
    }
    #endregion

    #region Search All

    private async Task NprAllUnmatchedPartsAsync()
    {
        if (UnmatchedParts.Count == 0)
        {
            Snackbar.Add("No unmatched parts to search", Severity.Info);
            return;
        }
        await Task.Delay(1);
    }
    private async Task SearchAllUnmatchedPartsAsync()
    {
        if (UnmatchedParts.Count == 0)
        {
            Snackbar.Add("No unmatched parts to search", Severity.Info);
            return;
        }

        _isSearchingAll = true;
        _searchCancellationTokenSource = new CancellationTokenSource();

        try
        {
            Logger.GenericLogInformation($"EditRfq.SearchAllUnmatchedPartsAsync - Starting search for {UnmatchedParts.Count} unmatched parts");

            int totalCount = UnmatchedParts.Count;

            // Create progress state
            var progressState = new SearchProgressState(totalCount, _searchCancellationTokenSource);

            // Create progress dialog parameters
            DialogParameters progressParams = new DialogParameters
        {
            { "ProgressState", progressState }
        };

            DialogOptions progressOptions = new DialogOptions
            {
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
                CloseOnEscapeKey = false,
                BackdropClick = true
            };

            IDialogReference progressDialog = await DialogService.ShowAsync<SearchProgressDialog>(
                "Search Progress",
                progressParams,
                progressOptions
            );

            // List to track parts that need to be moved
            List<RfqDrawingPartNumberUx> partsToMove = new List<RfqDrawingPartNumberUx>();

            int processedCount = 0;
            int totalSearched = 0;
            int totalMatched = 0;
            int totalUnmatched = 0;
            int multiMatchCount = 0;

            // Process each unmatched part
            foreach (RfqDrawingPartNumberUx? part in UnmatchedParts.ToList())
            {
                if (_searchCancellationTokenSource.Token.IsCancellationRequested)
                {
                    Logger.GenericLogInformation("EditRfq.SearchAllUnmatchedPartsAsync - Search cancelled by user");
                    break;
                }

                if (part == null || string.IsNullOrWhiteSpace(part.CustomerPartNumber))
                {
                    continue;
                }

                string currentPartNumber = part.CustomerPartNumber;
                Logger.GenericLogInformation($"EditRfq.SearchAllUnmatchedPartsAsync - Searching part {processedCount + 1}/{totalCount}: {currentPartNumber}");

                try
                {
                    // Clean up part number
                    string cleanedUpPn = part.CustomerPartNumber.Replace("-", "").Replace(" ", "").ToUpperInvariant();

                    // Search EMACS for Sumitomo part numbers
                    SearchResultUx emacsExactResponse = await RfqUxClientService.SearchEmacsExactCustomerPn(cleanedUpPn);
                    SearchResultUx emacsContainsResponse = await RfqUxClientService.SearchEmacsContainsCustomerPn(cleanedUpPn);

                    totalSearched++;
                    // first try exact match
                    if (emacsExactResponse.IsSuccessful && emacsExactResponse.StringList != null && emacsExactResponse.StringList.Count > 0)
                    {
                        // Get the first Sumitomo part number
                        string? sumitomoPartNumber = emacsExactResponse.StringList.FirstOrDefault();
                        // Add all exactly matched part numbers
                        part.MatchedPartNumbers.AddRange(emacsExactResponse.ToMatchedPartNumbersList(true));

                        // now search for prices in NPR
                        if (!string.IsNullOrWhiteSpace(sumitomoPartNumber))
                        {
                            // Search NPR for pricing
                            SearchResultUx nprResponse = await RfqUxClientService.SearchNprSewsePn(sumitomoPartNumber);

                            if (nprResponse.IsSuccessful &&
                                nprResponse.StringList != null &&
                                nprResponse.StringList.Count > 0 &&
                                nprResponse.DoubleList != null &&
                                nprResponse.DoubleList.Count > 0)
                            {
                                // Get the first NPR part and price
                                string nprPartNumber = nprResponse.StringList[0];
                                decimal nprPrice = Math.Round((decimal)nprResponse.DoubleList[0], 5, MidpointRounding.AwayFromZero);

                                // Check if there are multiple matches
                                bool hasMultipleMatches = nprResponse.StringList.Count > 1;

                                // Update part with NPR data
                                part.DrawingPartNumber = nprPartNumber;
                                part.DrawingPartNumberPrice = nprPrice;
                                // part.SwappedPartNumber = nprPartNumber;
                                // part.SwappedPartNumberPrice = nprPrice;
                                part.PriceSource = "NPR";
                                part.IsExactMatch = true;
                                part.IsMatched = true;
                                part.IsSwapped = false;
                                part.MultiMatch = hasMultipleMatches;
                                // add all the matches in the nprsearch list to the first of the MatchedPartNumbers
                                part.MatchedPartNumbers[0].NprSearchResults.AddRange(nprResponse.ToNprSearchResultsList());

                                if (hasMultipleMatches)
                                {
                                    multiMatchCount++;
                                }

                                // Add audit comment
                                var commentData = new
                                {
                                    User = "System",
                                    Timestamp = DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm:ss.fffZ"),
                                    Action = "AutoSearch_NPR_Applied",
                                    SumitomoPartNumber = sumitomoPartNumber,
                                    NprPartNumber = nprPartNumber,
                                    NprPrice = nprPrice,
                                    MultiMatch = hasMultipleMatches,
                                    MatchCount = nprResponse.StringList.Count,
                                    NprSearchResults0 = part.MatchedPartNumbers[0].NprSearchResults

                                };

                                string commentJson = System.Text.Json.JsonSerializer.Serialize(commentData, new System.Text.Json.JsonSerializerOptions
                                {
                                    WriteIndented = false
                                });

                                if (string.IsNullOrWhiteSpace(part.Comments))
                                {
                                    part.Comments = commentJson;
                                }
                                else
                                {
                                    part.Comments += $"; {commentJson}";
                                }

                                // Update via service
                                await RfqUxClientService.UpdateRfqDrawingPartNumber(part);

                                partsToMove.Add(part);
                                totalMatched++;

                                Logger.GenericLogInformation($"EditRfq.SearchAllUnmatchedPartsAsync - Matched contains part: {currentPartNumber} -> {nprPartNumber} (${nprPrice:F5}) - MultiMatch: {hasMultipleMatches}");
                            }
                            else
                            {
                                totalUnmatched++;
                                Logger.GenericLogInformation($"EditRfq.SearchAllUnmatchedPartsAsync - No NPR data found for: {currentPartNumber}");
                            }
                        }
                    }
                    else
                    {
                        // totalUnmatched++;
                        Logger.GenericLogInformation($"EditRfq.SearchAllUnmatchedPartsAsync - No EMACS results for: {currentPartNumber}");
                    }

                    // no exact match, try contains
                    if (emacsContainsResponse.IsSuccessful && emacsContainsResponse.StringList != null && emacsContainsResponse.StringList.Count > 0)
                    {
                        // Get the first Sumitomo part number
                        string? sumitomoPartNumber = emacsContainsResponse.StringList.FirstOrDefault();
                        // Add all contains matched part numbers
                        part.MatchedPartNumbers.AddRange(emacsContainsResponse.ToMatchedPartNumbersList(false));

                        if (!string.IsNullOrWhiteSpace(sumitomoPartNumber))
                        {
                            // Search NPR for pricing
                            SearchResultUx nprResponse = await RfqUxClientService.SearchNprSewsePn(sumitomoPartNumber);

                            if (nprResponse.IsSuccessful &&
                                nprResponse.StringList != null &&
                                nprResponse.StringList.Count > 0 &&
                                nprResponse.DoubleList != null &&
                                nprResponse.DoubleList.Count > 0)
                            {
                                // Get the first NPR part and price
                                string nprPartNumber = nprResponse.StringList[0];
                                decimal nprPrice = Math.Round((decimal)nprResponse.DoubleList[0], 5, MidpointRounding.AwayFromZero);

                                // Check if there are multiple matches
                                bool hasMultipleMatches = nprResponse.StringList.Count > 1;

                                // Update part with NPR data
                                part.DrawingPartNumber = nprPartNumber;
                                part.DrawingPartNumberPrice = nprPrice;
                                // part.SwappedPartNumber = nprPartNumber;
                                // part.SwappedPartNumberPrice = nprPrice;
                                part.PriceSource = "NPR";
                                part.IsExactMatch = false;
                                part.IsMatched = true;
                                part.IsSwapped = false;
                                part.MultiMatch = hasMultipleMatches;
                                // add all the matches in the nprsearch list to the first of the MatchedPartNumbers
                                part.MatchedPartNumbers[0].NprSearchResults.AddRange(nprResponse.ToNprSearchResultsList());

                                if (hasMultipleMatches)
                                {
                                    multiMatchCount++;
                                }

                                // Add audit comment
                                var commentData = new
                                {
                                    User = "System",
                                    Timestamp = DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm:ss.fffZ"),
                                    Action = "AutoSearch_NPR_Applied",
                                    SumitomoPartNumber = sumitomoPartNumber,
                                    NprPartNumber = nprPartNumber,
                                    NprPrice = nprPrice,
                                    MultiMatch = hasMultipleMatches,
                                    MatchCount = nprResponse.StringList.Count,
                                    NprSearchResults0 = part.MatchedPartNumbers[0].NprSearchResults
                                };

                                string commentJson = System.Text.Json.JsonSerializer.Serialize(commentData, new System.Text.Json.JsonSerializerOptions
                                {
                                    WriteIndented = false
                                });

                                if (string.IsNullOrWhiteSpace(part.Comments))
                                {
                                    part.Comments = commentJson;
                                }
                                else
                                {
                                    part.Comments += $"; {commentJson}";
                                }

                                // Update via service
                                await RfqUxClientService.UpdateRfqDrawingPartNumber(part);

                                partsToMove.Add(part);
                                totalMatched++;

                                Logger.GenericLogInformation($"EditRfq.SearchAllUnmatchedPartsAsync - Matched contains part: {currentPartNumber} -> {nprPartNumber} (${nprPrice:F5}) - MultiMatch: {hasMultipleMatches}");
                            }
                            else
                            {
                                totalUnmatched++;
                                Logger.GenericLogInformation($"EditRfq.SearchAllUnmatchedPartsAsync - No NPR data found for: {currentPartNumber}");
                            }
                        }
                    }
                    else
                    {
                        totalUnmatched++;
                        Logger.GenericLogInformation($"EditRfq.SearchAllUnmatchedPartsAsync - No EMACS results for: {currentPartNumber}");
                    }
                }
                catch (Exception ex)
                {
                    Logger.GenericLogError($"EditRfq.SearchAllUnmatchedPartsAsync - Error searching part: {currentPartNumber}", ex);
                    totalUnmatched++;
                }

                processedCount++;

                // Update progress state - this will trigger the dialog to update
                progressState.UpdateProgress(
                    processedCount,
                    totalSearched,
                    totalMatched,
                    totalUnmatched,
                    multiMatchCount,
                    currentPartNumber
                );
            }

            // Move matched parts from UnmatchedParts to MatchedParts
            foreach (var part in partsToMove)
            {
                UnmatchedParts.Remove(part);
                MatchedParts.Add(part);
            }

            // Mark as complete
            progressState.Complete();

            Logger.GenericLogInformation($"EditRfq.SearchAllUnmatchedPartsAsync - Search complete. Searched: {totalSearched}, Matched: {totalMatched}, Unmatched: {totalUnmatched}, MultiMatch: {multiMatchCount}");

            // Close progress dialog after a short delay
            await Task.Delay(2000);
            progressDialog.Close();

            Snackbar.Add($"Search complete: {totalMatched} matched, {totalUnmatched} unmatched ({multiMatchCount} with multiple matches)", Severity.Success);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.GenericLogError("EditRfq.SearchAllUnmatchedPartsAsync - Error during search all operation", ex);
            Snackbar.Add($"Error during search: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSearchingAll = false;
            _searchCancellationTokenSource?.Dispose();
            _searchCancellationTokenSource = null;
        }
    }
