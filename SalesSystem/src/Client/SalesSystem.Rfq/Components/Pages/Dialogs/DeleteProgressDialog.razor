@using SalesSystem.Rfq.Models
@using MudBlazor

@inject ISnackbar Snackbar
@inject ILogger<DeleteProgressDialog> Logger
@inject IDialogService DialogService

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h6" Class="mb-4">
            Deleting All Part Numbers
        </MudText>

        <MudGrid>
            <MudItem xs="12">
                <MudProgressLinear Color="Color.Primary"
                                   Value="@ProgressPercentage"
                                   Size="Size.Large"
                                   Class="mb-2" />
                <MudText Typo="Typo.body2" Align="Align.Center" Class="mb-4">
                    @_currentPartNumber (@_processedCount of @_totalCount parts)
                </MudText>
            </MudItem>

            <MudItem xs="12" sm="4">
                <MudPaper Elevation="2" Class="pa-3 text-center">
                    <MudText Typo="Typo.h4" Color="Color.Info">@_processedCount</MudText>
                    <MudText Typo="Typo.body2">Total Processed</MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="4">
                <MudPaper Elevation="2" Class="pa-3 text-center">
                    <MudText Typo="Typo.h4" Color="Color.Success">@_successCount</MudText>
                    <MudText Typo="Typo.body2">Deleted</MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="4">
                <MudPaper Elevation="2" Class="pa-3 text-center">
                    <MudText Typo="Typo.h4" Color="Color.Error">@_failedCount</MudText>
                    <MudText Typo="Typo.body2">Failed</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel"
                   Color="Color.Secondary"
                   Variant="Variant.Filled"
                   Disabled="@(!_canCancel)">
            @(_isComplete ? "Close" : "Cancel")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public DeleteProgressState ProgressState { get; set; } = null!;

    private int _totalCount;
    private int _processedCount;
    private int _successCount;
    private int _failedCount;
    private string _currentPartNumber = string.Empty;
    private bool _isComplete;
    private bool _canCancel = true;

    private double ProgressPercentage => _totalCount > 0 ? (_processedCount * 100.0 / _totalCount) : 0;

    protected override void OnInitialized()
    {
        if (ProgressState != null)
        {
            ProgressState.StateChanged += ProgressState_StateChanged;
            UpdateState();
        }
    }

    private void ProgressState_StateChanged(object? sender, EventArgs e)
    {
        UpdateState();
    }

    private void UpdateState()
    {
        _totalCount = ProgressState.TotalCount;
        _processedCount = ProgressState.ProcessedCount;
        _successCount = ProgressState.SuccessCount;
        _failedCount = ProgressState.FailedCount;
        _currentPartNumber = ProgressState.CurrentPartNumber;
        _isComplete = ProgressState.IsComplete;
        _canCancel = ProgressState.CanCancel;

        InvokeAsync(StateHasChanged);
    }

    private void Cancel()
    {
        ProgressState?.Cancel();
        MudDialog.Cancel();
    }

    public void Dispose()
    {
        if (ProgressState != null)
        {
            ProgressState.StateChanged -= ProgressState_StateChanged;
        }
    }
}
