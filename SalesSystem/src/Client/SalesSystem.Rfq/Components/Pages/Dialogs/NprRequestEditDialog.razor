@using SalesSystem.Rfq.Enums
@using SalesSystem.Rfq.Models
@using MudBlazor

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudGrid>
                <MudItem xs="6">
                    <MudTextField @bind-Value="NprRequest.SumitomoNumber"
                                  Label="Sumitomo Number"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="6">
                    <MudTextField @bind-Value="NprRequest.CustomerPartNumber"
                                  Label="Customer P/N"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="6">
                    <MudTextField @bind-Value="NprRequest.SupplierPartNumber"
                                  Label="Supplier P/N"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="6">
                    <MudTextField @bind-Value="NprRequest.MaterialDescription"
                                  Label="Material Description"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="6">
                    <MudTextField @bind-Value="NprRequest.Reason"
                                  Label="Reason"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="6">
                    <MudTextField @bind-Value="NprRequest.Customer"
                                  Label="Customer"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="6">
                    <MudTextField @bind-Value="NprRequest.PlatformName"
                                  Label="Platform"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="6">
                    <MudTextField @bind-Value="NprRequest.ProgramName"
                                  Label="Program"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="6">
                    <MudTextField @bind-Value="NprRequest.Project"
                                  Label="Project"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="6">
                    <MudTextField @bind-Value="NprRequest.MaterialType"
                                  Label="Material Type"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="6">
                    <MudTextField @bind-Value="NprRequest.SuggestedSewsEManufacturingSite"
                                  Label="Mfg. Site"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="3">
                    <MudTextField @bind-Value="NprRequest.UnitOfMeasure"
                                  Label="UoM"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="3">
                    <MudTextField @bind-Value="NprRequest.SupplierGroup"
                                  Label="Supplier Group"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="3">
                    <MudNumericField @bind-Value="NprRequest.QtyPerVehicle"
                                     Label="Qty/Vehicle"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="3">
                    <MudNumericField @bind-Value="NprRequest.Quantity"
                                     Label="Quantity"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="6">
                    <MudDatePicker @bind-Date="NprRequest.RequiredDate"
                                   Label="Required Date"
                                   DateFormat="dd.MM.yyyy"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="6">
                    <MudTextField @bind-Value="NprRequest.RaisedRemarks"
                                  Label="Remarks"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Lines="2" />
                </MudItem>
                <MudItem xs="4">
                    <MudCheckBox @bind-Value="NprRequest.IsCustomerNominatedSupplier"
                                 Label="Cust. Nom. Supplier"
                                 Dense="true" />
                </MudItem>
                <MudItem xs="4">
                    <MudCheckBox @bind-Value="NprRequest.IsCustomerNominatedMaterial"
                                 Label="Cust. Nom. Material"
                                 Dense="true" />
                </MudItem>
                <MudItem xs="4">
                    <MudCheckBox @bind-Value="NprRequest.SamplesRequired"
                                 Label="Samples Required"
                                 Dense="true" />
                </MudItem>
                <MudItem xs="4">
                    <MudTextField @bind-Value="NprRequest.SampleSite"
                                  Label="Sample Site"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="4">
                    <MudNumericField @bind-Value="NprRequest.SampleQuantity"
                                     Label="Sample Qty"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="4">
                    <MudTextField @bind-Value="NprRequest.SampleRecipient"
                                  Label="Sample Recipient"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="6">
                    <MudDatePicker @bind-Date="NprRequest.SampleRequiredDate"
                                   Label="Sample Required Date"
                                   DateFormat="dd.MM.yyyy"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="6">
                    <MudTextField @bind-Value="NprRequest.FreightAccount"
                                  Label="Freight Account"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="6">
                    <MudTextField @bind-Value="NprRequest.AssociatedParts"
                                  Label="Associated Parts"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="6">
                    <MudTextField @bind-Value="NprRequest.SuggestedManufacturer"
                                  Label="Suggested Manufacturer"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel"
                   Color="Color.Secondary"
                   Variant="Variant.Text">
            Cancel
        </MudButton>
        <MudButton OnClick="Save"
                   Color="Color.Primary"
                   Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Save">
            Save
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    public IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public RfqNprRequestUxModel NprRequest { get; set; } = new();

    MudForm? _form;

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private void Save()
    {
        MudDialog.Close(DialogResult.Ok(NprRequest));
    }
}