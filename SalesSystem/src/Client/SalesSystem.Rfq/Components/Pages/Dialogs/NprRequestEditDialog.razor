@using SalesSystem.Rfq.Components.Pages.Components
@using SalesSystem.Rfq.Enums
@using SalesSystem.Rfq.Models
@using MudBlazor

<style>
    ::deep .mud-dialog-content {
        padding: 16px 24px;
    }

    ::deep .mud-grid {
        margin: 0;
    }

    ::deep .mud-input-outlined {
        margin-bottom: 0;
    }
</style>

<MudDialog>
    <DialogContent>
        <MudForm @ref="_Form">
            <MudGrid>
                @* Row 1: Identifiers *@
                <MudItem xs="6">
                    @* <MudTextField @bind-Value="NprRequest.SumitomoNumber"
                                  Label="Sumitomo Number"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" /> *@
                </MudItem>
                <MudItem xs="6">
                    <MudTextField @bind-Value="NprRequest.CustomerPartNumber"
                                  Label="Customer P/N"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                @* Row 2: Supplier info *@
                <MudItem xs="6">
                    <MudTextField @bind-Value="NprRequest.SupplierPartNumber"
                                  Label="Supplier P/N"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="6">
                    <MudTextField @bind-Value="NprRequest.MaterialDescription"
                                  Label="Material Description"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                @* Row 3: Reason & Customer *@
                <MudItem xs="6">
                    <MudTextField @bind-Value="NprRequest.Reason"
                                  Label="Reason"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="6">
                    <MudTextField @bind-Value="NprRequest.CustomerCode"
                                  Label="Customer Code"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                @* Row 4: Platform & Program *@
                <MudItem xs="6">
                    <MudTextField @bind-Value="NprRequest.PlatformName"
                                  Label="Platform"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="6">
                    <MudTextField @bind-Value="NprRequest.ProgramName"
                                  Label="Program"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                @* Row 5: Project & Material *@
                <MudItem xs="6">
                    <MudTextField @bind-Value="NprRequest.ProjectCode"
                                  Label="Project Code"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="2">
                    <MudTextField @bind-Value="NprRequest.MaterialNumber"
                                  Label="Material Number"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="2">
                    <MudTextField @bind-Value="NprRequest.ManufacturingSite "
                                  Label="Manufacturing Site"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="2">
                    <MudTextField @bind-Value="NprRequest.MaterialTypeDescription"
                                  Label="Material Type"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                @* Row 6: Manufacturing & Units *@
                <MudItem xs="6">
                    <MudTextField @bind-Value="NprRequest.SuggestedManufacturerGroup"
                                  Label="Suggested Mfg. Group"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="3">
                    <MudTextField @bind-Value="NprRequest.SEWSEUnitOfMeasurement"
                                  Label="UoM"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="3">
                    <MudAutocomplete T="SupplierGroupUxModel"
                                     @ref="_SupplierGroupAutocomplete"
                                     @bind-Value="SelectedSupplierGroup"
                                     Label="Supplier Group"
                                     Placeholder="Search supplier group..."
                                     SearchFunc="@SearchSupplierGroups"
                                     ToStringFunc="@(sg => sg?.SupplierGroupName ?? "")"
                                     Strict="false"
                                     ResetValueOnEmptyText="false"
                                     CoerceText="true"
                                     CoerceValue="true"
                                     SelectValueOnTab="true"
                                     AdornmentIcon="@Icons.Material.Filled.Business"
                                     AdornmentColor="Color.Primary"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Clearable="true"
                                     DebounceInterval="250"
                                     MinCharacters="0"
                                     ShowProgressIndicator="true"
                                     MaxItems="50">
                        <ItemTemplate Context="supplierGroup">
                            <MudText Typo="Typo.body2">
                                <strong>@supplierGroup.SupplierGroupName</strong>
                            </MudText>
                        </ItemTemplate>
                        <NoItemsTemplate>
                            <MudText Typo="Typo.body2" Align="Align.Center" Class="pa-2">
                                No supplier groups found.
                            </MudText>
                        </NoItemsTemplate>
                    </MudAutocomplete>
@*                     <MudTextField @bind-Value="NprRequest.SupplierGroup"
                                  Label="Supplier Group"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" /> *@
                </MudItem>

                @* Row 7: Quantities *@
                <MudItem xs="3">
                    <MudNumericField @bind-Value="NprRequest.QtyPerVehicle"
                                     Label="Qty/Vehicle"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="3">
                    <MudNumericField @bind-Value="NprRequest.VehicleTotalQuantity"
                                     Label="Vehicle Total Quantity"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="6">
                    <MudDatePicker @bind-Date="NprRequest.DeadlineDate"
                                   Label="Deadline Date"
                                   DateFormat="dd.MM.yyyy"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense" />
                </MudItem>

                @* Row 8: Remarks *@
                <MudItem xs="12">
                    <MudTextField @bind-Value="NprRequest.NPRRaisedRemarks"
                                  Label="NPR Raised Remarks"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Lines="2" />
                </MudItem>

                @* Row 9: Nomination flags & Samples *@
                <MudItem xs="3">
                    <MudCheckBox @bind-Value="NprRequest.IsCustomerNominatedSupplier"
                                 Label="Cust. Nom. Supplier"
                                 Dense="true" />
                </MudItem>
                <MudItem xs="3">
                    <MudCheckBox @bind-Value="NprRequest.IsCustomerNominatedMaterial"
                                 Label="Cust. Nom. Material"
                                 Dense="true" />
                </MudItem>
                <MudItem xs="3">
                    <MudCheckBox @bind-Value="NprRequest.IsSampleDataRequired"
                                 Label="Samples Required"
                                 Dense="true" />
                </MudItem>
                <MudItem xs="3" />

                @* Row 10: Sample details (disabled when not required) *@
                @if(NprRequest.IsSampleDataRequired)
                {
                    <NprRequestSamples Samples="NprRequest.SampleSiteDetails" />
                }

                @* Row 11: Remaining fields *@
                <MudItem xs="4">
                    @* <MudTextField @bind-Value="NprRequest.FreightAccount"
                                  Label="Freight Account"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" /> *@
                </MudItem>
                <MudItem xs="4">
                    <MudTextField @bind-Value="NprRequest.AssociatedParts"
                                  Label="Associated Parts"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="4">
                    <MudAutocomplete T="SupplierUxModel"
                                     @ref="_SupplierAutocomplete"
                                     @bind-Value="SelectedSupplier"
                                     Label="Supplier"
                                     Placeholder="Search supplier..."
                                     SearchFunc="@SearchSuppliers"
                                     ToStringFunc="@(sg => sg?.SupplierName ?? "")"
                                     Strict="false"
                                     ResetValueOnEmptyText="false"
                                     CoerceText="true"
                                     CoerceValue="true"
                                     SelectValueOnTab="true"
                                     AdornmentIcon="@Icons.Material.Filled.Business"
                                     AdornmentColor="Color.Primary"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Clearable="true"
                                     DebounceInterval="250"
                                     MinCharacters="0"
                                     ShowProgressIndicator="true"
                                     MaxItems="50">
                        <ItemTemplate Context="supplier">
                            <MudText Typo="Typo.body2">
                                <strong>@supplier.SupplierName</strong>
                            </MudText>
                        </ItemTemplate>
                        <NoItemsTemplate>
                            <MudText Typo="Typo.body2" Align="Align.Center" Class="pa-2">
                                No supplier found.
                            </MudText>
                        </NoItemsTemplate>
                    </MudAutocomplete>
                    @* <MudTextField @bind-Value="NprRequest.SuggestedManufacturer"
                                  Label="Suggested Manufacturer"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" /> *@
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel"
                   Color="Color.Secondary"
                   Variant="Variant.Text">
            Cancel
        </MudButton>
        <MudButton OnClick="Save"
                   Color="Color.Primary"
                   Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Save">
            Save
        </MudButton>
    </DialogActions>
</MudDialog>