@using SalesSystem.Rfq.Models
@using MudBlazor

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h6" Class="mb-4">
            Enter NPR Information
        </MudText>
        <MudForm @ref="_form" @bind-IsValid="_isValid">
            <MudGrid>
                <MudItem xs="12">
                    <MudTextField @bind-Value="NprNumber"
                                  Label="NPR Number"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Required="true"
                                  RequiredError="NPR number is required" />
                </MudItem>
                <MudItem xs="12">
                    <MudDatePicker @bind-Date="NprDate"
                                   Label="NPR Date"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Required="true"
                                   RequiredError="NPR date is required"
                                   Editable="true"
                                   DateFormat="yyyy-MM-dd" />
                </MudItem>
                <MudItem xs="12">
                    <MudNumericField @bind-Value="NprEstimatedPrice"
                                     Label="Dummy Price"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Format="0.#####"
                                     Adornment="Adornment.End"
                                     AdornmentText="€"
                                     Min="0m"
                                     Required="true"
                                     RequiredError="Dummy price is required" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Color="Color.Default">Cancel</MudButton>
        <MudButton OnClick="Apply" Color="Color.Primary" Variant="Variant.Filled" Disabled="!_isValid">OK</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    private string? NprNumber { get; set; }
    private DateTime? NprDate { get; set; }
    private decimal? NprEstimatedPrice { get; set; }
    private MudForm _form = null!;
    private bool _isValid;

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task Apply()
    {
        await _form.ValidateAsync();
        if (_isValid)
        {
            var result = new NprData
            {
                NprNumber = NprNumber,
                NprDate = NprDate,
                NprEstimatedPrice = NprEstimatedPrice
            };
            MudDialog.Close(DialogResult.Ok(result));
        }
    }

    public class NprData
    {
        public string? NprNumber { get; set; }
        public DateTime? NprDate { get; set; }
        public decimal? NprEstimatedPrice { get; set; }
    }
}