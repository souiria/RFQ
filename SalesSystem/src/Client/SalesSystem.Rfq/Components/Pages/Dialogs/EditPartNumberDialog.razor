@using MudBlazor
@using SalesSystem.Rfq.Enums
@using SalesSystem.Rfq.Models

@inject IDialogService DialogService
@inject ILogger<EditPartNumberDialog> Logger
@inject RfqUxClientService RfqUxClientService

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_isValid">
            <MudGrid>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="EditedItem.CustomerPartNumber"
                                  Label="Customer Part Number"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Required="true"
                                  RequiredError="Original part number is required" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="EditedItem.DrawingPartNumber"
                                  Label="Original Part Number"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  RequiredError="Original part number is required" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField @bind-Value="EditedItem.DrawingPartNumberPrice"
                                     Label="Drawing P/N Price"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Format="0.#####"
                                     Adornment="Adornment.End"
                                     AdornmentText="€"
                                     Disabled="true"
                                     Min="0m" />
                </MudItem>
                @* Pick list from search results stored in the commment after data aseparator *@
                @if (@EditedItem.SearchResultPartNumbers.Count > 0)
                {
                    <MudItem xs="12">
                        <MudPaper Elevation="2" Class="pa-4">
                            <MudText Typo="Typo.h6" Class="mb-3">Matched Part Numbers</MudText>
                            <MudList T="RfqDrawingPartNumberUxModel" Dense="true">
                                @foreach (RfqDrawingPartNumberUxModel matchedPart in EditedItem.SearchResultPartNumbers)
                                {
                                    <MudListItem>
                                        <div style="display: flex; align-items: center; justify-content: space-between; width: 100%;">
                                            <div style="flex: 1;">
                                                <MudText Typo="Typo.body1">
                                                    <strong>@matchedPart.DrawingPartNumber</strong>
                                                </MudText>
                                                <MudText Typo="Typo.body2" Color="Color.Default">
                                                    Price: @(matchedPart.DrawingPartNumberPrice > 0 ? matchedPart.DrawingPartNumberPrice.ToString("C5") : "N/A")
                                                    @if (matchedPart.IsExactMatch == true)
                                                    {
                                                        <MudChip T="string"
                                                                 Size="Size.Small"
                                                                 Color="Color.Success"
                                                                 Class="ml-2">Exact Match</MudChip>
                                                    }
                                                </MudText>
                                            </div>
                                            <MudStack Row Spacing="2" Class="ma-1">
                                                <MudTooltip Text="Show Alt.Part Info">
                                                    <MudButton OnClick="@(() => ShowMatchedPart(matchedPart))"
                                                               Color="Color.Primary"
                                                               Variant="Variant.Filled"
                                                               Size="Size.Small"
                                                               StartIcon="@Icons.Material.Filled.Info">
                                                        Info
                                                    </MudButton>
                                                </MudTooltip>
                                                <MudTooltip Text="Pick Alt.Part">
                                                    <MudButton OnClick="@(() => PickMatchedPart(matchedPart))"
                                                               Color="Color.Primary"
                                                               Variant="Variant.Filled"
                                                               Size="Size.Small"
                                                               StartIcon="@Icons.Material.Filled.CheckCircle">
                                                        Pick
                                                    </MudButton>
                                                </MudTooltip>
                                            </MudStack>

                                        </div>
                                    </MudListItem>
                                    <MudDivider />
                                }
                            </MudList>
                        </MudPaper>
                    </MudItem>
                }
                @* End pick list *@
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="EditedItem.SwappedPartNumber"
                                  Label="Dummy/Alt. Part Number"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="EditedItem.SwappedPartNumberPrice"
                                     Label="Dummy/Alt. P/N Price"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Format="0.#####"
                                     Adornment="Adornment.End"
                                     AdornmentText="€"
                                     Disabled="true"
                                     Min="0m" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="EditedItem.PriceSource"
                                  Label="Price Source"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudCheckBox @bind-Value="EditedItem.IsExactMatch"
                                 ReadOnly="true"    
                                 Label="Is Exact Match"
                                 Color="Color.Primary"
                                 Dense="true" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudCheckBox Value="EditedItem.IsSwapped"
                                 ReadOnly="true"
                                 Label="Is Swapped"
                                 Color="Color.Primary"
                                 Dense="true" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudCheckBox Value="EditedItem.IsCompleted"
                                 ReadOnly="true"
                                 Label="Is Matched"
                                 Color="Color.Primary"
                                 Dense="true" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="EditedItem.Comments"
                                  Label="Comments"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Lines="3"
                                  MaxLength="500" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Value="@EditedItem.RowId.ToString()"
                                  Label="Row ID"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  ReadOnly="true"
                                  Disabled="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Value="@EditedItem.RfqId.ToString()"
                                  Label="RFQ ID"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  ReadOnly="true"
                                  Disabled="true" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="PickDummy" 
                   Color="Color.Secondary" 
                   Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Add"
                   Style="margin-right: 8px;">
            Pick Dummy
        </MudButton>
        <MudButton OnClick="CreateNpr" 
                   Color="Color.Info" 
                   Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.NoteAdd"
                   Style="margin-right: auto;">
            Create NPR
        </MudButton>
        <MudButton OnClick="Complete"
                   Disabled="!EditedItem.IsCompleted || !(0 < EditedItem.DrawingPartNumberPrice)"
                   Color="Color.Info"
                   Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.IncompleteCircle"
                   Style="margin-right: auto;">
            Complete
        </MudButton>
        <MudButton OnClick="Cancel" Color="Color.Default">Cancel</MudButton>
        <MudButton OnClick="Save" Color="Color.Primary" Variant="Variant.Filled" Disabled="!_isValid">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public RfqDrawingPartNumberUxModel OriginalItem { get; set; } = null!;

    private RfqDrawingPartNumberUxModel EditedItem { get; set; } = new();
    private MudForm _form = null!;
    private bool _isValid;

    protected override void OnInitialized()
    {
        // Create a copy of the original item to edit
        EditedItem = new RfqDrawingPartNumberUxModel
        {
            RowId = OriginalItem.RowId,
            RfqId = OriginalItem.RfqId,
            CustomerPartNumber = OriginalItem.CustomerPartNumber,
            DrawingPartNumber = OriginalItem.DrawingPartNumber,
            DrawingPartNumberPrice = OriginalItem.DrawingPartNumberPrice,
            SwappedPartNumber = OriginalItem.SwappedPartNumber,
            SwappedPartNumberPrice = OriginalItem.SwappedPartNumberPrice,
            PriceSource = OriginalItem.PriceSource,
            IsExactMatch = OriginalItem.IsExactMatch,
            IsSwapped = OriginalItem.IsSwapped,
            Comments = OriginalItem.Comments,
            Status = OriginalItem.Status
        };
        EditedItem.SearchResultPartNumbers.AddRange(OriginalItem.SearchResultPartNumbers);
    }



    private async Task ShowMatchedPart(RfqDrawingPartNumberUxModel item)
    {
        if (item == null)
        {
            Logger.GenericLogInformation($"No part number found for null item...");
            await DialogService.ShowMessageBoxAsync("Search Part Number", $"No part number found for null item...");
            return;
        }

        if (item.DrawingPartNumber == null)
        {
            Logger.GenericLogInformation("SEWS-E / DrawingPartNumber is null");
            await DialogService.ShowMessageBoxAsync("Search Part Number", "Drawing part number is not available.");
            return;
        }

        Logger.GenericLogInformation($"Searching for part number: {item.DrawingPartNumber}");

        try
        {
            // Create a copy of the item to avoid reference issues
            var searchedPartNumber = new RfqDrawingPartNumberUxModel
            {
                CustomerPartNumber = EditedItem.CustomerPartNumber,
                DrawingPartNumber = item.DrawingPartNumber,
                DrawingPartNumberPrice = item.DrawingPartNumberPrice,
                IsExactMatch = item.IsExactMatch,
                Index = item.Index
            };

            DialogParameters parameters = new DialogParameters
            {
                { "SearchedPartNumber", searchedPartNumber },
            };

            DialogOptions options = new DialogOptions
            {
                MaxWidth = MaxWidth.Large,
                FullWidth = true,
                CloseOnEscapeKey = true,
                BackdropClick = false,
                NoHeader = false
            };

            var dialog = await DialogService.ShowAsync<ShowInfoPartNumberDialog>(
                "More Info",
                parameters,
                options
            );

            var result = await dialog.Result;
            
            if (result != null && !result.Canceled && result.Data is RfqDrawingPartNumberUxModel updatedPart)
            {
                // Update the EditedItem with the selected part data
                PickMatchedPart(updatedPart);
            }
        }
        catch (Exception ex)
        {
            Logger.GenericLogError($"Error searching for part number: {item.CustomerPartNumber}/{item.DrawingPartNumber}", ex);
            await DialogService.ShowMessageBoxAsync(
                "Error",
                $"An error occurred while opening the search dialog: {ex.Message}"
            );
        }
    }

    private void PickMatchedPart(RfqDrawingPartNumberUxModel matchedPart)
    {
        // Assign the DrawingPartNumber and DrawingPartNumberPrice to the current item
        EditedItem.DrawingPartNumber = matchedPart.DrawingPartNumber;
        EditedItem.DrawingPartNumberPrice = matchedPart.DrawingPartNumberPrice;
        EditedItem.IsExactMatch = matchedPart.IsExactMatch;
        EditedItem.PriceSource = string.IsNullOrEmpty(matchedPart.PriceSource) ? "Manual" : "NPR";

        // Force UI refresh
        StateHasChanged();
    }

    private async Task PickDummy()
    {
        DialogOptions options = new DialogOptions
        {
            MaxWidth = MaxWidth.ExtraExtraLarge,
            FullWidth = true,
            CloseOnEscapeKey = true,
            BackdropClick = false
        };

        IDialogReference dialog = await DialogService.ShowAsync<PickAlternativePartDialog>(
            "Pick Dummy Part",
            options
        );

        DialogResult? result = await dialog.Result;

        // Bail out on cancel or non-priced selection
        if (result == null
            || result.Canceled
            || result.Data is not RfqDrawingPartNumberUxModel alternativePart)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(alternativePart.SwappedPartNumber)
            || alternativePart.SwappedPartNumberPrice <= 0.0m)
        {
            Logger.GenericLogInformation(
                $"PickDummy - Selection rejected: SwappedPartNumber='{alternativePart.SwappedPartNumber}', " +
                $"SwappedPartNumberPrice={alternativePart.SwappedPartNumberPrice}");
            return;
        }

        // Apply the picked dummy part to the edited item
        EditedItem.SwappedPartNumber = alternativePart.SwappedPartNumber;
        EditedItem.SwappedPartNumberPrice = alternativePart.SwappedPartNumberPrice;
        EditedItem.IsSwapped = true;
        EditedItem.IsExactMatch = false;
        EditedItem.PriceSource = "Emacs, alternative part pick";
        EditedItem.Status = RfqDrawingPartNumberStatus.AlternativePartSelected;

        // Audit trail in comments so the user can see what happened
        EditedItem.Comments = string.IsNullOrWhiteSpace(EditedItem.Comments)
            ? $"[Dummy picked: {EditedItem.SwappedPartNumber} @ {EditedItem.SwappedPartNumberPrice:C5}]"
            : $"{EditedItem.Comments} [Dummy picked: {EditedItem.SwappedPartNumber} @ {EditedItem.SwappedPartNumberPrice:C5}]";

        // Force UI refresh so the user sees the new values reflected in the form
        StateHasChanged();

        Logger.GenericLogInformation(
            $"PickDummy - Applied dummy part: {EditedItem.SwappedPartNumber} @ {EditedItem.SwappedPartNumberPrice:C5} " +
            $"to CustomerPartNumber={EditedItem.CustomerPartNumber}, RowId={EditedItem.RowId}");

        // Auto-complete: a priced dummy part satisfies the Complete criteria
        // (hasSwappedPartNumberWithPrice == true), so close the dialog with
        // the completed item. The parent's HandlePartNumberUpdated will then
        // move the part from InProgressParts to CompletedParts because
        // IsCompleted == true on the returned model.
        bool? confirm = await DialogService.ShowMessageBoxAsync(
            "Auto-Complete",
            $"Mark this part as completed using dummy {EditedItem.SwappedPartNumber} @ {EditedItem.SwappedPartNumberPrice:C5}?",
            yesText: "Complete",
            cancelText: "No, just apply");

        if (confirm == true)
        {
            await Complete();
        }
    }

    private async Task CreateNpr()
    {
        DialogOptions options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseOnEscapeKey = true,
            BackdropClick = false
        };

        IDialogReference dialog = await DialogService.ShowAsync<CreateNprDialog>(
            "Create NPR",
            options
        );

        DialogResult? result = await dialog.Result;

        if (result != null 
            
            && !result.Canceled 
            && result.Data is CreateNprDialog.NprData nprData
            && nprData.NprEstimatedPrice>0)
        {
            // Update the EditedItem with dummy part data
            EditedItem.SwappedPartNumber = nprData.NprNumber ?? "";
            EditedItem.SwappedPartNumberPrice = nprData.NprEstimatedPrice ?? 0.0m;
            EditedItem.IsSwapped = true;
            EditedItem.IsExactMatch = false;
            EditedItem.PriceSource = "Npr Request";
            EditedItem.Status = RfqDrawingPartNumberStatus.NprRequested;

            EditedItem.Comments += $"[NPR Created: {nprData.NprNumber}, Date: {nprData.NprDate}] ";

            // Force UI refresh
            StateHasChanged();
        }
    }

    private async Task Complete()
    {
        await _form.ValidateAsync();
        if (!_isValid)
        {
            return;
        }

        // Check if the part has drawing part number with price OR swapped part number with swapped price
        bool hasDrawingPartNumberWithPrice = !string.IsNullOrWhiteSpace(EditedItem.DrawingPartNumber) 
            && EditedItem.DrawingPartNumberPrice > 0;

        bool hasSwappedPartNumberWithPrice = !string.IsNullOrWhiteSpace(EditedItem.SwappedPartNumber) 
            && EditedItem.SwappedPartNumberPrice > 0;

        if (hasDrawingPartNumberWithPrice || hasSwappedPartNumberWithPrice)
        {
            // If hasDrawingPartNumberWithPrice
            if (hasDrawingPartNumberWithPrice)
            {
                EditedItem.Status = RfqDrawingPartNumberStatus.ContainsMatch;
            }
             
            // If swapped part number is set with price, mark as swapped
            if (hasSwappedPartNumberWithPrice)
            {
                EditedItem.Status = RfqDrawingPartNumberStatus.AlternativePartSelected;
                EditedItem.IsSwapped = true;
            }

            // Close dialog and return the edited item
            // The IsCompleted property will automatically return true based on the logic in the model
            MudDialog.Close(DialogResult.Ok(EditedItem));
        }
        else
        {
            // Show validation message if neither condition is met
            await DialogService.ShowMessageBoxAsync(
                "Incomplete Part Number",
                "To complete this part number, you must have either:\n" +
                "- A drawing part number with a price, OR\n" +
                "- A swapped part number with a swapped price",
                "OK"
            );
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task Save()
    {
        await _form.ValidateAsync();
        if (_isValid)
        {
            MudDialog.Close(DialogResult.Ok(EditedItem));
        }
    }
}