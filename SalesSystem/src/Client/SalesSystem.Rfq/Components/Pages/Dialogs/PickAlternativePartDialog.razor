@code {
    bool _isLoading;
    bool IsLoading
    {
        get => _isLoading;
        set => _isLoading = value;
    }

    string _alternativePartFilter = "";
    string AlternativePartFilter
    {
        get => _alternativePartFilter;
        set => _alternativePartFilter = value;
    }

    private string _lastCompiledFilter = "";
    private Func<AlternativePartUxModel, bool>? _compiledQuickFilter;
    // Replace the property-based QuickFilter with a cached field
    private Func<AlternativePartUxModel, bool> QuickFilter => _quickFilterFunc;

    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    MudDataGrid<AlternativePartUxModel> _alternativePartNumbersGrid { get; set; } = null!;

    private string? AlternativePartNumber { get; set; }
    private decimal? AlternativePrice { get; set; }
    private MudForm _form = null!;
    private bool _isValid;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            AlternativePartFilter = "";

            // Check if data is already cached
            if (RfqUxClientService.AlternativeParts.Count > 0)
            {
                Logger.LogInformation($"PickAlternativePartDialog - Using cached {RfqUxClientService.AlternativeParts.Count} alternative parts");
                IsLoading = false;
                return;
            }

            // If not cached, load it now
            IsLoading = true;
            Logger.LogInformation("PickAlternativePartDialog - Loading alternative parts...");

            int alternativePartsCount = await RfqUxClientService.GetAllAlternativePartsAsync(0, -1);

            Logger.LogInformation($"PickAlternativePartDialog - Loaded {alternativePartsCount} alternative parts");

            IsLoading = false;
        }
        catch (Exception ex)
        {
            IsLoading = false;
            Logger.LogError(ex, "ERROR in PickAlternativePartDialog.OnInitializedAsync");
            Snackbar.Add($"Error loading alternative parts: {ex.Message}", Severity.Error);
        }
    }

    private async Task PickAlternativePart(AlternativePartUxModel alternativePart)
    {
        if (alternativePart == null)
        {
            Snackbar.Add("No part selected", Severity.Error);
            return;
        }

        if (string.IsNullOrEmpty(alternativePart.SumitomoNumber))
        {
            Snackbar.Add("Selected part has no Sumitomo Number", Severity.Error);
            return;
        }

        if (!alternativePart.Price.HasValue || alternativePart.Price.Value <= 0)
        {
            Snackbar.Add("Selected part has no price", Severity.Error);
            return;
        }

        await InvokeAsync(async () =>
        {
            // Set values
            AlternativePartNumber = alternativePart.SumitomoNumber;
            AlternativePrice = (decimal)alternativePart.Price.Value;

            // Force update
            StateHasChanged();

            // Wait for next render cycle
            await Task.Yield();

            // Validate form
            await _form.ValidateAsync();

            // Final update
            StateHasChanged();

            Logger.LogInformation($"PickAlternativePartDialog.PickAlternativePart Form valid: {_isValid}, PartNumber: {AlternativePartNumber}, Price: {AlternativePrice}");

            Snackbar.Add($"PickAlternativePartDialog.PickAlternativePart  Selected: {AlternativePartNumber} - ${AlternativePrice:F2}", Severity.Success);
        });
    }

    private async Task ShowInfo(AlternativePartUxModel alternativePart)
    {
        // existing component
        Logger.LogInformation($"VVV ShowInfo {alternativePart.SumitomoNumber} {alternativePart.SumitomoDescription} {alternativePart.Class1Name}");

        if (string.IsNullOrEmpty(alternativePart.SumitomoNumber))
        {
            Snackbar.Add("Alternative part number has no Sumitomo part number!", Severity.Error);
            return;
        }

        // show the dialog
        var parameters = new DialogParameters<ShowInfoAlternativePartNumberDialog> { { x => x.AlternativePartNumber, alternativePart } };
        var dialog = await DialogService.ShowAsync<ShowInfoAlternativePartNumberDialog>("Alternative Part Information", parameters, new() { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true });
        var result = await dialog.Result;
        if (result != null && !result.Canceled)
        {
            // picked
            AlternativePartUxModel? selectedPart = result.Data as AlternativePartUxModel;
            if(selectedPart != null)
            {
                Logger.GenericLogInformation($"Picked action");
                RfqDrawingPartNumberUxModel pickResult = new RfqDrawingPartNumberUxModel();

                pickResult.SwappedPartNumber = selectedPart.SumitomoNumber ?? "";
                pickResult.SwappedPartNumberPrice = selectedPart.Price > 0 ? Convert.ToDecimal(selectedPart.Price) : 0.0m;

                MudDialog.Close(DialogResult.Ok(result));
            }
        }
        //not picked
        return;
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task Apply()
    {
        await _form.ValidateAsync();
        if (_isValid)
        {
            var result = new RfqDrawingPartNumberUxModel();

            result.SwappedPartNumber = AlternativePartNumber ?? "";
            result.SwappedPartNumberPrice = Convert.ToDecimal(AlternativePrice);

            MudDialog.Close(DialogResult.Ok(result));
        }
    }

    private bool _quickFilterFunc(AlternativePartUxModel x)
    {
        if (string.IsNullOrWhiteSpace(AlternativePartFilter))
            return true;

        if (_lastCompiledFilter != AlternativePartFilter)
        {
            _lastCompiledFilter = AlternativePartFilter;
            var filter = AlternativePartFilter.Trim();
            var comparisonType = StringComparison.OrdinalIgnoreCase;
            var isNumeric = double.TryParse(filter, out _);

            _compiledQuickFilter = item =>
            {
                if (item.SumitomoNumber?.Contains(filter, comparisonType) == true) return true;
                if (item.SumitomoDescription?.Contains(filter, comparisonType) == true) return true;
                if (item.SupplierName?.Contains(filter, comparisonType) == true) return true;
                if (item.SupplierNumber?.Contains(filter, comparisonType) == true) return true;
                if (item.CurrencyCode?.Contains(filter, comparisonType) == true) return true;
                if (item.UnitOfMeasure?.Contains(filter, comparisonType) == true) return true;
                if (item.PartGroup?.Contains(filter, comparisonType) == true) return true;
                if (item.GroupDescription?.Contains(filter, comparisonType) == true) return true;
                if (item.Class1?.Contains(filter, comparisonType) == true) return true;
                if (item.Class1Name?.Contains(filter, comparisonType) == true) return true;
                if (item.Class2Name?.Contains(filter, comparisonType) == true) return true;
                if (item.ColourCode?.Contains(filter, comparisonType) == true) return true;
                if (item.ColorName?.Contains(filter, comparisonType) == true) return true;
                if (item.MaterialGroup?.Contains(filter, comparisonType) == true) return true;
                if (item.MaterialType?.Contains(filter, comparisonType) == true) return true;
                if (item.TypeDescription?.Contains(filter, comparisonType) == true) return true;
                if (item.CategoryCode?.Contains(filter, comparisonType) == true) return true;
                if (item.CategoryName?.Contains(filter, comparisonType) == true) return true;
