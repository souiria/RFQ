                                    <FilterTemplate>
                                        <MultiSelectColumnFilter T="AlternativePartUxModel"
                                                                 TProperty="string"
                                                                 Items="@RfqUxClientService.AlternativeParts"
                                                                 KeySelector="@((AlternativePartUxModel x) => (string?)x.MaterialGroup)"
                                                                 DisplaySelector="@((AlternativePartUxModel x) => $"{x.MaterialGroup}")"
