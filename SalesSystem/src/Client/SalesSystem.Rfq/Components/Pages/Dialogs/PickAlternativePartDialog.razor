@using SalesSystem.Rfq.Models
@using MudBlazor
@using SalesSystem.Rfq.Components.Pages.Components

@inject RfqUxClientService RfqUxClientService
@inject ILogger<PickAlternativePartDialog> Logger
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<style>
    :root {
        --alt-part-grid-font-size: 10px;
    }

    .mud-alt-part-grid .mud-table-head {
        background-color: lightgrey;
    }

        .mud-alt-part-grid .mud-table-head th {
            background-color: lightgrey;
        }

    .mud-alt-part-grid {
        overflow-x: auto !important;
        border: 1px solid #bdbdbd;
        border-radius: 4px;
    }

    .mud-alt-part-grid .mud-table-container {
        overflow-x: auto !important;
        overflow-y: auto !important;
    }

    .mud-alt-part-grid .mud-table-cell {
        padding: 1px !important;
        overflow: hidden;
        font-size: var(--alt-part-grid-font-size) !important;
        line-height: 1;
        text-align: left;
        text-overflow: ellipsis;
        vertical-align: middle;
        white-space: nowrap;
    }

    .mud-alt-part-grid .mud-table-head .mud-table-cell {
        font-size: 11px !important;
        font-weight: 700;
    }

    .mud-table-sticky-header {
        position: sticky;
        top: 0;
        z-index: 1;
        background-color: var(--mud-palette-surface);
    }

    /* First row: column headers */
    .mud-alt-part-grid .mud-table-head tr:first-child th {
        position: sticky;
        top: 0;
        z-index: 3;
        background-color: lightgrey;
    }

    /* Second row: filter inputs */
    .mud-alt-part-grid .mud-table-head tr:nth-child(2) th {
        position: sticky;
        top: 36px;
        z-index: 3;
        background-color: #f5f5f5;
        font-size: 11px !important;
    }

        .mud-alt-part-grid .mud-table-head tr:nth-child(2) th * {
            font-size: 11px !important;
        }

    /* Dialog action controls: compact font and minimal padding/margins */
    .mud-alt-part-dialog-actions {
        font-size: 10px !important;
    }

    .mud-alt-part-dialog-actions .mud-input-slot,
    .mud-alt-part-dialog-actions .mud-input-root,
    .mud-alt-part-dialog-actions .mud-input,
    .mud-alt-part-dialog-actions .mud-button-root,
    .mud-alt-part-dialog-actions .mud-typography,
    .mud-alt-part-dialog-actions label,
    .mud-alt-part-dialog-actions input {
        font-size: 10px !important;
        margin: 0 !important;
        padding: 0 !important;
    }

    .mud-alt-part-dialog-actions .mud-input-control {
        margin: 0 !important;
        padding: 0 !important;
    }

    .mud-alt-part-dialog-actions .mud-input {
        padding: 2px 4px !important;
    }

    .mud-alt-part-dialog-actions .mud-button-root {
        padding: 2px 6px !important;
        min-width: 0;
    }

    .mud-alt-part-dialog-actions .mud-form-helper-text {
        margin: 0 !important;
    }

    .alt-part-search-field,
    .alt-part-search-field .mud-input-slot,
    .alt-part-search-field input,
    .alt-part-search-field .mud-input-adornment {
        font-size: 12px !important;
    }

    .alt-part-search-tooltip .mud-tooltip {
        font-size: 12px !important;
    }

    .alt-part-number-field .mud-input-outlined-input,
    .alt-part-price-field .mud-input-outlined-input {
        padding: 1px !important;
        height: 28px;
        display: flex;
        align-items: center;
        box-sizing: border-box;
    }

    .alt-part-number-field .mud-input-slot,
    .alt-part-price-field .mud-input-slot {
        height: 28px;
        display: flex;
        align-items: center;
        padding: 0 !important;
    }

    .alt-part-number-field .mud-input-adornment,
    .alt-part-price-field .mud-input-adornment {
        height: 28px;
        display: flex;
        align-items: center;
    }

    /* Collapse the outlined variant's extra space reserved for the floating-label notch */
    .alt-part-number-field.mud-input-control,
    .alt-part-price-field.mud-input-control,
    .alt-part-number-field .mud-input-control,
    .alt-part-price-field .mud-input-control {
        height: 28px;
        min-height: 28px;
    }

    .alt-part-number-field .mud-input-control-input-container,
    .alt-part-price-field .mud-input-control-input-container {
        height: 28px;
        min-height: 28px;
        display: flex;
        align-items: center;
    }

    .alt-part-number-field .mud-input-outlined-border,
    .alt-part-price-field .mud-input-outlined-border {
        top: 0 !important;
        height: 28px !important;
    }

        .alt-part-number-field .mud-input-outlined-border legend,
        .alt-part-price-field .mud-input-outlined-border legend {
            display: none;
        }

    .alt-part-number-field .mud-input-label,
    .alt-part-price-field .mud-input-label {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        line-height: 1;
        margin: 0 !important;
    }

    /* Make the dialog content and grid stretch to fill available vertical space */
    .mud-alt-part-dialog-content {
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    .mud-alt-part-dialog-content .mud-grid {
        flex: 1 1 auto;
        min-height: 0;
        height: 100%;
    }

    .mud-alt-part-dialog-content .mud-grid-item:has(.mud-alt-part-grid) {
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    .mud-alt-part-grid {
        flex: 1 1 auto;
        min-height: 0;
        display: flex;
        flex-direction: column;
    }

    .mud-alt-part-grid .mud-table-container {
        flex: 1 1 auto;
        min-height: 0;
    }
</style>

<MudDialog Style="height: 80vh;">
