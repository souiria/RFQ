                                    </FilterTemplate>
                                </PropertyColumn>
                                @* <PropertyColumn Property="x => x.MaterialType" Title="Material Type" />
                                <PropertyColumn Property="x => x.TypeDescription" Title="Type Description" /> *@
                                <PropertyColumn Property="x => x.MaterialType" Title="Material Type">
                                    <FilterTemplate>
                                        <MultiSelectColumnFilter T="AlternativePartUxModel"
                                                                 TProperty="string"
                                                                 Items="@RfqUxClientService.AlternativeParts"
                                                                 KeySelector="@((AlternativePartUxModel x) => (string?)x.MaterialType)"
                                                                 DisplaySelector="@((AlternativePartUxModel x) => $"{x.MaterialType} - {x.TypeDescription}")"
                                                                 FilterContext="@context" />
                                    </FilterTemplate>
                                </PropertyColumn>
                                @* <PropertyColumn Property="x => x.CategoryCode" Title="Category Code" />
                                <PropertyColumn Property="x => x.CategoryName" Title="Category Name" /> *@
                                <PropertyColumn Property="x => x.CategoryCode" Title="Category Code/Name">
                                    <FilterTemplate>
                                        <MultiSelectColumnFilter T="AlternativePartUxModel"
