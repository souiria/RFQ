    private async Task ClearAllFiles()
    {
        try
        {
            // Clear all files from the collection
            FileObjects.Clear();
            
            // Reset the input file key to clear the input element
            inputFileKey = Guid.NewGuid().ToString();
            
            // Notify parent component that files have changed
            await NotifyFilesChanged();
            
            // Update the UI
            StateHasChanged();
            
            // Show success message
            Snackbar.Add("All files cleared successfully", Severity.Success);
            
            Console.WriteLine(">>> All files cleared from FileManager");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"ERROR in ClearAllFiles: {ex.Message}");
            Snackbar.Add($"Error clearing files: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteFile(FileObjectUxModel fileObject)
    {
        if (fileObject != null && fileObject.Status != UxObjectStatus.Deleted)
        {
            fileObject.Status = UxObjectStatus.Deleted;
            await NotifyFilesChanged();
            StateHasChanged();
        }
    }

    private async Task RestoreFile(FileObjectUxModel fileObject)
    {
        if (fileObject != null && fileObject.Status == UxObjectStatus.Deleted)
        {
            fileObject.Status = UxObjectStatus.Created;
            await NotifyFilesChanged();
            StateHasChanged();
        }
    }

    private async Task NotifyFilesChanged()
    {
        if (OnFilesChanged.HasDelegate)
        {
            await OnFilesChanged.InvokeAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_dropZoneInstance != null)
            {
                await _dropZoneInstance.InvokeVoidAsync("dispose");
                await _dropZoneInstance.DisposeAsync();
            }

            if (_module != null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"ERROR disposing FileManagement: {ex.Message}");
        }
    }

    /// <summary>
    /// Resets the InputFile component to prevent file ID mismatches when files are removed
    /// </summary>
    public async Task ResetInputFileAsync()
    {
        try
        {
            // Generate new key to force InputFile to re-render and reset internal state
            inputFileKey = Guid.NewGuid().ToString();
            
            // Force component to re-render
            StateHasChanged();
            
            // Small delay to ensure re-render completes
            await Task.Delay(50);
            
            Console.WriteLine($">>> InputFile reset with new key: {inputFileKey}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"ERROR resetting InputFile: {ex.Message}");
        }
    }

    /// <summary>
    /// Removes a file from the collection and resets InputFile if needed
    /// </summary>
    public async Task RemoveFileAsync(FileObjectUxModel fileObject)
    {
        try
        {
            if (FileObjects.Contains(fileObject))
            {
                FileObjects.Remove(fileObject);
                
                // Reset InputFile to prevent stale file references
                await ResetInputFileAsync();
                
                await NotifyFilesChanged();
                
                Console.WriteLine($">>> Removed file: {fileObject.File?.Name}");
                Snackbar.Add($"File '{fileObject.File?.Name}' removed successfully", Severity.Info);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"ERROR removing file: {ex.Message}");
            Snackbar.Add($"Error removing file: {ex.Message}", Severity.Error);
        }
    }
}