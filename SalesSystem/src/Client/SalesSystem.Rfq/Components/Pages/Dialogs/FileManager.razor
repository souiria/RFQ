@using System.IO
@using Microsoft.JSInterop
@using SalesSystem.Rfq.Enums
@using SalesSystem.Rfq.Services

@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@implements IAsyncDisposable

<style>
    .item-scroll {
        overflow-y: auto;
    }

    .mud-item-compact {
        padding-top: 4px !important;
        padding-left: 8px !important;
    }

    .drop-zone {
        padding: 4px;
        width: 100%;
        max-height: 128px;
        background: white;
        border: 2px dashed #0087F7;
        border-radius: 5px;
    }

    .drop-zone.hover {
        border-style: solid;
    }

    .file-item {
        border: 1px solid #ddd;
        border-radius: 4px;
        padding: 8px;
        margin: 4px 0;
        background: #f9f9f9;
    }

    .file-item.deleted {
        background: #ffebee;
        text-decoration: line-through;
        opacity: 0.6;
    }

    .file-manager-container {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
    }
</style>

<div class="file-manager-container">
    <MudStack Class="gap-4">
        <div @ref="dropZoneElement" class="drop-zone align-content-start">
            <InputFile @ref="inputFile" key="@inputFileKey" OnChange="OnChange" multiple style="display:none" />
            <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-4">Drag & Drop Files Here</MudText>
            <MudText Typo="Typo.subtitle2" Align="Align.Center" Class="mt-1">Max.16MB each</MudText>
            <MudTooltip Text="Clear all files">
                <MudIconButton Variant="Variant.Filled"
                               Icon="@Icons.Material.Filled.ClearAll"
                               Color="Color.Warning"
                               OnClick="ClearAllFiles"
                               Disabled="@(!FileObjects.Any())"
                               Size="Size.Small" />
            </MudTooltip>
            <MudTooltip Text="Upload files">
                <MudIconButton Icon="@Icons.Material.Filled.CloudUpload"
                               Color="Color.Primary"
                               Size="Size.Small"
                               Disabled="@UploadDisabled"
                               OnClick="@OnUploadClicked" />
            </MudTooltip>
        </div>
    </MudStack>
</div>

@code {
    const int MAX_FILE_SIZE = 16 * 1024 * 1024;

    [Parameter]
    public List<FileObjectUxModel> FileObjects { get; set; } = new();

    [Parameter]
    public EventCallback OnFilesChanged { get; set; }

    [Parameter]
    public EventCallback OnUploadClicked { get; set; }

    [Parameter]
    public bool UploadDisabled { get; set; } = true;

    // Drop zone elements
    private ElementReference dropZoneElement;
    private InputFile? inputFile;
    private string? inputFileKey = Guid.NewGuid().ToString();
    private IJSObjectReference? _module;
    private IJSObjectReference? _dropZoneInstance;

    // File management state
    private bool _isInitialized = false;

    protected override async Task OnInitializedAsync()
    {
        // await LoadComponentFiles();
        await Task.Delay(1); // Ensure async context
        _isInitialized = true;
    }

    protected override async Task OnParametersSetAsync()
    {
        await Task.Delay(1); // Ensure async context

        if (_isInitialized)
        {
            // await LoadComponentFiles();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/DropZone.js");
                if (inputFile?.Element != null)
                {
                    _dropZoneInstance = await _module.InvokeAsync<IJSObjectReference>("initializeFileDropZone", dropZoneElement, inputFile.Element);
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"ERROR initializing drop zone: {ex.Message}");
            }
        }
    }

    private async Task OnChange(InputFileChangeEventArgs e)
    {
        try
        {
            Console.WriteLine($">>> ENTER OnChange file upload, {e.FileCount} files");
            var addedFiles = new List<string>();
            var rejectedFiles = new List<string>();

            foreach (var file in e.GetMultipleFiles())
            {
                try
                {
                    // Check for duplicates by name and size
                    if (IsFileAlreadyAdded(file))
                    {
                        rejectedFiles.Add($"{file.Name} (duplicate)");
                        Console.WriteLine($"Rejected duplicate file: {file.Name}");
                        continue;
                    }

                    var fileObject = new FileObjectUxModel(file);

                    // Validate file type and size
                    var fileType = DetermineFileType(fileObject);
                    if (fileType != RfqFileType.UNK && fileObject.File?.Size <= MAX_FILE_SIZE && 0 < fileObject.File?.Size)
                    {
                        FileObjects.Add(fileObject);
                        addedFiles.Add(file.Name);
                        Console.WriteLine($"Added file: {fileObject.File?.Name} ({fileObject.File?.Size} bytes) as {fileType}, ID: {fileObject.Id}");
                    }
                    else
                    {
                        string reason = fileType == RfqFileType.UNK ? "unsupported file type" : 
                                       fileObject.File?.Size > MAX_FILE_SIZE ? "file too large" : 
                                       "invalid file size";
                        rejectedFiles.Add($"{file.Name} ({reason})");
                        Console.WriteLine($"Rejected file: {file.Name} - {reason}");
                    }
                }
                catch (Exception fileEx)
                {
                    rejectedFiles.Add($"{file.Name} (error: {fileEx.Message})");
                    Console.WriteLine($"Error processing file {file.Name}: {fileEx.Message}");
                }
            }

            // Show user feedback
            if (addedFiles.Count > 0)
            {
                string message = addedFiles.Count == 1 
                    ? $"Added file: {addedFiles[0]}"
                    : $"Added {addedFiles.Count} files: {string.Join(", ", addedFiles.Take(3))}{(addedFiles.Count > 3 ? "..." : "")}";
                Snackbar.Add(message, Severity.Success);
            }

            if (rejectedFiles.Count > 0)
            {
                string message = rejectedFiles.Count == 1 
                    ? $"Rejected file: {rejectedFiles[0]}"
                    : $"Rejected {rejectedFiles.Count} files: {string.Join(", ", rejectedFiles.Take(3))}{(rejectedFiles.Count > 3 ? "..." : "")}";
                Snackbar.Add(message, Severity.Warning);
            }

            await NotifyFilesChanged();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"ERROR in OnChange: {ex.Message}");
            Snackbar.Add($"Error uploading files: {ex.Message}", Severity.Error);
        }
    }

    private bool IsFileAlreadyAdded(IBrowserFile newFile)
    {
        return FileObjects.Any(f => 
            f.Status != UxObjectStatus.Deleted &&
            f.OriginalFileName == newFile.Name && 
            f.OriginalFileSize == newFile.Size);
    }

    private RfqFileType DetermineFileType(FileObjectUxModel fileObject)
    {
        if(fileObject.File == null)
        {
            return RfqFileType.UNK;
        }
        if(fileObject.Status == UxObjectStatus.Deleted)
        {
            return RfqFileType.UNK;
        }
        return DetermineFileType(fileObject.File.Name, fileObject.File.ContentType);
    }

    private RfqFileType DetermineFileType(string fileName, string contentType)
    {
        var extension = Path.GetExtension(fileName).ToLowerInvariant();

        return extension switch
        {
            ".dsi" => RfqFileType.DSI,
            ".csv" => RfqFileType.CSV,
            ".txt" => RfqFileType.TXT,
            ".xls" or ".xlsx" => RfqFileType.XLS,
            ".xml" => RfqFileType.XML,
            ".mtf" => RfqFileType.MTF,
            _ => RfqFileType.UNK
        };
    }

