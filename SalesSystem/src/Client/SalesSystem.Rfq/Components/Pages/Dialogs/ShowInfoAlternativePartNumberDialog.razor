@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    // This has a DrawingPartNumber set and possibly a DrawingPriceNumber, nothing else
    [Parameter] public AlternativePartUxModel? AlternativePartNumber { get; set; }

    private string _currentUser = "Unknown";

    protected override async Task OnInitializedAsync()
    {

        try
        {
            // Get current user
            var authState = await GetAuthenticationStateAsync.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity!.IsAuthenticated)
            {
                _currentUser = user?.Identity?.Name ?? "NoName";
                Logger.GenericLogInformation($"User is authenticated: {_currentUser}");
            }
            else
            {
                _currentUser = "Anonymous";
                Logger.GenericLogInformation("User is not authenticated.");
            }
        }
        catch (Exception ex)
        {
            Logger.GenericLogError("Error getting current user", ex);
        }

        await base.OnInitializedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender
            && AlternativePartNumber != null)
        {
            // Start loading images and NPR data for all parts in parallel
            await LoadPartImageAsync(AlternativePartNumber);
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    private string GetListItemStyle(bool isExactMatch)
    {
        return isExactMatch
            ? "background-color: lightgreen;"
            : "background-color: lightyellow;";
    }

    private async Task LoadPartImageAsync(AlternativePartUxModel alternativePartNumber)
    {
        if (string.IsNullOrWhiteSpace(alternativePartNumber.SumitomoNumber))
        {
            return;
        }

        try
        {
            await InvokeAsync(StateHasChanged);

            Logger.GenericLogInformation($"Loading image for alternative part number: {alternativePartNumber.SumitomoNumber}");

            SearchResultUxModel response = await RfqUxClientService.SearchAdssSewsePn(alternativePartNumber.SumitomoNumber);

            if (response.IsSuccessful &&
                response.ByteList != null &&
                response.ByteList.Count > 0 &&
                response.StringList2 != null &&
                response.StringList2.Count > 0)
            {
                // Get the first image (assuming ByteList contains complete image byte arrays)
                byte[] imageBytes = response.ByteList[0];
                string mimeType = response.StringList2[0] ?? "image/png";

                alternativePartNumber.PartImage = new PartImageDataUxModel
                {
                    ImageBytes = imageBytes,
                    MimeType = mimeType
                };
                alternativePartNumber.HasImage = true;

                Logger.GenericLogInformation($"Successfully loaded image for part number: {alternativePartNumber.SumitomoNumber}, Size: {imageBytes.Length} bytes, Type: {mimeType}");
            }
            else
            {
                alternativePartNumber.HasImage = false;
                Logger.GenericLogInformation($"No image found for part number: {alternativePartNumber.SumitomoNumber}");
            }
        }
        catch (Exception ex)
        {
            Logger.GenericLogError($"Error loading image for part number: {alternativePartNumber.SumitomoNumber}", ex);
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task Apply()
    {
        await Task.Delay(1);
        MudDialog.Close(DialogResult.Ok(AlternativePartNumber));
    }
    private void Close()
    {
        MudDialog.Close();
    }

}