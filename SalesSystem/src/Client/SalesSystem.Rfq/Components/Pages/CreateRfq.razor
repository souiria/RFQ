@page "/createRfq"
@page "/createRfq/{UserId:guid}"
@inject ISnackbar Snackbar
@inject RfqUxClientService RfqUxClientService
@inject ILogger<CreateRfq> Logger
@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer
@using Google.Protobuf.WellKnownTypes
@using SalesSystem.Rfq.Components.Pages.Dialogs
@using SalesSystem.Rfq.Extensions
@using SalesSystem.Rfq.Models

<MudText Typo="Typo.h5" Class="mb-auto" Align="Align.Center">Create RFI/RFQ</MudText>
<MudGrid Class="position-fixed">
    @* Attributes *@
    <MudItem xs="12">
        <MudPaper Class="d-flex flex-row" Style="height:150px;">
            <MudPaper Class="pa-4">
                <MudStack>
                    <MudSelect T="string"
                               Value="customerValue"
                               For="@(() => customerValue)"
                               ValueChanged="OnCustomerValueChanged"
                               Label="Customer"
                               Placeholder="Please Select"
                               AdornmentIcon="@Icons.Material.Filled.People"
                               Disabled="uploadedSuccessfully"
                               AdornmentColor="Color.Primary">
                        @foreach (var customer in RfqUxClientService.Customers)
                        {
                            <MudSelectItem Value="@customer?.CustomerBusinessGroupName">@customer?.CustomerBusinessGroupName</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect T="string"
                               Value="reasonValue"
                               For="@(() => reasonValue)"
                               ValueChanged="OnReasonValueChanged"
                               Label="Reason"
                               Placeholder="Please Select"
                               Disabled="uploadedSuccessfully"
                               AdornmentIcon="@Icons.Material.Filled.Checklist"
                               AdornmentColor="Color.Primary">
                        @foreach (var reason in RfqUxClientService.Reasons)
                        {
                            <MudSelectItem Value="@reason.RfqReasonTitle">@reason.RfqReasonTitle</MudSelectItem>
                        }
                    </MudSelect>
                </MudStack>
            </MudPaper>

            <MudPaper Class="pa-4">
                <MudStack>
                    @* CHANGED: MudSelect replaced with MudAutocomplete *@
                    <MudAutocomplete T="ProjectAssociationUx"
                                     @bind-Value="selectedProject"
                                     Label="Project"
                                     Placeholder="Search project..."
                                     SearchFunc="@SearchProjects"
                                     ToStringFunc="@(p => p != null ? $"{p.ProjectName} - {p.CustomerName}" : "")"
                                     ResetValueOnEmptyText="true"
                                     CoerceText="true"
                                     CoerceValue="false"
                                     Disabled="uploadedSuccessfully"
                                     AdornmentIcon="@Icons.Material.Filled.DesignServices"
                                     AdornmentColor="Color.Primary"
                                     Immediate="true"
                                     Dense="true"
                                     Clearable="true"
                                     ShowProgressIndicator="true"
                                     MaxItems="100">
                        <ItemTemplate Context="project">
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.body2">
                                    <strong>@project.ProjectName</strong>
                                </MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @project.ProjectName - @project.CustomerName
                                </MudText>
                            </MudStack>
                        </ItemTemplate>
                    </MudAutocomplete>

                    <MudNumericField @bind-Value="vehicleVolume"
                                     Label="Vehicle Volume"
                                     Disabled="uploadedSuccessfully"
                                     Variant="Variant.Text"
                                     Min="0" />
                </MudStack>
            </MudPaper>

            <MudPaper Class="pa-4">
                <MudStack>
                    <MudSelect T="string"
                               Value="quotationValue"
                               For="@(() => quotationValue)"
                               ValueChanged="OnQuotationValueChanged"
                               Label="Quotation Number"
                               Placeholder="Please Select"
                               Disabled="uploadedSuccessfully"
                               AdornmentIcon="@Icons.Material.Filled.RequestQuote"
                               AdornmentColor="Color.Primary">
                        @foreach (string quotationNumber in RfqUxClientService.QuotationNumbers)
                        {
                            <MudSelectItem Value="@quotationNumber">@quotationNumber</MudSelectItem>
                        }
                    </MudSelect>
                    <MudDatePicker Label="Date Format"
                                   @bind-Date="date"
                                   Disabled="uploadedSuccessfully"
                                   DateFormat="dd.MM.yyyy" />

                </MudStack>
            </MudPaper>

            <MudPaper Class="d-flex flex-grow-1 pa-4 w-100">
                <FileManager @ref="componentFileManager"
                             FileObjects="FileObjects"
                             OnFilesChanged="OnFilesChanged" />
            </MudPaper>

            @* Controls  *@
            <MudPaper Class="d-flex align-end pa-4">
                <MudButton Color="Color.Primary"
                           Disabled="@(!FileObjects.Any() || uploadedSuccessfully)"
                           OnClick="@SubmitDataAsync"
                           Variant="Variant.Filled"
                           Size="Size.Small"
                           FullWidth="false">
                    Upload
                </MudButton>
            </MudPaper>

        </MudPaper>
    </MudItem>
    @* File drop zone  *@
    <MudItem xs="12">
        <MudPaper Class="d-flex flex-column" Width="100%">
            @* File Cards Section *@
            <FileCards @ref="componentFileCards"
                       FileObjects="FileObjects"
                       OnRemoveFile="HandleFileRemoval" />
        </MudPaper>
    </MudItem>
</MudGrid>


@code {

    // Reference to the FileManager component
    FileManager? componentFileManager;
    FileCards? componentFileCards;
    List<FileObjectUx> FileObjects { get; set; } = new List<FileObjectUx>();
    bool uploadedSuccessfully = false;

    // Form values
    string? customerValue { get; set; }
    string? customerProjectValue { get; set; }  // Keep for backward compatibility with validation
    ProjectAssociationUx? selectedProject { get; set; }  // NEW: Holds the selected project object
    string? reasonValue { get; set; }
    string? projectValue { get; set; }
    string? quotationValue { get; set; }
    int vehicleVolume { get; set; }

    DateTime? date = DateTime.Today;

    const string DefaultDragClass = "relative rounded-lg border-2 border-dashed pa-4 mt-4 mud-width-full mud-height-full";
    string _dragClass = DefaultDragClass;

    [Parameter] public Guid? UserId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (UserId == null || UserId == Guid.Empty)
        {
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add("UserId is missing in the URL", Severity.Error);
            Logger.GenericLogInformation("CreateRfq.OnInitializedAsync - UserId is missing in the URL");
            return;
        }

        if (RfqUxClientService.Customers.Count == 0)
        {
            Func<Guid, Task<int>> guidAsyncService = RfqUxClientService.GetCustomersByUserIdAsync;
            (long timing, int count) = await guidAsyncService.TimeAsyncGuidIntService((Guid)UserId);
            Logger.GenericLogInformation($"CreateRfq.OnInitializedAsync - Loaded {count} customers for UserId {UserId} in {timing}ms");
        }

        if (RfqUxClientService.Reasons.Count == 0)
        {
            Func<Task<int>> guidAsyncService = RfqUxClientService.GetRfqReasonsAsync;
            (long timing, int count) = await guidAsyncService.TimeAsyncVoidIntService();
            Logger.GenericLogInformation($"CreateRfq.OnInitializedAsync - Loaded {count} reasons in {timing}ms");
        }
    }

    // Control generated events - only call StateHasChanged() from events (i.e. methods starting with On....)
    #region Customer

    async Task OnCustomerValueChanged(string value)
    {
        customerValue = value;

        var customer = RfqUxClientService.Customers.FirstOrDefault(c => c?.CustomerBusinessGroupName == value);
        Logger.GenericLogInformation($"CreateRfq.OnCustomerValueChanged - Customer changed to {customer?.Id} - {customer?.CustomerBusinessGroupName}");

        // Clear selected project when customer changes
        selectedProject = null;
        customerProjectValue = null;

        try
        {
            await GetProjectAssociationsByCustomerName(value);
        }
        catch (Exception ex)
        {
            Logger.GenericLogError($"CreateRfq.OnCustomerValueChanged - Failed to load customer projects for customer '{customerValue}'", ex);
        }
        StateHasChanged();
    }

    async Task GetProjectAssociationsByCustomerName(string customerName)
    {
        if (!string.IsNullOrWhiteSpace(customerValue))
        {
            CustomerUx? customer = RfqUxClientService.Customers.FirstOrDefault(c => c?.CustomerBusinessGroupName == customerName);

            if (customer != null && Guid.TryParse(customer.Id, out Guid customerId))
            {
                await RfqUxClientService.GetProjectAssociationsByCustomerIdAsync(customerId.ToString());
                StateHasChanged();
            }
            else
            {
                Logger.GenericLogInformation($"CreateRfq.GetProjectAssociationsByCustomerName - Customer not found or invalid ID for '{customerName}'");
            }
        }
    }
    #endregion

    #region Reason
    private async Task OnReasonValueChanged(string value)
    {
        reasonValue = value;
        await Task.Delay(0);

        var reason = RfqUxClientService.Reasons.FirstOrDefault(r => r.RfqReasonTitle == value);
        Logger.GenericLogInformation($"CreateRfq.OnReasonValueChanged - Reason changed to {reason?.RowId} - {reason?.RfqReasonTitle}");

        StateHasChanged();
    }
    #endregion

    #region Project Autocomplete

    // Add CancellationToken parameter to match MudAutocomplete's delegate signature
    private async Task<IEnumerable<ProjectAssociationUx>> SearchProjects(string searchText, CancellationToken cancellationToken)
    {
        await Task.Delay(0, cancellationToken); // Keep async signature and respect cancellation

        // If no search text, return all projects
        if (string.IsNullOrWhiteSpace(searchText))
        {
            return RfqUxClientService.CustomerProjectAssociations;
        }

        // Search across project name, customer name, and location name
        return RfqUxClientService.CustomerProjectAssociations
            .Where(p =>
                (p.ProjectName?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (p.CustomerName?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false))
            .OrderBy(p => p.ProjectName)
            .ThenBy(p => p.CustomerName);
    }

    #endregion

    private async Task SubmitDataAsync()
    {
        // Create a progress state object that will be shared with the dialog
        var progressState = new SubmissionProgressState();

        // Set up navigation callback for successful completion
        progressState.OnSuccessCallback = () =>
        {
            try
            {
                Logger.GenericLogInformation("CreateRfq.SubmitDataAsync - Navigating to dashboard after successful RFQ submission");
                NavigationManager.NavigateTo("/");
            }
            catch (Exception ex)
            {
                Logger.GenericLogError("CreateRfq.SubmitDataAsync - Error navigating to dashboard", ex);
                Snackbar.Add("Navigation error occurred. Please manually navigate to the dashboard.", Severity.Warning);
            }
        };

        // Initialize progress dialog
        var parameters = new DialogParameters<SubmissionProgressDialog>
        {
            { x => x.ProgressState, progressState }
        };

        var options = new DialogOptions()
        {
            CloseButton = false,
            BackdropClick = false,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<SubmissionProgressDialog>("Processing RFQ", parameters, options);

        try
        {
            // Checkpoint 1: Validation
            progressState.UpdateProgress("Validating form data...", 0);
            progressState.SetCheckpointActive(0);

            await Task.Delay(500); // Small delay for UX

            // UPDATED: Use selectedProject instead of customerProjectValue for validation
            if (string.IsNullOrWhiteSpace(customerValue)
            || selectedProject == null  // Changed validation
            || string.IsNullOrWhiteSpace(reasonValue)
            || string.IsNullOrWhiteSpace(quotationValue)
            || vehicleVolume <= 0 || !date.HasValue)
            {
                progressState.SetError("Validation failed: Missing required fields", "Please fill in all required fields.");
                Logger.GenericLogInformation("CreateRfq.SubmitDataAsync - Validation failed: Missing required fields");
                return;
            }

            CustomerUx? customer = RfqUxClientService.Customers.FirstOrDefault(c => c?.CustomerBusinessGroupName == customerValue);
            if (customer is null)
            {
                progressState.SetError("Validation failed: Customer not found", "Selected customer not found.");
                Logger.GenericLogInformation("CreateRfq.SubmitDataAsync - Validation failed: Customer not found");
                return;
            }

            // UPDATED: Use selectedProject directly (already validated above)
            ProjectAssociationUx customerProject = selectedProject;

            RfqModule.RfqReasonGrpc? reason = RfqUxClientService.Reasons.FirstOrDefault(r => r.RfqReasonTitle == reasonValue);
            if (reason is null)
            {
                progressState.SetError("Validation failed: Reason not found", "Selected reason not found.");
                Logger.GenericLogInformation("CreateRfq.SubmitDataAsync - Validation failed: Reason not found");
                return;
            }

            if (FileObjects.Count <= 0 || !FileObjects.Any(f => f.Status != UxObjectStatus.Deleted && f.IsFileValid))
            {
                progressState.SetError("Validation failed: No valid files", "Please upload at least one valid file.");
                Logger.GenericLogInformation("CreateRfq.SubmitDataAsync - Validation failed: No valid files");
                return;
            }

            progressState.SetCheckpointCompleted(0, "All validations passed");
            Logger.GenericLogInformation($"CreateRfq.SubmitDataAsync - Checkpoint: Validations OK");

            // Checkpoint 2: Create RFQ Project
            progressState.UpdateProgress("Creating RFQ project...", 1);
            progressState.SetCheckpointActive(1);

            RfqProject requestProject = new RfqProject();
            requestProject.CustomerBusinessUnitGuid = customer.Id;
            requestProject.CustomerLocationGuid = customerProject.CustomerId;
            requestProject.ProjectGuid = customerProject.ProjectId;
            requestProject.RfqReasonId = reason.RowId ?? 0;
            requestProject.VehicleVolume = vehicleVolume;
            requestProject.RfqResponseDeadline = Timestamp.FromDateTime(date.Value.ToUniversalTime());

            CreateRfqProjectGrpcResponse response = await RfqUxClientService.CreateRfqProjectAsync(requestProject);

            if (response == null)
            {
                progressState.SetError("Failed to create project", "Failed to create project. Response is null.");
                Logger.GenericLogInformation("CreateRfq.SubmitDataAsync - Failed to create project. Response is null.");
                return;
            }
            else if (response.Success == false)
            {
                progressState.SetError("Failed to create project", $"Failed to create project. {response.Message}");
                Logger.GenericLogInformation($"CreateRfq.SubmitDataAsync - Failed to create project. {response.Message}");
                return;
            }

            progressState.SetCheckpointCompleted(1, $"Project created: {response.CreatedProjectId}");
            Logger.GenericLogInformation($"CreateRfq.SubmitDataAsync - Checkpoint: RFQ created with ID {response.CreatedProjectId}");

            // Checkpoint 3: Upload Files
            progressState.UpdateProgress("Uploading files...", 2);
            progressState.SetCheckpointActive(2);

            bool allOk = true;
            int fileCount = 0;
            int skippedCount = 0;
            var validFiles = FileObjects.Where(f => f.Status != UxObjectStatus.Deleted && f.IsFileValid).ToList();
            int totalFiles = validFiles.Count;

            foreach (FileObjectUx fileObject in validFiles)
            {
                try
                {
                    if (fileObject.File == null || !fileObject.IsFileValid)
                    {
                        skippedCount++;
                        Logger.GenericLogInformation($"CreateRfq.SubmitDataAsync - Skipping invalid file: {fileObject.DisplayName}");
                        continue;
                    }

                    fileCount++;
                    progressState.UpdateProgress($"Uploading file {fileCount} of {totalFiles}: {fileObject.File.Name}", 2);

                    UploadPartsRequestGrpcResponse uploadFileResponse = await RfqUxClientService.UploadPartsAsync(response.CreatedProjectId, fileObject.File, 16_000_000);
                    fileObject.UploadStatus = new FileObjectUploadStatus(uploadFileResponse);
                    allOk = allOk && uploadFileResponse.Success;

                    Logger.GenericLogInformation($"CreateRfq.SubmitDataAsync - Uploaded file {fileObject.File.Name}/{fileObject.File.Size}, {fileObject.UploadStatus.Status}/{fileObject.UploadStatus.Message}");
                }
                catch (Exception fileEx)
                {
                    Logger.GenericLogError($"CreateRfq.SubmitDataAsync - Error uploading file {fileObject.DisplayName}", fileEx);
                    fileObject.UploadStatus = new FileObjectUploadStatus
                    {
                        Status = FileUploadStatus.Failed,
                        Message = $"Upload error: {fileEx.Message}"
                    };
                    allOk = false;
                }
            }

            string uploadSummary = skippedCount > 0
                ? $"Uploaded {fileCount} files, skipped {skippedCount} invalid files"
                : $"Uploaded {fileCount} files";

            progressState.SetCheckpointCompleted(2, uploadSummary);
            Logger.GenericLogInformation($"CreateRfq.SubmitDataAsync - Checkpoint: {uploadSummary}");

            // Checkpoint 4: Finalize
            progressState.UpdateProgress("Finalizing submission...", 3);
            progressState.SetCheckpointActive(3);

            await Task.Delay(500); // Small delay for UX

            uploadedSuccessfully = allOk;
            progressState.SetCheckpointCompleted(3, "Submission completed");
            Logger.GenericLogInformation($"CreateRfq.SubmitDataAsync - Checkpoint: Submission finalized, success: {allOk}");

            // Final update
            progressState.SetCompleted(allOk ? "RFQ submission completed successfully!" : "RFQ submission completed with some errors", !allOk);

            StateHasChanged();

            if (allOk)
            {
                Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
                Snackbar.Add("RFQ submitted successfully!", Severity.Success);
            }
            else
            {
                Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
                Snackbar.Add("RFQ submitted with some file upload errors. Please check the file status.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Logger.GenericLogError("CreateRfq.SubmitDataAsync - Unexpected error during submission", ex);
            progressState.SetError("An unexpected error occurred", $"Error: {ex.Message}", isCompleted: true);
        }
    }

    private void SetDragClass()
        => _dragClass = $"{DefaultDragClass} mud-border-primary";

    private void ClearDragClass()
        => _dragClass = DefaultDragClass;

    private void OnQuotationValueChanged(string value)
    {
        quotationValue = value;

        var quotation = RfqUxClientService.Reasons.FirstOrDefault(r => r.RfqReasonTitle == value);
        Logger.GenericLogInformation($"Quotation changed to {quotation?.RowId} - {value}");

        StateHasChanged();
    }

    // REMOVED: OnCustomerProjectValueChanged is no longer needed
    // The selectedProject binding handles this automatically

    private void OnFilesChanged()
    {
        StateHasChanged();
    }

    private async Task HandleFileRemoval(FileObjectUx fileObject)
    {
        try
        {
            Logger.GenericLogInformation($"CreateRfq.HandleFileRemoval - Starting removal for file: {fileObject.DisplayName} (ID: {fileObject.Id})");

            // Check if file can be safely removed
            if (fileObject.CanBeRemovedSafely)
            {
                // Remove completely from collection to prevent InputFile issues
                bool removed = FileObjects.Remove(fileObject);

                if (removed)
                {
                    // Reset the FileManager's InputFile component to clear internal state
                    if (componentFileManager != null)
                    {
                        await componentFileManager.ResetInputFileAsync();
                    }

                    Logger.GenericLogInformation($"CreateRfq.HandleFileRemoval - Completely removed file: {fileObject.DisplayName}");
                    Snackbar.Add($"File '{fileObject.DisplayName}' removed successfully", Severity.Success);
                }
                else
                {
                    Logger.GenericLogInformation($"CreateRfq.HandleFileRemoval - File not found in collection: {fileObject.DisplayName}");
                }
            }
            else
            {
                // Keep in collection but mark as deleted for uploaded files
                fileObject.Status = UxObjectStatus.Deleted;
                Logger.GenericLogInformation($"CreateRfq.HandleFileRemoval - Marked uploaded file as deleted: {fileObject.DisplayName}");
                Snackbar.Add($"File '{fileObject.DisplayName}' marked as deleted", Severity.Info);
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.GenericLogError($"CreateRfq.HandleFileRemoval - Error removing file: {fileObject.DisplayName}", ex);
            Snackbar.Add($"Error removing file: {ex.Message}", Severity.Error);
        }
    }

}