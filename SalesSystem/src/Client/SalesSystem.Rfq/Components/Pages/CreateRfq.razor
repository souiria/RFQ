    //     {

    //         List<CustomerProjectUx> responseAssociations = await rfqUxService.GetCustomerProjectUx(projects, locations, customerProjectAssociations);
    //         customerProjectAssociations.Clear();
    //         customerProjectAssociations.AddRange(responseAssociations);
    //         StateHasChanged();
    //     }

