@page "/createRfq"
@page "/createRfq/{UserId:guid}"
@inject ISnackbar Snackbar
@inject RfqUxService RfqUxService
@rendermode InteractiveServer
@using SalesSystem.Rfq.Components.Pages.Dialogs
@using SalesSystem.Rfq.Extensions

<style>
    .file-upload-input {
        position: absolute;
        width: 100%;
        height: 100%;
        overflow: hidden;
        z-index: 10;
        opacity: 0;
    }
</style>

<MudText Typo="Typo.h5" Class="mb-auto" Align="Align.Center">Create RFI/RFQ</MudText>
<MudGrid Class="position-fixed">
    <MudItem xs="12">
            <MudPaper Elevation="25" Class="d-flex flex-row" Style="height:150px;">
                <MudPaper Elevation="0" Class="pa-4">
                <MudStack>
                    <MudSelect T="string"
                               Value="customerValue"
                               For="@(() => customerValue)"
                               ValueChanged="OnCustomerValueChanged"
                               Label="Customer" 
                               Placeholder="Please Select"
                               AdornmentIcon="@Icons.Material.Filled.People" 
                               AdornmentColor="Color.Primary">
                        @foreach(var customer in RfqUxService.Customers)
                        {
                            <MudSelectItem Value="@customer.CustomerBusinessGroupName">@customer.CustomerBusinessGroupName</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect T="string"
                               Value="reasonValue" 
                               For="@(() => reasonValue)"
                               ValueChanged="OnReasonValueChanged"
                               Label="Reason" 
                               Placeholder="Please Select"
                               AdornmentIcon="@Icons.Material.Filled.Checklist" AdornmentColor="Color.Primary">
                        @foreach (var reason in RfqUxService.Reasons)
                        {
                            <MudSelectItem Value="@reason.RfqReasonTitle">@reason.RfqReasonTitle</MudSelectItem>
                        }
                    </MudSelect>
                </MudStack>
        </MudPaper>

            <MudPaper Elevation="0" Class="pa-4">
                <MudStack>
                    <MudSelect T="string"
                               Value="customerProjectValue"
                               For="@(() => customerProjectValue)"
                               ValueChanged="OnCustomerProjectValueChanged"
                               Label="Project" 
                               Placeholder="Please Select"
                               AdornmentIcon="@Icons.Material.Filled.Settings" 
                               AdornmentColor="Color.Primary">
                        @foreach (var association in RfqUxService.CustomerProjectAssociations)
                        {
                            <MudSelectItem Value="@association.Id">@association.ProjectName - @association.CustomerName</MudSelectItem>
                        }
                    </MudSelect>
                    <MudNumericField @bind-Value="vehicleVolume" Label="Vehicle Volume" Variant="Variant.Text" Min="0" />
                </MudStack>
            </MudPaper>
            <MudPaper Elevation="0" Class="pa-4">
                <MudStack>
                    <MudSelect T="string"
                               Value="quotationValue" 
                               For="@(() => quotationValue)"
                               ValueChanged="OnQuotationValueChanged"
                               Label="Quotation Number" 
                               Placeholder="Please Select"
                               AdornmentIcon="@Icons.Material.Filled.People" AdornmentColor="Color.Primary">
                        <MudSelectItem Value="@("SEWS-25-025-005678")">SEWS-25-025-005678</MudSelectItem>
                        <MudSelectItem Value="@("SEWS-25-025-005688")">SEWS-25-025-005688</MudSelectItem>
                        <MudSelectItem Value="@("SEWS-25-025-005692")">SEWS-25-025-005692</MudSelectItem>
                    </MudSelect>
                    <MudDatePicker Label="Date Format" @bind-Date="_date" DateFormat="dd.MM.yyyy" />
                    
                </MudStack>
            </MudPaper>

            <MudPaper Elevation="0" Class="pa-4">
                <MudStack>
                    <FileManager @ref="componentFileManager"
                        Files="_files"
                        OnFilesChanged="OnFilesChanged" />
                </MudStack>
            </MudPaper>

            <MudPaper Elevation="0" Class="pa-4" MinWidth="20%">
                <MudStack>
                        <MudToolBar Gutters="@false"
                                    Class="relative d-flex justify-end gap-4">
                            <MudButton Color="Color.Primary"
                                       Disabled="@(!_files.Any())"  
                                       OnClick="@SubmitDataAsync"
                                       Variant="Variant.Filled">
                                Upload
                            </MudButton>
                        </MudToolBar>
                </MudStack>
            </MudPaper>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" Style="height: calc(100vh - 280px);">
        <MudPaper Elevation="25" Class="d-flex flex-row" Style="height: calc(100vh - 280px);">
            <MudDataGrid T="RfqItemUx" Items="@rfqItems" SortMode="SortMode.Multiple" Filterable="true" QuickFilter="@_quickFilter"
                         Hideable="true" Dense="true" Height="500px" FixedFooter="true">
                <ToolBarContent>
                    <MudText Typo="Typo.h6">Rfq Information</MudText>
                    <MudSpacer />
                    <MudTextField @bind-Value="_searchString" Placeholder="Search" Adornment="Adornment.Start" Immediate="true"
                                  AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
                </ToolBarContent>
                <Columns>
                    <TemplateColumn Title="Part Number" CellStyleFunc="@_cellStyleFunc" Sortable="true" SortBy="@(x => x.SampleColumn1)">
                        <CellTemplate>
                            <MudIcon Icon="@_iconString" Color="Color.Inherit" Title="@_status" /> @context.Item.SampleColumn1
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="SampleColumn2" Sortable="true" Filterable="true" SortBy="@(x => x.SampleColumn2)">
                        <CellTemplate>
                            <MudText Style="font-size:inherit">
                                <MudHighlighter Text="@context.Item.SampleColumn2" HighlightedText="@_searchString" /> @context.Item.SampleColumn2
                            </MudText>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="SampleColumn3" Sortable="true" Filterable="true" SortBy="@(x => x.SampleColumn3)">
                        <CellTemplate>
                            <MudText Style="font-size:inherit">
                                <MudHighlighter Text="@context.Item.SampleColumn3" HighlightedText="@_searchString" /> @context.Item.SampleColumn3
                            </MudText>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="SampleColumn4" Sortable="true" Filterable="true" SortBy="@(x => x.SampleColumn4)">
                        <CellTemplate>
                            <MudText Style="font-size:inherit">
                                <MudHighlighter Text="@context.Item.SampleColumn4" HighlightedText="@_searchString" /> @context.Item.SampleColumn4
                            </MudText>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="SampleColumn5" Sortable="true" Filterable="true" SortBy="@(x => x.SampleColumn5)">
                        <CellTemplate>
                            <MudText Style="font-size:inherit">
                                <MudHighlighter Text="@context.Item.SampleColumn5" HighlightedText="@_searchString" /> @context.Item.SampleColumn5
                            </MudText>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="SampleColumn6" Sortable="true" Filterable="true" SortBy="@(x => x.SampleColumn6)">
                        <CellTemplate>
                            <MudText Style="font-size:inherit">
                                <MudHighlighter Text="@context.Item.SampleColumn6" HighlightedText="@_searchString" /> @context.Item.SampleColumn6
                            </MudText>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="SampleColumn7" Sortable="true" Filterable="true" SortBy="@(x => x.SampleColumn7)">
                        <CellTemplate>
                            <MudText Style="font-size:inherit">
                                <MudHighlighter Text="@context.Item.SampleColumn7" HighlightedText="@_searchString" /> @context.Item.SampleColumn7
                            </MudText>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="SampleColumn8" Sortable="true" Filterable="true" SortBy="@(x => x.SampleColumn8)">
                        <CellTemplate>
                            <MudText Style="font-size:inherit">
                                <MudHighlighter Text="@context.Item.SampleColumn9" HighlightedText="@_searchString" /> @context.Item.SampleColumn8
                            </MudText>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="SampleColumn10" Sortable="true" Filterable="true" SortBy="@(x => x.SampleColumn10)">
                        <CellTemplate>
                            <MudText Style="font-size:inherit">
                                <MudHighlighter Text="@context.Item.SampleColumn10" HighlightedText="@_searchString" /> @context.Item.SampleColumn10
                            </MudText>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>

            </MudDataGrid>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {

    // Reference to the FileManager component
    FileManager? componentFileManager;
    List<IBrowserFile> _files { get; set; } = new List<IBrowserFile>();

    // Form values
    string? customerValue { get; set; }
    string? customerProjectValue { get; set; }
    string? reasonValue { get; set; }
    string? projectValue { get; set; }
    string? quotationValue { get; set; }
    int vehicleVolume { get; set; }

    DateTime? _date = DateTime.Today;

    const string DefaultDragClass = "relative rounded-lg border-2 border-dashed pa-4 mt-4 mud-width-full mud-height-full";
    string _dragClass = DefaultDragClass;

    // rfq items grid
    List<RfqItemUx> rfqItems = new List<RfqItemUx>();
    string _searchString = string.Empty;
    string _iconString = string.Empty;
    string _status = string.Empty;

    [Parameter] public Guid? UserId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (UserId == null || UserId == Guid.Empty)
        {
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add("UserId is missing in the URL", Severity.Error);
            return;
        }

        if(RfqUxService.Customers.Count == 0)
        {
            Func<Guid, Task<int>> guidAsyncService = RfqUxService.GetCustomersAsync;
            (long timing, int count) = await guidAsyncService.TimeAsyncGuidIntService((Guid)UserId);

            Snackbar.Add($"{count} customers loaded, load time is {timing}ms @{DateTime.UtcNow}", Severity.Success);
        }

        if (RfqUxService.Reasons.Count == 0)
        {
            Func<Task<int>> guidAsyncService = RfqUxService.GetReasonsAsync;
            (long timing, int count) = await guidAsyncService.TimeAsyncVoidIntService();

            Snackbar.Add($"{count} reasons loaded, load time is {timing}ms @{DateTime.UtcNow}", Severity.Success);
        }
    }

    // Control generated events - only call StateHasChanged() from events (i.e. methods starting with On....)
    #region Customer

    async Task OnCustomerValueChanged(string value)
    {
        Snackbar.Add($"Customer changed to {value}", Severity.Info);
        customerValue = value;

        try
        {
            await GetProjectAssociationsByCustomerName(value);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load customer projects for customer '{customerValue}': {ex.Message}", Severity.Error, config => { config.VisibleStateDuration = 10000; });
        }
        StateHasChanged();
    }

    async Task GetProjectAssociationsByCustomerName(string customerName)
    {
        if (!string.IsNullOrWhiteSpace(customerValue))
        {
            RfqModule.CustomerGrpc? customer = RfqUxService.Customers.FirstOrDefault(c => c.CustomerBusinessGroupName == customerName);

            if (customer != null)
            {
                await RfqUxService.GetProjectAssociationsByCustomerId(customer.Id);
                StateHasChanged();
            }
        }
    }
    #endregion

    #region Reason
    private async Task OnReasonValueChanged(string value)
    {
        reasonValue = value;
        await Task.Delay(0);

        StateHasChanged();
    }
    #endregion

    private void Upload()
    {
        // Upload the files here
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
        Snackbar.Add("TODO: Upload your files!");
    }

    private async Task SubmitDataAsync()
    {
        await Task.Delay(0);
        if (string.IsNullOrWhiteSpace(customerValue)
        || string.IsNullOrWhiteSpace(customerProjectValue)
        || string.IsNullOrWhiteSpace(reasonValue)
        || string.IsNullOrWhiteSpace(quotationValue)
        || vehicleVolume <= 0 || !_date.HasValue)
        {
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add("Please fill in all required fields.", Severity.Error);
            return;
        }

        RfqModule.CustomerGrpc? customer = RfqUxService.Customers.FirstOrDefault(c => c.CustomerBusinessGroupName == customerValue);
        if (customer is null)
        {
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add("Selected customer not found.", Severity.Error);
            return;
        }
        CustomerProjectUx? customerProject = RfqUxService.CustomerProjectAssociations.FirstOrDefault(p => p.Id == customerProjectValue);
        if (customerProject is null)
        {
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add("Selected customer project not found.", Severity.Error);
            return;
        }
        RfqModule.RfqReasonGrpc? reason = RfqUxService.Reasons.FirstOrDefault(r => r.RfqReasonTitle == reasonValue);
        if (reason is null)
        {
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add("Selected reason not found.", Severity.Error);
            return;
        }

        if (0 >= _files.Count)
        {
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add("Please upload at least one file.", Severity.Error);
            return;
        }

        CreateRfqProjectGrpcResponse response = await RfqUxService.CreateRfqProject(
            customer,
            customerProject,
            reason,
            vehicleVolume,
            _date.Value
        );
        bool createdFile = false;
        if (!response.Success)
        {
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add("Failed to create project.", Severity.Error);
            return;
        }
        foreach(var file in _files)
        {
            createdFile = await RfqUxService.UploadPartsAsync(response.CreatedProjectId, file);
        }

        rfqItems.Clear();
        StateHasChanged();
        // create project
        // upload files
        // get rfq items

    }

    private void SetDragClass()
        => _dragClass = $"{DefaultDragClass} mud-border-primary";

    private void ClearDragClass()
        => _dragClass = DefaultDragClass;

    private Func<RfqItemUx, bool> _quickFilter => x =>
    {
        if (string.IsNullOrWhiteSpace(_searchString))
            return true;

        if (x.SampleColumn1!.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        if (x.SampleColumn2!.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        if (x.SampleColumn3!.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        if (x.SampleColumn4!.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        if (x.SampleColumn5!.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        if (x.SampleColumn6!.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        if (x.SampleColumn7!.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        if (x.SampleColumn8!.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        if (x.SampleColumn9!.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        if (x.SampleColumn10!.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        // if (x.PercentComplete.ToString().Contains(_searchString, StringComparison.OrdinalIgnoreCase))
        //     return true;

        return false;
    };

    private Func<RfqItemUx, string> _cellStyleFunc => x =>
    {
        string style = "";

        switch (x.SampleColumn1)
        {
            case "":
                style += "color:#E5BDE5";
                _iconString = Icons.Material.Filled.Airlines;
                _status = "Airlines";
                break;
            default:
                break;
        }

        return style;
    };
    private void OnQuotationValueChanged(string value)
    {
        quotationValue = value;
        StateHasChanged();
    }
    private void OnCustomerProjectValueChanged(string value)
    {
        customerProjectValue = value;
        StateHasChanged();
    }
    private void OnFilesChanged()
    {
        StateHasChanged();
    }
}
