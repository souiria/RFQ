@page "/createRfq"
@page "/createRfq/{UserId:guid}"
@inject ISnackbar Snackbar
@inject RfqUxService rfqUxService
@rendermode InteractiveServer
@using SalesSystem.Rfq.Extensions

<style>
    .file-upload-input {
        position: absolute;
        width: 100%;
        height: 100%;
        overflow: hidden;
        z-index: 10;
        opacity: 0;
    }
</style>

<MudText Typo="Typo.h5" Class="mb-auto" Align="Align.Center">Create RFI/RFQ</MudText>
<MudGrid Class="position-fixed">
    <MudItem xs="12">
            <MudPaper Elevation="25" Class="d-flex flex-row" Style="height:150px;">
                <MudPaper Elevation="0" Class="pa-4">
                <MudStack>
                    <MudSelect T="string"
                               Value="customerValue"
                               For="@(() => customerValue)"
                               ValueChanged="OnCustomerValueChanged"
                               Label="Customer" 
                               Placeholder="Please Select"
                               AdornmentIcon="@Icons.Material.Filled.People" 
                               AdornmentColor="Color.Primary">
                        @foreach(var customer in customers)
                        {
                            <MudSelectItem Value="@customer.CustomerBusinessGroupName">@customer.CustomerBusinessGroupName</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect T="string"
                               Value="reasonValue" 
                               For="@(() => reasonValue)"
                               ValueChanged="OnReasonValueChanged"
                               Label="Reason" 
                               Placeholder="Please Select"
                               AdornmentIcon="@Icons.Material.Filled.Checklist" AdornmentColor="Color.Primary">
                        @foreach (var reason in reasons)
                        {
                            <MudSelectItem Value="@reason.RfqReasonTitle">@reason.RfqReasonTitle</MudSelectItem>
                        }
                        @* <MudSelectItem Value="@("Nominated Business")" Disabled="true">Nominated Business</MudSelectItem>
                        <MudSelectItem Value="@("Potential New Business")">Potential New Business</MudSelectItem> *@
                    </MudSelect>
                </MudStack>
        </MudPaper>

            <MudPaper Elevation="0" Class="pa-4">
                <MudStack>
                    <MudSelect T="string"
                               Value="customerProjectValue"
                               For="@(() => customerProjectValue)"
                               ValueChanged="OnCustomerProjectValueChanged"
                               Label="Project" 
                               Placeholder="Please Select"
                               AdornmentIcon="@Icons.Material.Filled.Settings" 
                               AdornmentColor="Color.Primary">
                        @foreach (var association in customerProjectAssociations)
                        {
                            <MudSelectItem Value="@association.Id">@association.ProjectName - @association.CustomerName</MudSelectItem>
                        }
                    </MudSelect>
                    <MudNumericField @bind-Value="vehicleVolume" Label="Vehicle Volume" Variant="Variant.Text" Min="0" />
                </MudStack>
            </MudPaper>
            <MudPaper Elevation="0" Class="pa-4">
                <MudStack>
                    <MudSelect T="string"
                               Value="quotationValue" 
                               For="@(() => quotationValue)"
                               ValueChanged="OnQuotationValueChanged"
                               Label="Quotation Number" 
                               Placeholder="Please Select"
                               AdornmentIcon="@Icons.Material.Filled.People" AdornmentColor="Color.Primary">
                        <MudSelectItem Value="@("SEWS-25-025-005678")">SEWS-25-025-005678</MudSelectItem>
                        <MudSelectItem Value="@("SEWS-25-025-005688")">SEWS-25-025-005688</MudSelectItem>
                        <MudSelectItem Value="@("SEWS-25-025-005692")">SEWS-25-025-005692</MudSelectItem>
                    </MudSelect>
                    <MudDatePicker Label="Date Format" @bind-Date="_date" DateFormat="dd.MM.yyyy" />
                    
                </MudStack>
            </MudPaper>

            <MudPaper Elevation="0" Class="pa-4">
                <MudStack>
                    <MudFileUpload T="IBrowserFile"
                                   @ref="@_fileUpload"
                                   OnFilesChanged="OnInputFileChanged"
                                   Hidden="@false"
                                   InputClass="file-upload-input"
                                   tabindex="-1"
                                   @ondrop="@ClearDragClass"
                                   @ondragenter="@SetDragClass"
                                   @ondragleave="@ClearDragClass"
                                   @ondragend="@ClearDragClass">
                        <ActivatorContent>
                            <MudPaper Height="95"
                                      Outlined="true"
                                      Class="@_dragClass">
                                <MudText Typo="Typo.h6">
                                    Drag and drop files here or click
                                </MudText>
                                
                            </MudPaper>
                        </ActivatorContent>
                    </MudFileUpload>
                    
                </MudStack>
            </MudPaper>
            <MudPaper Elevation="0" Class="pa-4">
                <MudStack>
                <MudToolBar Gutters="@false"
                            Class="relative d-flex justify-end gap-4">
                    <MudButton Color="Color.Primary"
                               OnClick="@OpenFilePickerAsync"
                               Variant="Variant.Filled">
                        Open file picker
                    </MudButton>
                    <MudButton Color="Color.Error"
                               Disabled="@(!_fileNames.Any())"
                               OnClick="@ClearAsync"
                               Variant="Variant.Filled">
                        Clear
                    </MudButton>
                </MudToolBar>
                    @foreach (var file in _fileNames)
                    {
                        <MudChip T="string"
                                 Color="Color.Dark"
                                 Text="@file"
                                 tabindex="-1" />
                    }
                </MudStack>
            </MudPaper>
            <MudPaper Elevation="0" Class="pa-4" MinWidth="20%">
                <MudStack>
                        <MudToolBar Gutters="@false"
                                    Class="relative d-flex justify-end gap-4">
                            <MudButton Color="Color.Primary"
                                       Disabled="@(!_fileNames.Any())"  
                                       OnClick="@SubmitDataAsync"
                                       Variant="Variant.Filled">
                                Upload
                            </MudButton>
                        </MudToolBar>
                </MudStack>
            </MudPaper>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" Style="height: calc(100vh - 280px);">
        <MudPaper Elevation="25" Class="d-flex flex-row" Style="height: calc(100vh - 280px);">
            <MudDataGrid T="RfqItemUx" Items="@rfqItems" SortMode="SortMode.Multiple" Filterable="true" QuickFilter="@_quickFilter"
                         Hideable="true" Dense="true" Height="500px" FixedFooter="true">
                <ToolBarContent>
                    <MudText Typo="Typo.h6">Rfq Information</MudText>
                    <MudSpacer />
                    <MudTextField @bind-Value="_searchString" Placeholder="Search" Adornment="Adornment.Start" Immediate="true"
                                  AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
                </ToolBarContent>
                <Columns>
                    <TemplateColumn Title="Part Number" CellStyleFunc="@_cellStyleFunc" Sortable="true" SortBy="@(x => x.SampleColumn1)">
                        <CellTemplate>
                            <MudIcon Icon="@_iconString" Color="Color.Inherit" Title="@_status" />
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="SampleColumn2" Sortable="true" Filterable="true" SortBy="@(x => x.SampleColumn2)">
                        <CellTemplate>
                            <MudText Style="font-size:inherit">
                                <MudHighlighter Text="@context.Item.SampleColumn2" HighlightedText="@_searchString" />
                            </MudText>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="SampleColumn3" Sortable="true" Filterable="true" SortBy="@(x => x.SampleColumn3)">
                        <CellTemplate>
                            <MudText Style="font-size:inherit">
                                <MudHighlighter Text="@context.Item.SampleColumn3" HighlightedText="@_searchString" />
                            </MudText>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="SampleColumn4" Sortable="true" Filterable="true" SortBy="@(x => x.SampleColumn4)">
                        <CellTemplate>
                            <MudText Style="font-size:inherit">
                                <MudHighlighter Text="@context.Item.SampleColumn4" HighlightedText="@_searchString" />
                            </MudText>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="SampleColumn5" Sortable="true" Filterable="true" SortBy="@(x => x.SampleColumn5)">
                        <CellTemplate>
                            <MudText Style="font-size:inherit">
                                <MudHighlighter Text="@context.Item.SampleColumn5" HighlightedText="@_searchString" />
                            </MudText>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="SampleColumn6" Sortable="true" Filterable="true" SortBy="@(x => x.SampleColumn6)">
                        <CellTemplate>
                            <MudText Style="font-size:inherit">
                                <MudHighlighter Text="@context.Item.SampleColumn6" HighlightedText="@_searchString" />
                            </MudText>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="SampleColumn7" Sortable="true" Filterable="true" SortBy="@(x => x.SampleColumn7)">
                        <CellTemplate>
                            <MudText Style="font-size:inherit">
                                <MudHighlighter Text="@context.Item.SampleColumn7" HighlightedText="@_searchString" />
                            </MudText>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="SampleColumn8" Sortable="true" Filterable="true" SortBy="@(x => x.SampleColumn8)">
                        <CellTemplate>
                            <MudText Style="font-size:inherit">
                                <MudHighlighter Text="@context.Item.SampleColumn9" HighlightedText="@_searchString" />
                            </MudText>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="SampleColumn10" Sortable="true" Filterable="true" SortBy="@(x => x.SampleColumn10)">
                        <CellTemplate>
                            <MudText Style="font-size:inherit">
                                <MudHighlighter Text="@context.Item.SampleColumn10" HighlightedText="@_searchString" />
                            </MudText>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>

            </MudDataGrid>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    string? customerValue = "";

    private string? customerProjectValue { get; set; }
    private string? locationValue { get; set; }
    private string? reasonValue { get; set; }
    private string? projectValue { get; set; }
    private string? quotationValue { get; set; }
    private int vehicleVolume { get; set; }
    private List<RfqModule.CustomerGrpc> customers = new();
    private List<RfqModule.CustomerLocationGrpc> locations = new();
    private List<RfqModule.ProjectGrpc> projects = new();
    private List<RfqModule.RfqReasonGrpc> reasons = new();
    private List<CustomerProjectUx> customerProjectAssociations = new();
    private DateTime? _date = DateTime.Today;

    private const string DefaultDragClass = "relative rounded-lg border-2 border-dashed pa-4 mt-4 mud-width-full mud-height-full";
    private string _dragClass = DefaultDragClass;
    private readonly List<string> _fileNames = new();
    private MudFileUpload<IBrowserFile>? _fileUpload;

    List<RfqItemUx>? rfqItems = new List<RfqItemUx>();
    private string _searchString = string.Empty;
    private string _iconString = string.Empty;
    private string _status = string.Empty;
    
    [Parameter] public Guid? UserId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (UserId == null || UserId == Guid.Empty)
        {
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add("UserId is missing in the URL", Severity.Error);
            return;
        }

        if(customers.Count == 0)
        {
            Func<Guid, Task<List<RfqModule.CustomerGrpc>>> guidAsyncService = rfqUxService.GetCustomersAsync;
            long timing = 0;
            int count = 0;
            (timing, count, customers) = await guidAsyncService.TimeAsyncGuidService((Guid)UserId);

            Snackbar.Add($"Customer load time is ok {timing}ms @{DateTime.UtcNow}", Severity.Success);
        }
    }

    // Control generated events - only call StateHasChanged() from events (i.e. methods starting with On....)
    #region Customer

    async Task OnCustomerValueChanged(string value)
    {
        Snackbar.Add($"Customer changed to {value}", Severity.Info);
        customerValue = value;
        
        try
        {
            await GetLocations();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load locations for customer '{customerValue}': {ex.Message}", Severity.Error, config => { config.VisibleStateDuration = 10000; });
        }


        StateHasChanged();
    }

    private async Task GetLocations()
    {
        locations.Clear();
        locationValue = null;
        if (!string.IsNullOrWhiteSpace(customerValue))
        {
            RfqModule.CustomerGrpc? customer = customers.FirstOrDefault(c => c.CustomerBusinessGroupName == customerValue);

            if (customer != null)
            {
                List<RfqModule.CustomerLocationGrpc> response = new();

                Func<string, Task<List<RfqModule.CustomerLocationGrpc>>> stringAsyncService = rfqUxService.GetLocationsByCustomer;

                long timing = 0;
                int count = 0;
                (timing, count, response) = await stringAsyncService.TimeAsyncStringService(customer.Id);

                locations.AddRange(response);

                Snackbar.Add($"Loaded {count} locations for customer '{customer.CustomerBusinessGroupName}' in {timing}ms.", Severity.Info);

                try
                {
                    await GetCustomerProjectAssociations();
                }
                catch (Exception ex)
                {
                    Snackbar.Add($"Failed to load customer project associations for customer '{customerValue}': {ex.Message}", Severity.Error, config => { config.VisibleStateDuration = 10000; });
                }

            }
        }
    }

    private async Task GetCustomerProjectAssociations()
    {
        customerProjectAssociations.Clear();
        customerProjectValue = null;
        if (!string.IsNullOrWhiteSpace(customerValue))
        {
            RfqModule.CustomerGrpc? customer = customers.FirstOrDefault(c => c.CustomerBusinessGroupName == customerValue);
            if (customer != null)
            {
                List<CustomerProjectUx> response = new();

                Func<Task<List<CustomerProjectUx>>> asyncService = rfqUxService.GetCustomerProjectAssociations;

                long timing = 0;
                int count = 0;
                (timing, count, response) = await asyncService.TimeAsyncService();
                customerProjectAssociations.AddRange(response);

                Snackbar.Add($"Loaded {count} customer project associations for customer '{customer.CustomerBusinessGroupName}' in {timing}ms.", Severity.Info);

                try
                {
                    await GetProjects();
                }
                catch (Exception ex)
                {
                    Snackbar.Add($"Failed to load projects for customer '{customerValue}': {ex.Message}", Severity.Error, config => { config.VisibleStateDuration = 10000; });
                }

            }
        }
    }

    private async Task GetProjects()
    {
        projects.Clear();
        projectValue = null;
        if (0 < customerProjectAssociations.Count)
        {
            List<RfqModule.ProjectGrpc> response = new();

            Func<IList<CustomerProjectUx>, Task<List<RfqModule.ProjectGrpc>>> listAsyncService = rfqUxService.GetProjectsbyCustomerProjectAssociation;
            long timing = 0;
            int count = 0;
            (timing, count, response) = await listAsyncService.TimeAsyncListService(customerProjectAssociations);
            projects.AddRange(response);

            Snackbar.Add($"Loaded {count} projects for customer project associations in {timing}ms.", Severity.Info);

            try
            {
                await GetCustomerProjectAssociationsUx();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Failed to load project associations (ux) for customer '{customerValue}': {ex.Message}", Severity.Error, config => { config.VisibleStateDuration = 10000; });
            }

        }
    }

    private async Task GetCustomerProjectAssociationsUx()
    {
        customerProjectValue = null;
        if (!string.IsNullOrWhiteSpace(customerValue))
        {

            List<CustomerProjectUx> response = await rfqUxService.GetCustomerProjectUx(projects, locations, customerProjectAssociations);

            customerProjectAssociations.Clear();
            customerProjectAssociations.AddRange(response);

        }

    }
    #endregion

    #region Project
    private async Task OnCustomerProjectValueChanged(string value)
    {
        customerProjectValue = value;
        await Task.Delay(0);

        StateHasChanged();
    }
    #endregion

    #region Quotation
    private async Task OnQuotationValueChanged(string value)
    {
        quotationValue = value;
        await GetReasons();

        StateHasChanged();
    }

    public async Task GetReasons()
    {
        reasons.Clear();
        List<RfqModule.RfqReasonGrpc> responseRfqItems = await rfqUxService.GetReasons();
        reasons.AddRange(responseRfqItems);
    }
    #endregion

    #region Reason
    private async Task OnReasonValueChanged(string value)
    {
        reasonValue = value;
        await Task.Delay(0);

        StateHasChanged();
    }
    #endregion

    private async Task ClearAsync()
    {
        await (_fileUpload?.ClearAsync() ?? Task.CompletedTask);
        _fileNames.Clear();
        ClearDragClass();
    }

    private Task OpenFilePickerAsync()
        => _fileUpload?.OpenFilePickerAsync() ?? Task.CompletedTask;

    private void OnInputFileChanged(InputFileChangeEventArgs e)
    {
        ClearDragClass();
        var files = e.GetMultipleFiles();
        foreach (var file in files)
        {
            _fileNames.Add(file.Name);
        }
    }

    private void Upload()
    {
        // Upload the files here
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
        Snackbar.Add("TODO: Upload your files!");
    }

    private async Task SubmitDataAsync()
    {
        await Task.Delay(0);
        if (string.IsNullOrWhiteSpace(customerValue)
        || string.IsNullOrWhiteSpace(projectValue)
        || string.IsNullOrWhiteSpace(reasonValue)
        || string.IsNullOrWhiteSpace(quotationValue)
        || vehicleVolume <= 0 || !_date.HasValue)
        {
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add("Please fill in all required fields.", Severity.Error);
            return;
        }

        RfqModule.CustomerGrpc? customer = customers.FirstOrDefault(c => c.CustomerBusinessGroupName == customerValue);
        if (customer is null)
        {
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add("Selected customer not found.", Severity.Error);
            return;
        }
        CustomerProjectUx? customerProject = customerProjectAssociations.FirstOrDefault(p => p.Id == customerProjectValue);
        if (customerProject is null)
        {
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add("Selected customer not found.", Severity.Error);
            return;
        }
        RfqModule.ProjectGrpc? project = projects.FirstOrDefault(p => p.Id == customerProject.ProjectId);
        if (project is null)
        {
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add("Selected customer not found.", Severity.Error);
            return;
        }
        RfqModule.CustomerLocationGrpc? location = locations.FirstOrDefault(p => p.Id == customerProject.CustomerId);
        if (location is null)
        {
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add("Selected customer not found.", Severity.Error);
            return;
        }
        RfqModule.RfqReasonGrpc? reason = reasons.FirstOrDefault(r => r.RfqReasonTitle == reasonValue);
        if (reason is null)
        {
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add("Selected customer not found.", Severity.Error);
            return;
        }
        if(_fileUpload is null || _fileUpload.Files == null)
        {
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            Snackbar.Add("Please upload at least one file.", Severity.Error);
            return;
        }

        using var stream = _fileUpload.Files.OpenReadStream(10 * 1024 * 1024);
        using var memoryStream = new MemoryStream();
        await stream.CopyToAsync(memoryStream);
        byte[] fileContent = memoryStream.ToArray();

        string fileName = _fileUpload.Files.Name.First().ToString() ?? string.Empty;

        await rfqUxService.CreateRfqProject(
        // customer,
        // project,
        // location,
        // reason,
        // vehicleVolume,
        // _date.Value,
        // fileName,
        // fileContent
        );
        // create project
        // upload files
        // get rfq items

    }

    private void SetDragClass()
        => _dragClass = $"{DefaultDragClass} mud-border-primary";

    private void ClearDragClass()
        => _dragClass = DefaultDragClass;

    private Func<RfqItemUx, bool> _quickFilter => x =>
    {
        if (string.IsNullOrWhiteSpace(_searchString))
            return true;

        if (x.SampleColumn1!.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        if (x.SampleColumn2!.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        if (x.SampleColumn3!.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        if (x.SampleColumn4!.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        if (x.SampleColumn5!.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        if (x.SampleColumn6!.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        if (x.SampleColumn7!.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        if (x.SampleColumn8!.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        if (x.SampleColumn9!.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        if (x.SampleColumn10!.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        // if (x.PercentComplete.ToString().Contains(_searchString, StringComparison.OrdinalIgnoreCase))
        //     return true;

        return false;
    };

    private Func<RfqItemUx, string> _cellStyleFunc => x =>
    {
        string style = "";

        switch (x.SampleColumn1)
        {
            case "":
                style += "color:#E5BDE5";
                _iconString = Icons.Material.Filled.Airlines;
                _status = "Airlines";
                break;
            default:
                break;
        }

        return style;
    };

}
