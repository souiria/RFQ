@page "/createRfq"
@rendermode InteractiveServer
@using System.Linq
@using SalesSystem.Rfq.Components.Pages.Components
@using SalesSystem.Rfq.ViewModels

@inherits MvvmComponentBase<CreateRfqViewModel>

<MudText Typo="Typo.h5" Class="mb-auto" Align="Align.Center">Create RFI/RFQ</MudText>
<MudGrid Class="position-fixed">
    @* Attributes *@
    <MudItem xs="12">
        <MudPaper Class="d-flex flex-row" Style="height:150px;">
            @* Column 1: Customer + Reason (25%) *@
            <MudPaper Class="pa-4" Style="flex: 0 0 25%; max-width:25%; min-width: 25%;">
                <MudStack>
                    <MudSelect T="string"
                               Value="ViewModel.CustomerValue"
                               For="@(() => ViewModel.CustomerValue)"
                               ValueChanged="ViewModel.OnCustomerValueChangedAsync"
                               Label="Customer"
                               Placeholder="Please Select"
                               AdornmentIcon="@Icons.Material.Filled.People"
                               Disabled="ViewModel.UploadedSuccessfully"
                               AdornmentColor="Color.Primary">
                        @foreach (var customer in ViewModel.Customers)
                        {
                            <MudSelectItem T="string" Value="@customer?.CustomerBusinessGroupName">@customer?.CustomerBusinessGroupName</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect T="string"
                               Value="ViewModel.ReasonValue"
                               For="@(() => ViewModel.ReasonValue)"
                               ValueChanged="ViewModel.OnReasonValueChangedAsync"
                               Label="Reason"
                               Placeholder="Please Select"
                               Disabled="ViewModel.UploadedSuccessfully"
                               AdornmentIcon="@Icons.Material.Filled.Checklist"
                               AdornmentColor="Color.Primary">
                        @foreach (var reason in ViewModel.Reasons)
                        {
                            <MudSelectItem T="string" Value="@reason.RfqReasonTitle">@reason.RfqReasonTitle</MudSelectItem>
                        }
                    </MudSelect>
                </MudStack>
            </MudPaper>

            @* Column 2: Project + VehicleVolume (25%) *@
            <MudPaper Class="pa-4" Style="flex: 0 0 25%; max-width:25%; min-width: 25%;">
                <MudStack>
                    <MudAutocomplete T="RfqCustomerProjectAssociationUxModel"
                                     @bind-Value="ViewModel.SelectedProject"
                                     Label="Project"
                                     Placeholder="Search project..."
                                     SearchFunc="@ViewModel.SearchProjectsAsync"
                                     ToStringFunc="@(p => p != null ? $"{p.ProjectCode} - {p.CustomerName}" : "")"
                                     ResetValueOnEmptyText="true"
                                     CoerceText="true"
                                     CoerceValue="false"
                                     Disabled="ViewModel.UploadedSuccessfully"
                                     AdornmentIcon="@Icons.Material.Filled.DesignServices"
                                     AdornmentColor="Color.Primary"
                                     Immediate="true"
                                     Dense="true"
                                     Clearable="true"
                                     ShowProgressIndicator="true"
                                     MaxItems="100">
                        <ItemTemplate Context="project">
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.body2">
                                    <strong>@project.ProjectCode</strong>
                                </MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @project.ProjectCode - @project.CustomerName
                                </MudText>
                            </MudStack>
                        </ItemTemplate>
                    </MudAutocomplete>

                    <MudNumericField @bind-Value="ViewModel.VehicleVolume"
                                     T="int"
                                     Label="Vehicle Volume"
                                     Disabled="ViewModel.UploadedSuccessfully"
                                     Variant="Variant.Text"
                                     Min="0" />
                </MudStack>
            </MudPaper>

            @* Column 3: Quotation + Deadline (auto, remaining space) *@
            <MudPaper Class="pa-2" Style="flex: 1 1 20%;  max-width:20%; min-width: 192px;">
                <MudStack>
                    <MudSelect T="string"
                               Value="ViewModel.QuotationValue"
                               For="@(() => ViewModel.QuotationValue)"
                               ValueChanged="ViewModel.HandleQuotationValueChanged"
                               Label="Quotation Number"
                               Placeholder="Temp Values"
                               Disabled="ViewModel.UploadedSuccessfully"
                               Clearable="true"
                               AdornmentIcon="@Icons.Material.Filled.RequestQuote"
                               AdornmentColor="Color.Primary">
                        @foreach (string quotationNumber in ViewModel.QuotationNumbers)
                        {
                            <MudSelectItem T="string" Value="@quotationNumber">@quotationNumber</MudSelectItem>
                        }
                    </MudSelect>
                    <MudDatePicker Label="Deadline"
                                   @bind-Date="ViewModel.Date"
                                   Disabled="ViewModel.UploadedSuccessfully"
                                   DateFormat="dd.MM.yyyy" />

                </MudStack>
            </MudPaper>

            @* Column 4: File Manager (max 30%) *@
            <MudPaper Class="pa-2 w-100" Style="flex: 0 0 15%; max-width:15%; min-width: 192px;">
                <FileManager @ref="_ComponentFileManager"
                             FileObjects="ViewModel.FileObjects"
                             OnFilesAdded="ViewModel.AddFilesAsync"
                             OnClearAllRequested="ViewModel.ClearFilesAsync"
                             UploadDisabled="@(!ViewModel.FileObjects.Any() || ViewModel.UploadedSuccessfully)" />
            </MudPaper>
            <MudPaper Class="d-flex justify-center align-center pa-2">
                <MudTooltip Text="Process Rfq Data and BOM Files">
                    <MudButton StartIcon="@Icons.Material.Filled.Upload"
                                Variant="Variant.Filled"
                               Color="Color.Tertiary"
                                Size="Size.Medium"
                                Disabled="@ViewModel.ProcessDataDisabled"
                                OnClick="@ViewModel.ProcessDataAsync">
                        Process Rfq
                    </MudButton>
                </MudTooltip>
            </MudPaper>
        </MudPaper>
    </MudItem>
    @* File drop zone  *@
    <MudItem xs="12">
        <MudPaper Class="d-flex flex-column" Width="100%">
            <div style="height: calc(100vh - 324px); display: flex; flex-direction: column; overflow: auto;">
                @* File Cards Section *@
                <FileCards @ref="_ComponentFileCards"
                           FileObjects="ViewModel.FileObjects"
                           OnRemoveFile="ViewModel.HandleFileRemovalAsync" />
            </div>
        </MudPaper>
    </MudItem>
</MudGrid>
