@page "/"
@rendermode InteractiveServer

@using SalesSystem.Dsi.Services
@using RfqModule
@using MudBlazor
@inject DsiUxClientService DsiUxClientService

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6">

    <!-- ================= PAGE HEADER ================= -->
    <MudPaper Elevation="0" Class="pa-6 mb-6 page-header">
        <MudGrid Class="align-center">
            <MudItem xs="12" md="8">
                <MudText Typo="Typo.h4" Class="font-weight-bold">
                    DSI Project Dashboard
                </MudText>

                <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mt-1">
                    Manage harnesses, composite options, and related components in one centralized view.
                </MudText>
            </MudItem>

            <MudItem xs="12" md="4" Class="d-flex justify-end">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="LoadHarnesses"
                           Disabled="_loadingHarnesses">
                    Refresh Harnesses
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <!-- ================= SUMMARY CARDS ================= -->
    <MudGrid Class="mb-6">
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="2" Class="summary-card">
                <MudCardContent>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Harnesses</MudText>
                    <MudText Typo="Typo.h5" Class="font-weight-bold">@_harnesses.Count</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="2" Class="summary-card">
                <MudCardContent>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Selected Harness</MudText>
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold text-truncate">
                        @(_selectedHarness?.HarnessName1 ?? "None")
                    </MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="2" Class="summary-card">
                <MudCardContent>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Selected Options</MudText>
                    <MudText Typo="Typo.h5" Class="font-weight-bold">@_selectedCompositeDetails.Count</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="2" Class="summary-card">
                <MudCardContent>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Components</MudText>
                    <MudText Typo="Typo.h5" Class="font-weight-bold">@_components.Count</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    <!-- ================= MAIN CONTENT ================= -->
    <MudGrid>

        <!-- ================= HARNESS TABLE ================= -->
        <MudItem xs="12" lg="5">
            <MudCard Elevation="3" Class="h-100">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6" Class="font-weight-bold">
                            Harnesses
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Select a harness to load its composite details.
                        </MudText>
                    </CardHeaderContent>

                    <CardHeaderActions>
                        @if (_loadingHarnesses)
                        {
                            <MudProgressCircular Size="Size.Small"
                                                 Indeterminate="true"
                                                 Color="Color.Primary" />
                        }
                    </CardHeaderActions>
                </MudCardHeader>

                <MudDivider />

                <MudCardContent Class="pa-0">
                    @if (!_loadingHarnesses && !_harnesses.Any())
                    {
                        <MudAlert Severity="Severity.Info" Class="ma-4">
                            No harnesses available. Click refresh to load data.
                        </MudAlert>
                    }
                    else
                    {
                        <MudTable T="DSIHarnessGrpc"
                                  Items="_harnesses"
                                  Hover="true"
                                  Dense="true"
                                  Striped="true"
                                  Bordered="false"
                                  Elevation="0"
                                  Loading="_loadingHarnesses"
                                  OnRowClick="OnHarnessRowClick"
                                  RowClassFunc="GetHarnessRowClass"
                                  Class="rounded-table">

                            <HeaderContent>
                                <MudTh>Harness</MudTh>
                                <MudTh>Customer</MudTh>
                                <MudTh>Site</MudTh>
                                <MudTh>Type</MudTh>
                            </HeaderContent>

                            <RowTemplate>
                                <MudTd DataLabel="Harness">
                                    <MudText Typo="Typo.body2" Class="font-weight-medium">
                                        @context.HarnessName1
                                    </MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @context.Title
                                    </MudText>
                                </MudTd>

                                <MudTd DataLabel="Customer">@context.Customer</MudTd>
                                <MudTd DataLabel="Site">@context.Site</MudTd>

                                <MudTd DataLabel="Type">
                                    <MudChip T="string"
                                             Size="Size.Small"
                                             Color="Color.Info"
                                             Variant="Variant.Outlined">
                                        @context.Type
                                    </MudChip>
                                </MudTd>
                            </RowTemplate>

                            <PagerContent>
                                <MudTablePager PageSizeOptions="new int[] { 5, 10, 20, 50 }" />
                            </PagerContent>

                        </MudTable>
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- ================= RIGHT SIDE ================= -->
        <MudItem xs="12" lg="7">

            <!-- ================= COMPOSITE DETAILS ================= -->
            <MudCard Elevation="3" Class="mb-6">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6" Class="font-weight-bold">
                            Composite Details
                        </MudText>

                        @if (_selectedHarness != null)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                Showing options for
                                <b>@_selectedHarness.HarnessName1</b>
                            </MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                Select a harness to view composite options.
                            </MudText>
                        }
                    </CardHeaderContent>

                    <CardHeaderActions>
                        @if (_loadingCompositeDetails)
                        {
                            <MudProgressCircular Size="Size.Small"
                                                 Indeterminate="true"
                                                 Color="Color.Secondary" />
                        }
                    </CardHeaderActions>
                </MudCardHeader>

                <MudDivider />

                <MudCardContent Class="pa-0">

                    @if (_selectedHarness == null)
                    {
                        <MudAlert Severity="Severity.Normal" Class="ma-4">
                            No harness selected yet.
                        </MudAlert>
                    }
                    else if (!_loadingCompositeDetails && !_compositeDetails.Any())
                    {
                        <MudAlert Severity="Severity.Warning" Class="ma-4">
                            No composite details found for this harness.
                        </MudAlert>
                    }
                    else
                    {
                        <MudDataGrid T="DSICompositeDetailGrpc"
                                     Items="_compositeDetails"
                                     MultiSelection="true"
                                     @bind-SelectedItems="_selectedCompositeDetails"
                                     Dense="true"
                                     Hover="true"
                                     Striped="true"
                                     Bordered="false"
                                     ReadOnly="true"
                                     Elevation="0"
                                     Class="rounded-table">

                            <Columns>
                                <SelectColumn T="DSICompositeDetailGrpc" />

                                <PropertyColumn Property="x => x.HarnessName1"
                                                Title="Harness" />

                                <PropertyColumn Property="x => x.CircuitOption"
                                                Title="Circuit Option" />

                                <PropertyColumn Property="x => x.Customer"
                                                Title="Customer" />
                            </Columns>

                            <PagerContent>
                                <MudDataGridPager T="DSICompositeDetailGrpc" />
                            </PagerContent>

                        </MudDataGrid>
                    }

                </MudCardContent>

                <MudDivider />

                <MudCardActions Class="pa-4 d-flex justify-space-between align-center flex-wrap gap-2">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudChip T="string"
                                 Color="Color.Primary"
                                 Variant="Variant.Filled"
                                 Size="Size.Small">
                            Selected: @_selectedCompositeDetails.Count
                        </MudChip>

                        @if (_selectedHarness != null)
                        {
                            <MudChip T="string"
                                     Color="Color.Default"
                                     Variant="Variant.Outlined"
                                     Size="Size.Small">
                                @_selectedHarness.HarnessName1
                            </MudChip>
                        }
                    </MudStack>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.Inventory2"
                               Disabled="_selectedCompositeDetails.Count == 0 || _loadingComponents"
                               OnClick="LoadComponentsByHarnessAndCircuitOption">
                        Load Components
                    </MudButton>
                </MudCardActions>
            </MudCard>

            <!-- ================= COMPONENTS ================= -->
            <MudCard Elevation="3">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6" Class="font-weight-bold">
                            Components
                        </MudText>

                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Components returned based on selected circuit options.
                        </MudText>
                    </CardHeaderContent>

                    <CardHeaderActions>
                        @if (_loadingComponents)
                        {
                            <MudProgressCircular Size="Size.Small"
                                                 Indeterminate="true"
                                                 Color="Color.Success" />
                        }
                    </CardHeaderActions>
                </MudCardHeader>

                <MudDivider />

                <MudCardContent Class="pa-0">

                    @if (!_loadingComponents && !_components.Any())
                    {
                        <MudAlert Severity="Severity.Info" Class="ma-4">
                            No components loaded yet. Select composite options and click
                            <b>Load Components</b>.
                        </MudAlert>
                    }
                    else
                    {
                        <MudDataGrid T="DSIComponentGrpc"
                                     Items="_components"
                                     Dense="true"
                                     Hover="true"
                                     Striped="true"
                                     Bordered="false"
                                     Elevation="0"
                                     Class="rounded-table">

                            <Columns>
                                <PropertyColumn Property="x => x.PartNumber1"
                                                Title="Part Number 1" />

                                <PropertyColumn Property="x => x.PartNumber2"
                                                Title="Part Number 2" />

                                <PropertyColumn Property="x => x.PartNumber3"
                                                Title="Part Number 3" />

                                <PropertyColumn Property="x => x.Quantity"
                                                Title="Quantity" />
                            </Columns>

                            <PagerContent>
                                <MudDataGridPager T="DSIComponentGrpc" />
                            </PagerContent>

                        </MudDataGrid>
                    }

                </MudCardContent>
            </MudCard>

        </MudItem>
    </MudGrid>

</MudContainer>

@code {
    private bool _loadingHarnesses;
    private bool _loadingCompositeDetails;
    private bool _loadingComponents;

    private List<DSIHarnessGrpc> _harnesses = new();
    private List<DSICompositeDetailGrpc> _compositeDetails = new();
    private List<DSIComponentGrpc> _components = new();

    private DSIHarnessGrpc? _selectedHarness;

    private HashSet<DSICompositeDetailGrpc> _selectedCompositeDetails = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadHarnesses();
    }

    private async Task LoadHarnesses()
    {
        try
        {
            _loadingHarnesses = true;

            await DsiUxClientService.GetAllHarnessAsync();
            _harnesses = DsiUxClientService.Harnesses.ToList();

            _selectedHarness = null;
            _compositeDetails.Clear();
            _components.Clear();
            _selectedCompositeDetails.Clear();
        }
        finally
        {
            _loadingHarnesses = false;
        }
    }

    private async Task OnHarnessRowClick(TableRowClickEventArgs<DSIHarnessGrpc> args)
    {
        var clicked = args.Item;
        if (clicked == null)
            return;

        _selectedHarness = clicked;

        _components.Clear();
        _selectedCompositeDetails.Clear();

        await LoadCompositeDetailsByHarnessId(clicked.Id);
    }

    private async Task LoadCompositeDetailsByHarnessId(string harnessId)
    {
        try
        {
            _loadingCompositeDetails = true;

            await DsiUxClientService.GetCompositeDetailByHarnessIdAsync(harnessId);
            _compositeDetails = DsiUxClientService.CompositeDetails.ToList();
        }
        finally
        {
            _loadingCompositeDetails = false;
        }
    }

    private async Task LoadComponentsByHarnessAndCircuitOption()
    {
        if (_selectedHarness == null || !_selectedCompositeDetails.Any())
            return;

        try
        {
            _loadingComponents = true;
            _components.Clear();

            var harnessNames = new List<string>
            {
                _selectedHarness.HarnessName1!
            };

            var compositeOptions = _selectedCompositeDetails
                .Where(x => !string.IsNullOrWhiteSpace(x.CircuitOption))
                .SelectMany(x => x.CircuitOption!
                    .Split(',', StringSplitOptions.RemoveEmptyEntries))
                .Select(x => x.Trim())
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();

            await DsiUxClientService.GetComponentsByHarnessAndOptionsAsync(
                harnessNames,
                compositeOptions);

            _components = DsiUxClientService.Components.ToList();
        }
        finally
        {
            _loadingComponents = false;
        }
    }

    private string GetHarnessRowClass(DSIHarnessGrpc item, int row)
    {
        return _selectedHarness?.Id == item.Id ? "selected-row" : string.Empty;
    }
}