@page "/"
@rendermode InteractiveServer

@using SalesSystem.Dsi.Services
@using RfqModule
@using MudBlazor
@inject DsiUxClientService DsiUxClientService

<MudText Typo="Typo.h4" Align="Align.Center" Class="mb-4">
    DSI Project
</MudText>

<MudPaper Class="pa-4">

    <!-- ================= HARNESS TABLE ================= -->
    <MudText Typo="Typo.h6" Class="mb-2">Harnesses</MudText>

    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-4">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="LoadHarnesses"
                   Disabled="_loadingHarnesses">
            Load Harnesses
        </MudButton>

        @if (_loadingHarnesses)
        {
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        }
    </MudStack>

    <MudTable T="DSIHarnessGrpc"
              Items="_harnesses"
              Hover="true"
              Dense="true"
              Striped="true"
              Bordered="true"
              Loading="_loadingHarnesses"
              OnRowClick="OnHarnessRowClick"
              RowClassFunc="GetHarnessRowClass">

        <HeaderContent>
            <MudTh>Harness Name</MudTh>
            <MudTh>Customer</MudTh>
            <MudTh>Site</MudTh>
            <MudTh>Type</MudTh>
            <MudTh>Title</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd>@context.HarnessName1</MudTd>
            <MudTd>@context.Customer</MudTd>
            <MudTd>@context.Site</MudTd>
            <MudTd>@context.Type</MudTd>
            <MudTd>@context.Title</MudTd>
        </RowTemplate>

    </MudTable>

    <MudDivider Class="my-6" />

    <!-- ================= COMPOSITE DETAILS ================= -->
    <MudText Typo="Typo.h6" Class="mb-2">
        Composite Details
        @if (_selectedHarness != null)
        {
            <span> for: <b>@_selectedHarness.HarnessName1</b></span>
        }
    </MudText>

    @if (_loadingCompositeDetails)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Secondary" />
    }

    <MudDataGrid T="DSICompositeDetailGrpc"
                 Items="_compositeDetails"
                 MultiSelection="true"
                 @bind-SelectedItems="_selectedCompositeDetails"
                 Dense="true"
                 Hover="true"
                 Striped="true"
                 Bordered="true"
                 ReadOnly="true">

        <Columns>

            <!-- ✅ CHECKBOX COLUMN -->
            <SelectColumn T="DSICompositeDetailGrpc" />

            <PropertyColumn Property="x => x.HarnessName1" Title="Harness" />
            <PropertyColumn Property="x => x.CircuitOption" Title="Option" />
            <PropertyColumn Property="x => x.Customer" Title="Customer" />

        </Columns>

    </MudDataGrid>

    <!--  Selected count -->
    <MudText Class="mt-2">
        Selected: @_selectedCompositeDetails.Count
    </MudText>

    <!-- LOAD BUTTON -->
    <MudButton Variant="Variant.Filled"
               Color="Color.Success"
               Class="mt-3"
               Disabled="_selectedCompositeDetails.Count == 0"
               OnClick="LoadComponentsByHarnessAndCircuitOption">
        Load Components
    </MudButton>

    <MudDivider Class="my-6" />

    <!-- ================= COMPONENTS ================= -->
    <MudText Typo="Typo.h6" Class="mb-2">
        Components
        @if (_selectedHarness != null && _selectedCompositeDetails.Any())
        {
            <span> for <b>@_selectedHarness.HarnessName1</b></span>
        }
    </MudText>

    @if (_loadingComponents)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Success" />
    }

    <MudDataGrid T="DSIComponentGrpc"
                 Items="_components"
                 Dense="true"
                 Hover="true"
                 Striped="true"
                 Bordered="true">

        <Columns>
            <PropertyColumn Property="x => x.PartNumber1" Title="Part1" />
            <PropertyColumn Property="x => x.PartNumber2" Title="Part2" />
            <PropertyColumn Property="x => x.PartNumber3" Title="Part3" />
            <PropertyColumn Property="x => x.Quantity" Title="Qty" />
        </Columns>

    </MudDataGrid>

</MudPaper>

@code {
    private bool _loadingHarnesses;
    private bool _loadingCompositeDetails;
    private bool _loadingComponents;

    private List<DSIHarnessGrpc> _harnesses = new();
    private List<DSICompositeDetailGrpc> _compositeDetails = new();
    private List<DSIComponentGrpc> _components = new();

    private DSIHarnessGrpc? _selectedHarness;

    // ✅ Multi-select container
    private HashSet<DSICompositeDetailGrpc> _selectedCompositeDetails = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadHarnesses();
    }

    private async Task LoadHarnesses()
    {
        try
        {
            _loadingHarnesses = true;

            await DsiUxClientService.GetAllHarnessAsync();
            _harnesses = DsiUxClientService.Harnesses.ToList();

            _selectedHarness = null;
            _compositeDetails.Clear();
            _components.Clear();
            _selectedCompositeDetails.Clear();
        }
        finally
        {
            _loadingHarnesses = false;
        }
    }

    private async Task OnHarnessRowClick(TableRowClickEventArgs<DSIHarnessGrpc> args)
    {
        var clicked = args.Item;
        if (clicked == null) return;

        _selectedHarness = clicked;
        _components.Clear();
        _selectedCompositeDetails.Clear();

        await LoadCompositeDetailsByHarnessId(clicked.Id);
    }

    private async Task LoadCompositeDetailsByHarnessId(string harnessId)
    {
        try
        {
            _loadingCompositeDetails = true;

            await DsiUxClientService.GetCompositeDetailByHarnessIdAsync(harnessId);
            _compositeDetails = DsiUxClientService.CompositeDetails.ToList();
        }
        finally
        {
            _loadingCompositeDetails = false;
        }
    }

    private async Task LoadComponentsByHarnessAndCircuitOption()
    {
        if (_selectedHarness == null || !_selectedCompositeDetails.Any())
            return;

        try
        {
            _loadingComponents = true;
            _components.Clear();

            var harnessNames = new List<string>
            {
                _selectedHarness.HarnessName1!
            };

            var compositeOptions = _selectedCompositeDetails
                .Where(x => !string.IsNullOrWhiteSpace(x.CircuitOption))
                .SelectMany(x => x.CircuitOption!
                    .Split(',', StringSplitOptions.RemoveEmptyEntries))
                .Select(x => x.Trim())
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();

            await DsiUxClientService.GetComponentsByHarnessAndOptionsAsync(
                harnessNames,
                compositeOptions);

            _components = DsiUxClientService.Components.ToList();
        }
        finally
        {
            _loadingComponents = false;
        }
    }

    private string GetHarnessRowClass(DSIHarnessGrpc item, int row)
    {
        return _selectedHarness?.Id == item.Id ? "selected-row" : "";
    }
}