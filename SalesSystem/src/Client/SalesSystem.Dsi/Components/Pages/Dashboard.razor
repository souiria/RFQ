@page "/"
@rendermode InteractiveServer

@using SalesSystem.Dsi.Services
@using RfqModule
@using MudBlazor
@inject DsiUxClientService DsiUxClientService

<MudText Typo="Typo.h4" Align="Align.Center" Class="mb-4">
    DSI Project
</MudText>

<MudPaper Class="pa-4">

    <!-- ====================================================== -->
    <!-- HARNESS TABLE -->
    <!-- ====================================================== -->
    <MudText Typo="Typo.h6" Class="mb-2">Harnesses</MudText>

    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-4">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="LoadHarnesses"
                   Disabled="_loadingHarnesses">
            Load Harnesses
        </MudButton>

        @if (_loadingHarnesses)
        {
            <MudProgressCircular Indeterminate="true"
                                 Color="Color.Primary"
                                 Size="Size.Medium" />
        }
    </MudStack>

    <MudTable T="DSIHarnessGrpc"
              Items="_harnesses"
              Hover="true"
              Dense="true"
              Striped="true"
              Bordered="true"
              Loading="_loadingHarnesses"
              OnRowClick="OnHarnessRowClick"
              RowClassFunc="GetHarnessRowClass">

        <HeaderContent>
            <MudTh>Harness Name</MudTh>
            <MudTh>Customer</MudTh>
            <MudTh>Site</MudTh>
            <MudTh>Type</MudTh>
            <MudTh>Title</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Harness Name">@context.HarnessName1</MudTd>
            <MudTd DataLabel="Customer">@context.Customer</MudTd>
            <MudTd DataLabel="Site">@context.Site</MudTd>
            <MudTd DataLabel="Type">@context.Type</MudTd>
            <MudTd DataLabel="Title">@context.Title</MudTd>
        </RowTemplate>

        <NoRecordsContent>
            <MudText>No harness data found.</MudText>
        </NoRecordsContent>

        <LoadingContent>
            <MudText>Loading harnesses...</MudText>
        </LoadingContent>
    </MudTable>

    <MudDivider Class="my-6" />

    <!-- ====================================================== -->
    <!-- COMPOSITE DETAILS BY HARNESS ID -->
    <!-- ====================================================== -->
    <MudText Typo="Typo.h6" Class="mb-2">
        Composite Details by HarnessId
        @if (_selectedHarness != null)
        {
            <span> for: <b>@_selectedHarness.HarnessName1</b></span>
        }
    </MudText>

    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-3">
        @if (_loadingCompositeDetails)
        {
            <MudProgressCircular Indeterminate="true"
                                 Color="Color.Secondary"
                                 Size="Size.Medium" />
            <MudText>Loading composite details...</MudText>
        }
        else if (_selectedHarness == null)
        {
            <MudText Color="Color.Info">Select a harness row above.</MudText>
        }
    </MudStack>

    <MudDataGrid T="DSICompositeDetailGrpc"
                 Items="_compositeDetails"
                 Dense="true"
                 Hover="true"
                 Striped="true"
                 Bordered="true"
                 ReadOnly="true"
                 RowClick="OnCompositeDetailRowClick">

        <Columns>
            <PropertyColumn Property="x => x.HarnessName1" Title="Harness Name" />
            <PropertyColumn Property="x => x.CircuitOption" Title="Circuit Option" />
            <PropertyColumn Property="x => x.Customer" Title="Customer" />
            <PropertyColumn Property="x => x.Site" Title="Site" />
            <PropertyColumn Property="x => x.Range" Title="Range" />
            <PropertyColumn Property="x => x.Type" Title="Type" />
            <PropertyColumn Property="x => x.Title" Title="Title" />
            <PropertyColumn Property="x => x.AlphaCode" Title="Alpha Code" />
        </Columns>

        <NoRecordsContent>
            <MudText>No composite details found.</MudText>
        </NoRecordsContent>
    </MudDataGrid>

    <MudDivider Class="my-6" />

    <!-- ====================================================== -->
    <!-- COMPONENTS BY HARNESS NAME + CIRCUIT OPTION -->
    <!-- ====================================================== -->
    <MudText Typo="Typo.h6" Class="mb-2">
        Components by HarnessName + CircuitOption
        @if (_selectedHarness != null && _selectedCompositeDetail != null)
        {
            <span>
                for:
                <b>@_selectedHarness.HarnessName1</b>
                /
                <b>@_selectedCompositeDetail.CircuitOption</b>
            </span>
        }
    </MudText>

    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-3">
        @if (_loadingComponents)
        {
            <MudProgressCircular Indeterminate="true"
                                 Color="Color.Success"
                                 Size="Size.Medium" />
            <MudText>Loading components...</MudText>
        }
        else if (_selectedCompositeDetail == null)
        {
            <MudText Color="Color.Info">
                Select a row in the Composite Details datagrid above to load components.
            </MudText>
        }
    </MudStack>

    <MudDataGrid T="DSIComponentGrpc"
                 Items="_components"
                 Dense="true"
                 Hover="true"
                 Striped="true"
                 Bordered="true"
                 ReadOnly="true">

        <Columns>
            <PropertyColumn Property="x => x.PartNumber1" Title="Part Number 1" />
            <PropertyColumn Property="x => x.PartNumber2" Title="Part Number 2" />
            <PropertyColumn Property="x => x.PartNumber3" Title="Part Number 3" />
            <PropertyColumn Property="x => x.Quantity" Title="Quantity" />
        </Columns>

        <NoRecordsContent>
            <MudText>No components found.</MudText>
        </NoRecordsContent>
    </MudDataGrid>

</MudPaper>

@code {
    private bool _loadingHarnesses;
    private bool _loadingCompositeDetails;
    private bool _loadingComponents;

    private List<DSIHarnessGrpc> _harnesses = new();
    private List<DSICompositeDetailGrpc> _compositeDetails = new();
    private List<DSIComponentGrpc> _components = new();

    private DSIHarnessGrpc? _selectedHarness;
    private DSICompositeDetailGrpc? _selectedCompositeDetail;

    protected override async Task OnInitializedAsync()
    {
        await LoadHarnesses();
    }

    private async Task LoadHarnesses()
    {
        try
        {
            _loadingHarnesses = true;
            StateHasChanged();

            await DsiUxClientService.GetAllHarnessAsync();

            _harnesses = DsiUxClientService.Harnesses.ToList();

            _selectedHarness = null;
            _selectedCompositeDetail = null;
            _compositeDetails.Clear();
            _components.Clear();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading harnesses: {ex.Message}");
        }
        finally
        {
            _loadingHarnesses = false;
            StateHasChanged();
        }
    }

    private async Task OnHarnessRowClick(TableRowClickEventArgs<DSIHarnessGrpc> args)
    {
        DSIHarnessGrpc? clickedHarness = args.Item;

        if (clickedHarness == null || string.IsNullOrWhiteSpace(clickedHarness.Id))
        {
            return;
        }

        _selectedHarness = clickedHarness;
        _selectedCompositeDetail = null;
        _components.Clear();

        await LoadCompositeDetailsByHarnessId(clickedHarness.Id);
    }

    private async Task LoadCompositeDetailsByHarnessId(string harnessId)
    {
        try
        {
            _loadingCompositeDetails = true;
            _compositeDetails.Clear();
            StateHasChanged();

            await DsiUxClientService.GetCompositeDetailByHarnessIdAsync(harnessId);

            _compositeDetails = DsiUxClientService.CompositeDetails.ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading composite details by HarnessId: {ex.Message}");
        }
        finally
        {
            _loadingCompositeDetails = false;
            StateHasChanged();
        }
    }

    private async Task OnCompositeDetailRowClick(DataGridRowClickEventArgs<DSICompositeDetailGrpc> args)
    {
        DSICompositeDetailGrpc? clickedCompositeDetail = args.Item;

        if (clickedCompositeDetail == null)
        {
            return;
        }

        _selectedCompositeDetail = clickedCompositeDetail;

        await LoadComponentsByHarnessAndCircuitOption();
    }

    private async Task LoadComponentsByHarnessAndCircuitOption()
    {
        if (_selectedHarness == null || _selectedCompositeDetail == null)
        {
            return;
        }

        string harnessName = _selectedHarness.HarnessName1 ?? string.Empty;
        string circuitOption = _selectedCompositeDetail.CircuitOption ?? string.Empty;

        if (string.IsNullOrWhiteSpace(harnessName) || string.IsNullOrWhiteSpace(circuitOption))
        {
            return;
        }

        try
        {
            _loadingComponents = true;
            _components.Clear();
            StateHasChanged();

            List<string> compositeOptions = new List<string>
            {
                circuitOption
            };

            await DsiUxClientService.GetComponentsByHarnessAndOptionsAsync(
                harnessName,
                compositeOptions);

            _components = DsiUxClientService.Components.ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading components by HarnessName + CircuitOption: {ex.Message}");
        }
        finally
        {
            _loadingComponents = false;
            StateHasChanged();
        }
    }

    private string GetHarnessRowClass(DSIHarnessGrpc item, int rowNumber)
    {
        if (_selectedHarness != null && item.Id == _selectedHarness.Id)
        {
            return "selected-row";
        }

        return string.Empty;
    }
}