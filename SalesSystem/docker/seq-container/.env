# Seq Environment Configuration
# Copy this to .env in the seq-container directory and customize as needed

# Admin user configuration (optional - if not set, default admin/password will be used)
SEQ_ADMIN_USERNAME=admin
# To set a custom password, generate a hash using: echo 'YourPassword' | docker run --rm -i datalust/seq config hash
# SEQ_ADMIN_PASSWORD_HASH=

# Alternative simple password setup (less secure, for development only)
# Uncomment the line below and set your preferred password
SEQ_ADMIN_PASSWORD=Seq4202!!!!

# Seq will be available at:
# Web UI: http://localhost
# Ingestion endpoint: http://localhost:5341
# Internal container access: http://seq_service:5341
