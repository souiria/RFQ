<igWpf:RibbonTabItem x:Class="UX.Commercial.Pricing.RibbonTabs.Views.SalesPricingRibbonTab"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:igWpf="http://infragistics.com/Ribbon"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                     xmlns:local="clr-namespace:UX.Commercial.Pricing.RibbonTabs.Views"
                     xmlns:prism="http://prismlibrary.com/"  
                     prism:ViewModelLocator.AutoWireViewModel="True"
                     Header="{Binding Header}"
                     mc:Ignorable="d" 
                     d:DesignHeight="450" d:DesignWidth="800">
    <igWpf:RibbonGroup Caption="{Binding HelpdeskCaption}">
        <igWpf:ButtonTool Caption="{Binding HelpCaption}"
                          Command="{Binding HelpCommand}"
                          LargeImage="pack://application:,,,/Common.UX;component/Resources/Images/48x48/actions/Screenshot.png"
                          SmallImage="pack://application:,,,/Common.UX;component/Resources/Images/22x22/actions/Screenshot.png"
                          igWpf:RibbonGroup.MaximumSize="ImageAndTextLarge" />
    </igWpf:RibbonGroup>
</igWpf:RibbonTabItem>
