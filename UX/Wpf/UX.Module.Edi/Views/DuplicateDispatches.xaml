<UserControl x:Class="UX.Module.Edi.Views.DuplicateDispatches"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UX.Module.Edi.Views"
             xmlns:converter="clr-namespace:UX.Module.Edi.Core.Converters"
             xmlns:ig="http://schemas.infragistics.com/xaml"
             xmlns:igDp="http://infragistics.com/DataPresenter"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:converters="clr-namespace:UX.Module.Edi.Core.Converters"
             xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" 
             xmlns:igDP="http://schemas.infragistics.com/xaml/wpf" 
             xmlns:viewmodels="clr-namespace:UX.Module.Edi.ViewModels" 
             d:DataContext="{d:DesignInstance Type=viewmodels:DuplicateDispatchesViewModel}"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction
            Command="{Binding Path=PageLoadedCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid x:Name="LayoutRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <igDP:XamDataGrid x:Name="DuplicateInvoiceDetails" AutoFit="True" DataSource="{Binding Path=DuplicateDispatchesData}">
                <igDP:XamDataGrid.Resources>
                    <converter:PriceLagConverter x:Key="PriceLagConverter" />
                </igDP:XamDataGrid.Resources>
                <igDP:XamDataGrid.FieldSettings>
                    <igDP:FieldSettings AllowEdit="False" LabelTextWrapping="Wrap" />
                </igDP:XamDataGrid.FieldSettings>
                <igDP:XamDataGrid.FieldLayoutSettings>
                    <igDP:FieldLayoutSettings AutoGenerateFields="False" AutoFitMode="Always" />
                </igDP:XamDataGrid.FieldLayoutSettings>
                <igDP:XamDataGrid.FieldLayouts>
                    <igDP:FieldLayout>
                        <igDP:FieldLayout.Fields>
                            <igDP:TextField Name="FileName" Label="File Name" />
                            <igDP:TextField Name="FinanceCode" Label="Finance Code" />
                            <igDP:DateTimeField Name="UploadDate" Label="Upload Date" />
                            <igDP:TextField Name="DispatchNumber" Label="Dispatch Number" />
                            <igDP:DateTimeField Name="DispatchDate" Label="Dispatch Date" />
                            <igDP:TextField Name="CustomerOrderNumber" Label="Customer Order Number" />
                            <igDP:TextField Name="PartNumber" Label="Part Number" />
                            <igDP:TextField Name="PartDescription" Label="Part Description" />
                            <igDP:NumericField Name="Quantity" Label="Quantity"  />
                            <igDP:TextField Name="UnloadingPoint" Label="Unloading Point" />
                            <igDP:TextField Name="WmsSiteCode" Label="WMS Site Code" />
                            <igDP:TextField Name="WmsCustomerCode" Label="WMS Customer Code" />
                            <igDP:TextField Name="CustomerDispatchNumber" Label="Customer Dispatch Number" />
                            <igDP:TextField Name="MessageType" Label="Message Type" />
                            <igDP:NumericField Name="ExchangeRate" Label="Exchange Rate" />
                            <igDP:TextField Name="CustomerPartNumber" Label="Customer Part Number" />
                            <igDP:NumericField Name="TotalGrossWeight" Label="Total Gross Weight" />
                            <igDP:NumericField Name="TotalNetWeight" Label="Total Net Weight" />
                            <igDP:TextField Name="UnitOfMeasure" Label="Unit Of Measure" />
                            <igDP:TextField Name="TariffCode" Label="Tariff Code" />
                            <igDP:TextField Name="DeliveryTerms" Label="Delivery Terms" />
                            <igDP:TextField Name="TransportDetails" Label="Transport Details" />
                            <igDP:TextField Name="WmsInvoiceNumber" Label="WMS Invoice Number" />
                        </igDP:FieldLayout.Fields>
                    </igDP:FieldLayout>
                </igDP:XamDataGrid.FieldLayouts>
            </igDP:XamDataGrid>
        </Grid>

        <Grid Grid.Row="1">
            <igDP:XamDataGrid x:Name="DuplicateInvoice" DataContext="{Binding}"
                          DataSource="{Binding DuplicateDataProcessing, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <igDP:XamDataGrid.FieldLayoutSettings>
                    <igDP:FieldLayoutSettings AutoGenerateFields="False" />
                </igDP:XamDataGrid.FieldLayoutSettings>
                <igDP:XamDataGrid.FieldLayouts>
                    <igDP:FieldLayout>
                        <igDP:FieldLayout.Fields>
                            <igDP:TextField Name="FileName" Label="File Name" IsReadOnly="True" />
                            <igDP:TextField Name="DispatchNumber" Label="Dispatch Number" IsReadOnly="True" />
                            <igDP:CheckBoxField DataContext="{Binding IsMarkedForReprocessing}" Name="IsMarkedForReprocessing" Label="Reprocess">
                                <igDP:CheckBoxField.Settings>
                                    <igDP:FieldSettings DataItemUpdateTrigger="OnCellValueChange" />

                                </igDP:CheckBoxField.Settings>
                            </igDP:CheckBoxField>
                            <igDP:CheckBoxField DataContext="{Binding IsMarkedForDeletion}" Name="IsMarkedForDeletion" Label="Delete">
                                <igDP:CheckBoxField.Settings>
                                    <igDP:FieldSettings DataItemUpdateTrigger="OnCellValueChange"  />

                                </igDP:CheckBoxField.Settings>
                            </igDP:CheckBoxField>
                        </igDP:FieldLayout.Fields>
                    </igDP:FieldLayout>
                </igDP:XamDataGrid.FieldLayouts>
            </igDP:XamDataGrid>
        </Grid>
    </Grid>
</UserControl>
