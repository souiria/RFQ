<UserControl x:Class="UX.Module.Edi.Views.EdiCustomerParameters"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UX.Module.Edi.Views"
             xmlns:mvvm="http://prismlibrary.com/"
             xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
             xmlns:ig="http://schemas.infragistics.com/xaml" 
             xmlns:igDp="http://infragistics.com/DataPresenter"
             mvvm:ViewModelLocator.AutoWireViewModel="True"
             xmlns:converters="clr-namespace:UX.Module.Edi.Core.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=PageLoadedCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <UserControl.Resources >
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <CollectionViewSource x:Key="Customers" Source="{Binding Customers}"/>
        <CollectionViewSource x:Key="Locations" Source="{Binding Locations}"/>
    </UserControl.Resources>
    <Grid>

        <Border	Margin="3"
			BorderThickness="2"
			BorderBrush="{DynamicResource Highlights}">
            <igDp:XamDataGrid x:Name="LocationMasterGrid" 
                          DataSource="{Binding EdiCustomerParameters, Mode=TwoWay}"
                          SelectedDataItem="{Binding SelectedDataItem, Mode=TwoWay}">
                <igDp:XamDataGrid.Resources>
                    <converters:PriceLagConverter x:Key="PriceLagConverter" />
                </igDp:XamDataGrid.Resources>
                <igDp:XamDataGrid.FieldSettings>
                    <igDp:FieldSettings AllowEdit="True" LabelTextWrapping="Wrap" />
                </igDp:XamDataGrid.FieldSettings>
                <igDp:XamDataGrid.FieldLayoutSettings>
                    <igDp:FieldLayoutSettings 
                    AutoGenerateFields="False" 
                    AutoFitMode="Default"
                    SelectionTypeRecord="Single"/>
                </igDp:XamDataGrid.FieldLayoutSettings>
                <igDp:XamDataGrid.FieldLayouts>
                    <igDp:FieldLayout>
                        <igDp:FieldLayout.Fields>
                            <igDp:TextField Name="Customer" Label="Customer" />
                            <igDp:TextField Name="CustomerLocation" Label="Customer Location" />
                            <!--<igDp:ComboBoxField Name="CustomerGuid" 
                                            ItemsSource="{Binding Source={StaticResource Customers}}" 
                                            Width="192"
                                            DisplayMemberPath="Name"
                                            ValuePath="Id"
                                            Visibility="Visible" 
                                            Label="Customer" />
                            <igDp:ComboBoxField Name="CustomerLocationGuId" 
                                            ItemsSource="{Binding Source={StaticResource Locations}}" 
                                            Width="256"
                                            DisplayMemberPath="Name"
                                            ValuePath="Id"
                                            Visibility="Visible" 
                                            Label="Customer Location" />-->
                            <igDp:TextField
                            Width="96"
                            Name="FinanceCode" 
                            Label="Finance Code" />
                            <igDp:TextField 
                             Width="96"
                            Name="Unit4TaxCode" 
                            Label="Unit4 Tax Code" />
                            <igDp:CheckBoxField
                            Width="80"
                            DataContext="{Binding IsAutomatingInvoices, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Name="IsAutomatingInvoices" 
                            Label="Is Automating Invoices">
                                <igDp:CheckBoxField.Settings>
                                    <igDp:FieldSettings DataItemUpdateTrigger="OnCellValueChange" />
                                </igDp:CheckBoxField.Settings>
                            </igDp:CheckBoxField>
                            <igDp:CheckBoxField Width="64" Name="IsUsingCustomerDispatchNumber" Label="Is Using Customer Dispatch Number" />
                            <igDp:CheckBoxField Width="64" Name="IsUsingPartNumber" Label="Is Using Part Number" />
                            <igDp:CheckBoxField Width="64" Name="IsUsingH1CustomerOrderNumber" Label="Is Using H1 Customer Order Number" />
                            <!--<igDp:CheckBoxField Name="IdStatusUnit4OrderIdStatus" Label="IdStatusUnit4OrderIdStatus" />-->
                            <igDp:TextField Width="64" Name="Unit4ProductGroup" Label="Unit4 Product Group" />
                            <igDp:TextField Width="80" Name="Unit4Warehouse" Label="Unit4 Warehouse" />
                            <igDp:TextField Width="64" Name="Unit4Client" Label="Unit4 Client" />
                            <igDp:CheckBoxField Width="72" Name="IsUsingH1SchedulingAgreement" Label="Is Using H1 Scheduling Agreement" />
                            <igDp:CheckBoxField Width="48" Name="AllowZeroPrices" Label="Allow Zero Prices" />
                            <igDp:TextField Width="48" Name="Dim_Value_1" Label="Dim Value 1" />
                            <igDp:TextField Width="48" Name="Dim_Value_2" Label="Dim Value 2" />
                            <igDp:TextField Width="48" Name="Dim_Value_3" Label="Dim Value 3" />
                            <igDp:TextField Width="48" Name="Dim_Value_4" Label="Dim Value 4" />
                            <igDp:TextField Width="48" Name="Dim_Value_5" Label="Dim Value 5" />
                            <igDp:TextField Width="48" Name="Dim_Value_6" Label="Dim Value 6" />
                            <igDp:TextField Width="48" Name="Dim_Value_7" Label="Dim Value 7" />


                            <igDp:TextField Width="44" Name="rel_attr_id" Label="Rel Attr" />
                            <igDp:TextField Width="44" Name="rel_attr_id1" Label="Rel Attr 1" />
                            <igDp:TextField Width="44" Name="rel_attr_id2" Label="Rel Attr 2" />
                            <igDp:TextField Width="44" Name="rel_attr_id3" Label="Rel Attr 3" />
                            <igDp:TextField Width="44" Name="rel_attr_id4" Label="Rel Attr 4" />
                            <igDp:TextField Width="44" Name="rel_attr_id5" Label="Rel Attr 5" />

                            <igDp:TextField Width="52" Name="rel_value" Label="Rel Value" />
                            <igDp:TextField Width="52" Name="rel_value1" Label="Rel Value 1" />
                            <igDp:TextField Width="52" Name="rel_value2" Label="Rel Value 2" />
                            <igDp:TextField Width="52" Name="rel_value3" Label="Rel Value 3" />
                            <igDp:TextField Width="52" Name="rel_value4" Label="Rel Value 4" />
                            <igDp:TextField Width="52" Name="rel_value5" Label="Rel Value 5" />

                        </igDp:FieldLayout.Fields>
                    </igDp:FieldLayout>
                </igDp:XamDataGrid.FieldLayouts>
            </igDp:XamDataGrid>
        </Border>
        <ig:XamBusyIndicator IsBusy="{Binding IsBusy}" BusyContent="{Binding IsBusyContent}" />
    </Grid>
</UserControl>
