<igWpf:QuickAccessToolbar x:Class="SEWSE.H1.UX.Module.Core.RibbonQat.Views.QuickAccessToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:igWpf="http://schemas.infragistics.com/xaml/wpf"            
             xmlns:prism="http://prismlibrary.com/"             
             prism:ViewModelLocator.AutoWireViewModel="True"
             MinWidth="100" >
    <!-- Add a QatPlaceholderTool. By adding the TargetId it links this placeholder to an actual tool. -->
    <igWpf:QatPlaceholderTool TargetId="maximizeTool" />
    <igWpf:QatPlaceholderTool TargetId="undoTool" />
    <igWpf:QatPlaceholderTool TargetId="redoTool" />
    <igWpf:QatPlaceholderTool TargetId="copyTool" />
    <igWpf:QatPlaceholderTool TargetId="cutTool" />
</igWpf:QuickAccessToolbar>
