                        </Trigger>
                        <Trigger Property="MinWidth" Value="0">
                            <Setter Property="Width" Value="80"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

