    <Style TargetType="ig:XamBusyIndicator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ig:XamBusyIndicator}">
                    <Grid Margin="0" SnapsToDevicePixels="True">
                        <ContentPresenter ContentTemplate="{TemplateBinding ContentTemplate}" Content="{TemplateBinding Content}" ContentStringFormat="{TemplateBinding ContentStringFormat}" HorizontalAlignment="Stretch" Margin="0" VerticalAlignment="Stretch"/>
                        <Rectangle x:Name="PART_Overlay" Style="{TemplateBinding OverlayStyle}">
                            <Rectangle.Visibility>
                                <Binding Path="(ig:XamBusyIndicator.BusyIndicator).IsIndicatorVisible" RelativeSource="{RelativeSource Self}">
                                    <Binding.Converter>
                                        <BooleanToVisibilityConverter/>
                                    </Binding.Converter>
                                </Binding>
                            </Rectangle.Visibility>
                        </Rectangle>
                        <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="0" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Padding="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <TextElement.Foreground>
                                <Binding Path="Foreground" RelativeSource="{RelativeSource TemplatedParent}">
                                    <Binding.FallbackValue>
                                        <SolidColorBrush Color="Black"/>
                                    </Binding.FallbackValue>
                                </Binding>
                            </TextElement.Foreground>
                            <Border.Visibility>
                                <TemplateBinding Property="IsIndicatorVisible">
                                    <TemplateBinding.Converter>
                                        <BooleanToVisibilityConverter/>
                                    </TemplateBinding.Converter>
                                </TemplateBinding>
                            </Border.Visibility>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ContentPresenter Content="{TemplateBinding AnimationPresenter}"/>
                                <ContentPresenter x:Name="BusyContent" ContentTemplate="{TemplateBinding BusyContentTemplate}" Content="{TemplateBinding BusyContent}" ContentStringFormat="{TemplateBinding BusyContentStringFormat}" Margin="0,7,0,0" Grid.Row="1" Block.TextAlignment="Center">
                                    <!--<ContentPresenter.Visibility>
                                        <TemplateBinding Property="BusyContent">
                                            <TemplateBinding.Converter>
                                                <igPrim:NullableToVisibilityConverter/>
                                            </TemplateBinding.Converter>
                                        </TemplateBinding>
                                    </ContentPresenter.Visibility>-->
                                </ContentPresenter>
                                <TextBlock Text="{Binding DataContext.BusyContentCaption, RelativeSource={RelativeSource AncestorType=ig:XamBusyIndicator}}" FontSize="16" Foreground="White" FontWeight="SemiBold"  x:Name="TooLongText" Opacity="0" Margin="0" Grid.Row="2" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="IsBusyChanged">
                            <BeginStoryboard>
                                <Storyboard>
                                    <!--<DoubleAnimation Storyboard.TargetProperty="Opacity" Duration="0:0:0.2" From="0" To="1"/>
                                    <ObjectAnimationUsingKeyFrames BeginTime="0:0:0" Storyboard.TargetName="BusyContent"  Storyboard.TargetProperty="(UIElement.Visibility)">
                                        <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Hidden}"/>
                                        <DiscreteObjectKeyFrame KeyTime="0:0:30" Value="{x:Static Visibility.Visible}"/>
                                    </ObjectAnimationUsingKeyFrames>-->
                                    <DoubleAnimation Storyboard.TargetName="TooLongText" Storyboard.TargetProperty="Opacity" Duration="0:0:0.0" BeginTime="0:0:0" To="0"/>
                                    <DoubleAnimation Storyboard.TargetName="TooLongText" Storyboard.TargetProperty="Opacity" Duration="0:0:0.5" BeginTime="0:2:0" From="0" To="1"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Animation">
            <Setter.Value>
                <ig:SpinnerBallsBusyAnimation AnimationFill="White"/>
                <!--<ig:CustomBusyAnimation>
                    <ig:CustomBusyAnimation.DataTemplate>
                        <DataTemplate>
                            <ProgressBar Style="{StaticResource CustomProgressBar}"/>
                        </DataTemplate>
                    </ig:CustomBusyAnimation.DataTemplate>
                </ig:CustomBusyAnimation>-->
            </Setter.Value>
        </Setter>
        <Setter Property="OverlayStyle">
            <Setter.Value>
                <Style TargetType="{x:Type Rectangle}">
                    <Setter Property="Opacity" Value=".4"/>
                    <Setter Property="Fill" Value="Black"/>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="BusyContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <TextBlock  FontSize="16" Foreground="White" FontWeight="SemiBold" Margin="5">
                            <Run Text="{Binding Path=.}"/>
                        </TextBlock>
                        <Button  Content="Cancel Operation" Command="{Binding DataContext.BusyIndicatorCloseCommand, RelativeSource={RelativeSource AncestorType=ig:XamBusyIndicator}}" Padding="3" Margin="5" HorizontalAlignment="Center" Style="{StaticResource BusyIndicatorButton}"/>

                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--Alternative Busy Indicator Style-->
    <Style TargetType="ig:XamBusyIndicator" x:Key="BusyIndicatorAlt">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ig:XamBusyIndicator}">
                    <Grid Margin="0" SnapsToDevicePixels="True">
                        <ContentPresenter ContentTemplate="{TemplateBinding ContentTemplate}" Content="{TemplateBinding Content}" ContentStringFormat="{TemplateBinding ContentStringFormat}" HorizontalAlignment="Stretch" Margin="0" VerticalAlignment="Stretch"/>
                        <Rectangle x:Name="PART_Overlay" Style="{TemplateBinding OverlayStyle}">
                            <Rectangle.Visibility>
                                <Binding Path="(ig:XamBusyIndicator.BusyIndicator).IsIndicatorVisible" RelativeSource="{RelativeSource Self}">
                                    <Binding.Converter>
                                        <BooleanToVisibilityConverter/>
                                    </Binding.Converter>
                                </Binding>
                            </Rectangle.Visibility>
                        </Rectangle>
                        <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="0" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Padding="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <TextElement.Foreground>
                                <Binding Path="Foreground" RelativeSource="{RelativeSource TemplatedParent}">
                                    <Binding.FallbackValue>
                                        <SolidColorBrush Color="Black"/>
                                    </Binding.FallbackValue>
                                </Binding>
                            </TextElement.Foreground>
                            <Border.Visibility>
                                <TemplateBinding Property="IsIndicatorVisible">
                                    <TemplateBinding.Converter>
                                        <BooleanToVisibilityConverter/>
                                    </TemplateBinding.Converter>
                                </TemplateBinding>
                            </Border.Visibility>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ContentPresenter x:Name="BusyContent" ContentTemplate="{TemplateBinding BusyContentTemplate}" Content="{TemplateBinding BusyContent}" ContentStringFormat="{TemplateBinding BusyContentStringFormat}" Margin="0,7,0,0" Grid.Row="1" Block.TextAlignment="Center"/>
                                <ContentPresenter Content="{TemplateBinding AnimationPresenter}"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="IsBusyChanged">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" Duration="0:0:0.2" From="0" To="1"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Animation">
            <Setter.Value>
                <ig:CustomBusyAnimation>
                    <ig:CustomBusyAnimation.DataTemplate>
                        <DataTemplate>
                            <ProgressBar Style="{StaticResource CustomProgressBar}"/>
                        </DataTemplate>
                    </ig:CustomBusyAnimation.DataTemplate>
                </ig:CustomBusyAnimation>
            </Setter.Value>
        </Setter>
        <Setter Property="OverlayStyle">
            <Setter.Value>
                <Style TargetType="{x:Type Rectangle}">
                    <Setter Property="Opacity" Value=".75"/>
                    <Setter Property="Fill" Value="Black"/>
                </Style>
            </Setter.Value>
        </Setter>

    </Style>

