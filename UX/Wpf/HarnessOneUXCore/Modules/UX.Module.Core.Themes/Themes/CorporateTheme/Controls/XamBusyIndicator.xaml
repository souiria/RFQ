    <Storyboard x:Key="LoaderAnimationOne">
        <ThicknessAnimationUsingKeyFrames Storyboard.TargetProperty="Margin" 
                                           Storyboard.TargetName="BlipOne" 
                                           RepeatBehavior="Forever" BeginTime="0:0:0" Duration="0:0:1.6">
            <EasingThicknessKeyFrame KeyTime="0:0:0" Value="15,230,15,0"/>
            <EasingThicknessKeyFrame KeyTime="0:0:0.4" Value="15,0,15,0">
                <EasingThicknessKeyFrame.EasingFunction>
                    <CircleEase EasingMode="EaseInOut"/>
                </EasingThicknessKeyFrame.EasingFunction>
            </EasingThicknessKeyFrame>
            <EasingThicknessKeyFrame KeyTime="0:0:0.8" Value="15,0,15,230">
                <EasingThicknessKeyFrame.EasingFunction>
                    <CircleEase EasingMode="EaseInOut"/>
                </EasingThicknessKeyFrame.EasingFunction>
            </EasingThicknessKeyFrame>
            <EasingThicknessKeyFrame KeyTime="0:0:1.2" Value="15,0,15,0">
                <EasingThicknessKeyFrame.EasingFunction>
                    <CircleEase EasingMode="EaseInOut"/>
                </EasingThicknessKeyFrame.EasingFunction>
            </EasingThicknessKeyFrame>
            <EasingThicknessKeyFrame KeyTime="0:0:1.6" Value="15,230,15,0">
                <EasingThicknessKeyFrame.EasingFunction>
                    <CircleEase EasingMode="EaseInOut"/>
                </EasingThicknessKeyFrame.EasingFunction>
            </EasingThicknessKeyFrame>
        </ThicknessAnimationUsingKeyFrames>
    </Storyboard>

    <Storyboard x:Key="LoaderAnimationTwo">
        <ThicknessAnimationUsingKeyFrames Storyboard.TargetProperty="Margin" 
                                           Storyboard.TargetName="BlipTwo" 
                                           RepeatBehavior="Forever" BeginTime="0:0:0.1" Duration="0:0:1.6">
            <EasingThicknessKeyFrame KeyTime="0:0:0" Value="15,230,15,0"/>
            <EasingThicknessKeyFrame KeyTime="0:0:0.4" Value="15,0,15,0">
