<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <SolidColorBrush x:Key="Item.Unselected.Background" Color="{Binding Color, Source={StaticResource Primary}}" Opacity="0.5"/>
    <SolidColorBrush x:Key="Item.MouseOver.Background" Color="{Binding Color, Source={StaticResource MouseOverHighlights}}" Opacity="0.2"/>
    <SolidColorBrush x:Key="Item.SelectedInactive.Background" Color="{Binding Color, Source={StaticResource Secondary}}" Opacity="0.3"/>
    <SolidColorBrush x:Key="Item.SelectedActive.Background" Color="{Binding Color, Source={StaticResource MouseOverHighlights}}" Opacity="0.5"/>

    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="2" SnapsToDevicePixels="true" Stroke="{DynamicResource Highlights}" StrokeThickness="1" StrokeDashArray="1 2"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ListBoxItem}">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="HorizontalContentAlignment" Value="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"/>
        <Setter Property="VerticalContentAlignment" Value="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="Bd" Background="{StaticResource Primary}" BorderThickness="1" BorderBrush="{DynamicResource TransparentColor}" SnapsToDevicePixels="true" CornerRadius="2" Margin="1" TextBlock.Foreground="{DynamicResource TextColor}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource MouseOverPrimary}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Highlights}"/>
                            <Setter TargetName="Bd" Property="TextBlock.Foreground" Value="{StaticResource MouseOverText}"/>
                        </Trigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PressedPrimary}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource LightHighlights}"/>
                            <Setter TargetName="Bd" Property="TextBlock.Foreground" Value="{StaticResource PressedText}"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="TextElement.Foreground" TargetName="Bd" Value="{StaticResource Disabled}"/>
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>