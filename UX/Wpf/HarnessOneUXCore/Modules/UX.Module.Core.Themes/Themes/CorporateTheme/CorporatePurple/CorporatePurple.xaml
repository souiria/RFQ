<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:PresentationOptions="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:igOutlookBar="http://infragistics.com/OutlookBar">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/UX.Core.Themes;component/Themes/CorporateTheme/Brushes/SumitomoPalette.xaml"/>

        <ResourceDictionary Source="/UX.Core.Themes;component/Themes/CorporateTheme/Controls/ButtonStyles.xaml"/>
        <ResourceDictionary Source="/UX.Core.Themes;component/Themes/CorporateTheme/Controls/LabelStyles.xaml"/>
        <ResourceDictionary Source="/UX.Core.Themes;component/Themes/CorporateTheme/Controls/ListBox.xaml"/>
        <ResourceDictionary Source="/UX.Core.Themes;component/Themes/CorporateTheme/Controls/ScrollBar.xaml"/>
        <ResourceDictionary Source="/UX.Core.Themes;component/Themes/CorporateTheme/Controls/XamBusyIndicator.xaml"/>
        <ResourceDictionary Source="/UX.Core.Themes;component/Themes/CorporateTheme/Controls/XamDataChart.xaml"/>
        <ResourceDictionary Source="/UX.Core.Themes;component/Themes/CorporateTheme/Controls/XamDataGrid.xaml"/>
        <ResourceDictionary Source="/UX.Core.Themes;component/Themes/CorporateTheme/Controls/XamDataTree.xaml"/>
        <ResourceDictionary Source="/UX.Core.Themes;component/Themes/CorporateTheme/Controls/XamDockManager.xaml"/>
        <ResourceDictionary Source="/UX.Core.Themes;component/Themes/CorporateTheme/Controls/XamDialogWindow.xaml"/>
        <ResourceDictionary Source="/UX.Core.Themes;component/Themes/CorporateTheme/Controls/XamGauges.xaml"/>
        <ResourceDictionary Source="/UX.Core.Themes;component/Themes/CorporateTheme/Controls/XamGrid.xaml"/>
        <ResourceDictionary Source="/UX.Core.Themes;component/Themes/CorporateTheme/Controls/XamOutlookBar.xaml"/>
        <ResourceDictionary Source="/UX.Core.Themes;component/Themes/CorporateTheme/Controls/XamRibbon.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- DEVIATIONS 
    This Theme Deviates from the default theme setup at:
    -->

    <!--Colors Unique to this theme-->

    <!--Base-->
    <SolidColorBrush x:Key="White" Color="{Binding Color, Source={StaticResource WhiteColor}}"/>
    <SolidColorBrush x:Key="Black" Color="{Binding Color, Source={StaticResource BlackColor}}"/>
    <SolidColorBrush x:Key="Transparent" Color="{Binding Color, Source={StaticResource TransparentColor}}"/>
    <SolidColorBrush x:Key="Shadows" Color="#19000000"/>

    <!--Backgrounds of docks and H1 Background image-->
    <ImageBrush x:Key="BackgroundImage" ImageSource="pack://application:,,,/Common.UX;component/Resources/Images/GP_Purple.png" Stretch="UniformToFill"/>
    <SolidColorBrush x:Key="Background" Color="{Binding Color, Source={StaticResource WhiteColor}}"/>
    <!--Negative of Background-->
    <SolidColorBrush x:Key="Negative" Color="{Binding Color, Source={StaticResource BlackColor}}"/>

    <!--Background of controls-->
    <SolidColorBrush x:Key="Primary" Color="{Binding Color, Source={StaticResource WhiteColor}}"/>
    <SolidColorBrush x:Key="MouseOverPrimary" Color="{Binding Color, Source={StaticResource GreyColor_5%}}"/>
    <SolidColorBrush x:Key="PressedPrimary" Color="{Binding Color, Source={StaticResource SumitomoPurple}}"/>

    <!--Background of secondary controls-->
    <SolidColorBrush x:Key="Secondary" Color="{Binding Color, Source={StaticResource GreyColor_10%}}"/>
    <SolidColorBrush x:Key="MouseOverSecondary" Color="{Binding Color, Source={StaticResource GreyColor_20%}}"/>
    <SolidColorBrush x:Key="PressedSecondary" Color="{Binding Color, Source={StaticResource SumitomoPurple_80%}}"/>

    <!--Darker Background-->
    <SolidColorBrush x:Key="Tertiary" Color="{Binding Color, Source={StaticResource GreyColor_50%}}"/>
    <SolidColorBrush x:Key="MouseOverTertiary" Color="{Binding Color, Source={StaticResource GreyColor_60%}}"/>
    <SolidColorBrush x:Key="PressedTertiary" Color="{Binding Color, Source={StaticResource SumitomoPurple_40%}}"/>

    <!--Borders and overlay colors of controls-->
    <SolidColorBrush x:Key="LightHighlights" Color="{Binding Color, Source={StaticResource SumitomoPurple_20%}}"/>
    <SolidColorBrush x:Key="Highlights" Color="{Binding Color, Source={StaticResource SumitomoPurple}}"/>
    <SolidColorBrush x:Key="MouseOverHighlights" Color="{Binding Color, Source={StaticResource SumitomoPurple_60%}}"/>
    <SolidColorBrush x:Key="PressedHighlights" Color="{Binding Color, Source={StaticResource SumitomoPurple_80%}}"/>

    <!--Text Colors on controls. Labels will stay Black-->
    <SolidColorBrush x:Key="TextColor" Color="{Binding Color, Source={StaticResource Black}}"/>
    <SolidColorBrush x:Key="MouseOverText" Color="{Binding Color, Source={StaticResource SumitomoPurple}}"/>
    <SolidColorBrush x:Key="PressedText" Color="{Binding Color, Source={StaticResource WhiteColor}}"/>

    <!--Disabled Colors/Errors-->
    <SolidColorBrush x:Key="LightDisabled" Color="{Binding Color, Source={StaticResource SumitomoGrey_60%}}"/>
    <SolidColorBrush x:Key="Disabled" Color="{Binding Color, Source={StaticResource SumitomoGrey_80%}}"/>
    <SolidColorBrush x:Key="DarkDisabled" Color="{Binding Color, Source={StaticResource SumitomoGrey}}"/>
    <SolidColorBrush x:Key="Errored" Color="#FFD20000"/>
    <SolidColorBrush x:Key="Success" Color="#FF44B034"/>

    <!-- XamOutlookBar Colors-->
    <SolidColorBrush x:Key="MouseOverMinimizeButtonBackground" Color="{Binding Color, Source={StaticResource Primary}}" Opacity=".2"/>

    <!--RibbonTab Colors-->
    <SolidColorBrush x:Key="RibbonTabItemBackground" Color="{Binding Color, Source={StaticResource Primary}}"/>
    <SolidColorBrush x:Key="RibbonTabItemBorder" Color="{Binding Color, Source={StaticResource Highlights}}"/>

    <!--RibbonGroup Colors-->
    <SolidColorBrush x:Key="RibbonGroupBorder" Color="{Binding Color, Source={StaticResource Highlights}}"/>
    <SolidColorBrush x:Key="RibbonGroupBackground" Color="{Binding Color, Source={StaticResource Primary}}" Opacity=".8"/>
    <SolidColorBrush x:Key="RibbonGroupHeader" Color="{Binding Color, Source={StaticResource Highlights}}" Opacity=".8"/>

    <!--ListBox Colors-->
    <SolidColorBrush x:Key="ListBoxBackground" Color="{Binding Color, Source={StaticResource Primary}}" Opacity=".5"/>


    <!--ListViewItem Colors-->
    <SolidColorBrush x:Key="MouseOverListViewItemBackground" Color="{Binding Color, Source={StaticResource MouseOverHighlights}}" Opacity=".5"/>
    <SolidColorBrush x:Key="InactiveSelectedListViewItemBackground" Color="{Binding Color, Source={StaticResource MouseOverHighlights}}" Opacity=".5"/>
    <SolidColorBrush x:Key="ActiveSelectedListViewItemBackground" Color="{Binding Color, Source={StaticResource PressedHighlights}}" Opacity=".5"/>

    <!--Button Colors-->
    <SolidColorBrush x:Key="MouseOverButtonColor" Color="{Binding Color, Source={StaticResource Highlights}}"/>
    <SolidColorBrush x:Key="MouseOverButtonOverlayWhite" Color="{Binding Color, Source={StaticResource WhiteColor}}" Opacity=".2"/>
    <SolidColorBrush x:Key="PressedButtonOverlayWhite" Color="{Binding Color, Source={StaticResource WhiteColor}}" Opacity=".4"/>

    <!--Notifcation Button Colors-->
    <SolidColorBrush x:Key="NotificationButtonNotifyBubbleBackground" Color="{Binding Color, Source={StaticResource LightHighlights}}"/>
    <SolidColorBrush x:Key="NotificationButtonNotifyBubbleBorder" Color="{Binding Color, Source={StaticResource Primary}}"/>

    <!--XamDockManager Colors-->
    <SolidColorBrush x:Key="ContentPaneBackground" Color="{Binding Color, Source={StaticResource Primary}}" Opacity=".7"/>
    <SolidColorBrush x:Key="UnselectedTabItemText" Color="{Binding Color, Source={StaticResource TextColor}}" Opacity=".5"/>
    <SolidColorBrush x:Key="SelectedTabItemText" Color="{Binding Color, Source={StaticResource TextColor}}" />
    <SolidColorBrush x:Key="MouseOverTabItemText" Color="{Binding Color, Source={StaticResource MouseOverText}}" />

    <!--XamDataGrid Colors-->
    <SolidColorBrush x:Key="ActiveDataRecordCellAreaBackground" Color="{Binding Color, Source={StaticResource Transparent}}" />
    <SolidColorBrush x:Key="MouseOverDataRecordCellAreaBackground" Color="{Binding Color, Source={StaticResource MouseOverHighlights}}" Opacity=".2" />
    <SolidColorBrush x:Key="MouseOverDataRecordCellAreaBorder" Color="{Binding Color, Source={StaticResource Transparent}}"/>
    <SolidColorBrush x:Key="SelectedDataRecordCellAreaBackground" Color="{Binding Color, Source={StaticResource MouseOverHighlights}}" Opacity=".4"/>
    <SolidColorBrush x:Key="SelectedDataRecordCellAreaBorder" Color="{Binding Color, Source={StaticResource MouseOverHighlights}}"/>
    <SolidColorBrush x:Key="DataRecordCellAreaBackground" Color="{Binding Color, Source={StaticResource Transparent}}"/>
    <SolidColorBrush x:Key="DataRecordCellAreaBorder" Color="{Binding Color, Source={StaticResource Transparent}}"/>
    <SolidColorBrush x:Key="AlternativeDataRecordCellAreaBackground" Color="{Binding Color, Source={StaticResource Primary}}" Opacity=".2"/>
    <SolidColorBrush x:Key="CRUDUpdateDataRecordCellAreaBackground" Color="{Binding Color, Source={StaticResource LightHighlights}}" Opacity=".7"/>
    <SolidColorBrush x:Key="CRUDDeleteDataRecordCellAreaBackground" Color="{Binding Color, Source={StaticResource Errored}}" Opacity=".7"/>
    <SolidColorBrush x:Key="CRUDCreateDataRecordCellAreaBackground" Color="{Binding Color, Source={StaticResource Success}}" Opacity=".7"/>

    <!--OutlookBar Overriden Colors-->
    <SolidColorBrush PresentationOptions:Freeze="true" x:Key="{x:Static igOutlookBar:OutlookBarBrushKeys.XamOutlookBarOuterBorderFillKey}" Color="{Binding Color, Source={StaticResource TransparentColor}}"/>
    <SolidColorBrush PresentationOptions:Freeze="true" x:Key="{x:Static igOutlookBar:OutlookBarBrushKeys.CurrentGroupHeaderCenterFillKey}" Color="{Binding Color,Source={StaticResource Primary}}"/>
    <SolidColorBrush PresentationOptions:Freeze="true" x:Key="{x:Static igOutlookBar:OutlookBarBrushKeys.HeaderDarkTextFillKey}" Color="{Binding Color, Source={StaticResource PressedText}}"/>
    <SolidColorBrush x:Key="{x:Static igOutlookBar:OutlookBarBrushKeys.NavigationGroupHeaderActiveCenterFillKey}" Color="{Binding Color, Source={StaticResource Highlights}}"/>
    <SolidColorBrush x:Key="{x:Static igOutlookBar:OutlookBarBrushKeys.NavigationGroupHeaderNormalCenterFillKey}" Color="{Binding Color, Source={StaticResource Primary}}"/>
    <SolidColorBrush x:Key="{x:Static igOutlookBar:OutlookBarBrushKeys.NavigationGroupHeaderHottrackCenterFillKey}" Color="{Binding Color, Source={StaticResource LightHighlights}}"/>
    <SolidColorBrush x:Key="{x:Static igOutlookBar:OutlookBarBrushKeys.NavigationGroupHeaderPressedCenterFillKey}" Color="{Binding Color, Source={StaticResource MouseOverHighlights}}"/>

</ResourceDictionary>