<UserControl x:Class="SEWSE.H1.UX.Module.Core.Dashboard.Views.Dashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1440"  Tag="Dashboard">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding PageLoadedCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <Image Source="pack://application:,,,/Common.UX;component/Resources/Images/technology-main.png" Opacity="0.75" HorizontalAlignment="Center" VerticalAlignment="Bottom" Stretch="UniformToFill" />
        <TextBlock Text="Welcome to Harness One" FontSize="36" HorizontalAlignment="Center" Foreground="#FFF7F7F7" Margin="0,50,0,0">
            <TextBlock.Effect>
                <DropShadowEffect Color="#FF03468B" Opacity="1" ShadowDepth="1"/>
            </TextBlock.Effect>
        </TextBlock>
    </Grid>
</UserControl>
