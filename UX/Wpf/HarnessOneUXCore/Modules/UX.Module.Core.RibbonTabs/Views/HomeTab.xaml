<igWpf:RibbonTabItem x:Class="SEWSE.H1.UX.Module.Core.RibbonTabs.Views.HomeTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"  
             xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
             xmlns:igWpf="http://schemas.infragistics.com/xaml/wpf"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Header="{Binding HomeLabel}" TabIndex="0">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding PageLoadedCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <igWpf:RibbonGroup Id="Text Style" Caption="QAT Items" Visibility="Collapsed">
        <igWpf:ToolHorizontalWrapPanel>
            <igWpf:ButtonGroup>
                <igWpf:ButtonTool
                            Content="Max"
                            IsQatCommonTool="True"
                            Id="maximizeTool"
                            ToolTip="{Binding MaxMinButtonTooltip}"
                            SmallImage="{Binding MaxMinButtonImage}"
                            Command="{Binding MaxMinButtonClickCommand}"
                            />
                <igWpf:ButtonTool
                            Content="Undo"
                            IsQatCommonTool="True"
                            Id="undoTool"
                            SmallImage="pack://application:,,,/Common.UX;component/Resources/Images/UndoBlue16.png"/>
                <igWpf:ButtonTool
                            Content="Redo"
                            IsQatCommonTool="True"
                            Id="redoTool"
                            SmallImage="pack://application:,,,/Common.UX;component/Resources/Images/RedoBlue16.png"/>
                <igWpf:ButtonTool
                            Content="Copy"
                            IsQatCommonTool="True"
                            Id="copyTool"
                            SmallImage="pack://application:,,,/Common.UX;component/Resources/Images/Copy16.png"/>
                <igWpf:ButtonTool
                            Content="Cut"
                            IsQatCommonTool="True"
                            Id="cutTool"
                            SmallImage="pack://application:,,,/Common.UX;component/Resources/Images/CutBlue16.png"/>
            </igWpf:ButtonGroup>
        </igWpf:ToolHorizontalWrapPanel>
    </igWpf:RibbonGroup>
    <igWpf:RibbonGroup Id="Notifications" Caption="{Binding NotificationLabel}">
        <Button Background="White" Content="{Binding Notifications}" Margin="10" FontWeight="Thin" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" 
                    Style="{DynamicResource NotificationButtonStyle}" Command="{Binding OpenNotificationsCommand}"/>
       
    </igWpf:RibbonGroup>
    <igWpf:RibbonGroup Id="H1UserManual" Caption="{Binding H1UserManualLabel}">
        <Button Background="White"  Margin="10" FontWeight="Thin" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" 
                    Style="{DynamicResource UserManualButtonStyle}" Command="{Binding OpenUserManualCommand}"/>

    </igWpf:RibbonGroup>
    <igWpf:RibbonGroup Id="UAT" Caption="Running on UAT" HorizontalAlignment="Center" Margin="0">
        <Label Content="===Currently Running in Test Environment===" FontSize="34"/>
        <igWpf:RibbonGroup.Style>
            <Style TargetType="igWpf:RibbonGroup">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsUAT}" Value="true">
                        <Setter Property="igWpf:RibbonGroup.Visibility" Value="Visible"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsUAT}" Value="false">
                        <Setter Property="igWpf:RibbonGroup.Visibility" Value="Hidden"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </igWpf:RibbonGroup.Style>

    </igWpf:RibbonGroup>
</igWpf:RibbonTabItem>
