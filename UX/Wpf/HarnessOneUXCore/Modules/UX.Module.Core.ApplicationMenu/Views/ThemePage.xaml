            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>

    </UserControl.Resources>

    <Grid x:Name="ThemePageGrid"
          Width="Auto">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <igWin:XamCarouselListBox x:Name="themeCarouselBox"
                                  ItemsSource="{Binding HarnessOneThemes}"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch"
                                  VerticalContentAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Margin="0,10,0,0"
                                  Padding="10"
                                  SelectedIndex="{Binding Path=SelectedThemeIndex, UpdateSourceTrigger=PropertyChanged}">
            <igWin:XamCarouselListBox.ItemTemplate>
                <DataTemplate>
                    <Button x:Name="btnSelect"
                            Command="{Binding Path=DataContext.ThemeClickCommand, ElementName=themeCarouselBox}"
                            CommandParameter="{Binding Path=ThemeName}"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Image Source="{Binding Path=ThemePreviewSource}"                          
                                   Stretch="Fill"
                                   Width="350"
                                   Height="200"
                                   VerticalAlignment="Stretch"
                                   Margin="0"
                                   HorizontalAlignment="Center"/>
                            <TextBlock
                                   Text="{Binding Path=ThemeName}"
                                   FontSize="12"
                                   Height="25"
                                   Width="Auto"
                                   VerticalAlignment="Bottom"
                                   HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </igWin:XamCarouselListBox.ItemTemplate>
            <igWin:XamCarouselListBox.ViewSettings>
                <igWin:CarouselViewSettings AutoScaleItemContentsToFit="True" CarouselPanelNavigatorStyle="{StaticResource customNavigator}"
                                            ItemPath="{Binding ElementName=customPath, Mode=OneWay}"
                                            ItemPathHorizontalAlignment="Stretch"
                                            ItemPathVerticalAlignment="Stretch"
                                            ItemSize="700,700"
                                            ItemTransitionStyle="AdjustOpacity"
                                            UseOpacity="True"
                                            UseSkewing="True"
                                            UseZOrder="True"
                                            IsListContinuous="True"
                                            ItemsPerPage="5"
                                            ItemPathAutoPad="False"
                                            ItemPathPadding="0,0,0,70"
                                            ScalingEffectStopDirection="UseItemPath"
                                            UseScaling="True"
                                            AllowDrop="True" 
                                            x:Name="ThemePageCarouselView">
                    <igWin:CarouselViewSettings.ScalingEffectStops>
                        <igWin:ScalingEffectStop Offset="0.0"
                                                     Value="0.4" />
                        <igWin:ScalingEffectStop Offset="0.4"
                                                     Value="0.4" />
                        <igWin:ScalingEffectStop Offset="0.5"
                                                     Value="0.8" />
                        <igWin:ScalingEffectStop Offset="0.6"
                                                     Value="0.4" />
                        <igWin:ScalingEffectStop Offset="1.0"
                                                     Value="0.4" />
                    </igWin:CarouselViewSettings.ScalingEffectStops>
                    <igWin:CarouselViewSettings.OpacityEffectStops>
                        <igWin:OpacityEffectStop Offset=".15"
                                                     Value="1" />
                        <igWin:OpacityEffectStop Offset=".5"
                                                     Value="1.0" />
                        <igWin:OpacityEffectStop Offset=".85"
                                                     Value="1" />
                    </igWin:CarouselViewSettings.OpacityEffectStops>
                    <igWin:CarouselViewSettings.SkewAngleYEffectStops>
                        <igWin:SkewAngleYEffectStop Offset="0.15"
                                                        Value="-20" />
                        <igWin:SkewAngleYEffectStop Offset="0.45"
                                                        Value="-20" />
                        <igWin:SkewAngleYEffectStop Offset="0.5"
                                                        Value="0" />
                        <igWin:SkewAngleYEffectStop Offset="0.55"
                                                        Value="20" />
                        <igWin:SkewAngleYEffectStop Offset="0.85"
                                                        Value="20" />
                    </igWin:CarouselViewSettings.SkewAngleYEffectStops>
                    <igWin:CarouselViewSettings.ZOrderEffectStops>
                        <igWin:ZOrderEffectStop />
                        <igWin:ZOrderEffectStop Offset="0.5"
                                                    Value="1" />
                        <igWin:ZOrderEffectStop Offset="1" />
                    </igWin:CarouselViewSettings.ZOrderEffectStops>
                </igWin:CarouselViewSettings>
            </igWin:XamCarouselListBox.ViewSettings>

        </igWin:XamCarouselListBox>

        <Path Fill="#FFFFFFFF"
              Stretch="Fill"
              Stroke="#FF000000"
              Margin="7.5,100.5,-0.5,0"
              x:Name="customPath"
              VerticalAlignment="Top"
              Height="10"
              Data="M8,152 L400,152"
              Visibility="Hidden" />
