<igWpf:ApplicationMenu2010
             x:Class="SEWSE.H1.UX.Module.Core.ApplicationMenu.Views.ApplicationMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:igWpf="http://schemas.infragistics.com/xaml/wpf"
             xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:views="clr-namespace:SEWSE.H1.UX.Module.Core.ApplicationMenu.Views"
             prism:ViewModelLocator.AutoWireViewModel="True" 
             Caption="{Binding MenuLabel}" prism:RegionManager.RegionName="ApplicationMenuRegion">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding PageLoadedCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
        <igWpf:ApplicationMenu2010.Resources>
            <Style TargetType="{x:Type ScrollViewer}">
                <Setter Property="HorizontalScrollBarVisibility" Value="Hidden"/>
            </Style>
        </igWpf:ApplicationMenu2010.Resources>
        <igWpf:ApplicationMenu2010Item KeyTip="A" Header="About">
            <igWpf:ApplicationMenu2010Item.Content>
                <views:About/>
            </igWpf:ApplicationMenu2010Item.Content>
        </igWpf:ApplicationMenu2010Item>
