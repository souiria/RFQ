<Window x:Class="SEWSE.H1.UX.Module.Core.ErrorWindow.Views.Error"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SEWSE.H1.UX.Module.Core.ErrorWindow.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
             mc:Ignorable="d" WindowStartupLocation="CenterScreen"
             ResizeMode="NoResize" BorderBrush="{StaticResource SumitomoBlue}"
             d:DesignHeight="300" d:DesignWidth="300"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding PageLoadedCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <DockPanel IsEnabled="{Binding IsWindowEnabled}">
            <TextBlock Text="Something went wrong..." DockPanel.Dock="Top" FontSize="30" FontWeight="Thin" Margin="10" 
                       HorizontalAlignment="Center" Foreground="{StaticResource SumitomoBlue}"/>
            <TextBlock Text="An error occured while starting the application. If this error persists, please contact an administrator." 
                   TextWrapping="Wrap" TextAlignment="Center" Margin="10" DockPanel.Dock="Top"/>

            <Border Margin="20" Background="{StaticResource SumitomoGrey_20%}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding ExceptionText}" TextWrapping="Wrap" Margin="10"/>
                    </ScrollViewer>
                    <Button  Grid.Row="1" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="10" Command="{Binding OpenRollbackMenuCommand}">
                        <TextBlock Text="Advanced" FontSize="12"/>
                    </Button>
                </Grid>
            </Border>
        </DockPanel>
        <Border BorderThickness="1" BorderBrush="{StaticResource SumitomoBlue}" Width="300" Height="200" Background="White" CornerRadius="2" Visibility="{Binding RollbackMenuVisibility}">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="2" Text="Rollback to a previous version:" Margin="2"/>
                <ComboBox Grid.Row="1" Margin="2" SelectedItem="{Binding SelectedVersion}" ItemsSource="{Binding ReleaseVersions}" DisplayMemberPath="Filename"/>
                <StackPanel  Margin="2,5">
                    <TextBlock Text="Current Version: " Margin="2"/>
                    <TextBlock Text="{Binding CurrentVersion}" Margin="2"/>
                </StackPanel>                
                <Grid  Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Button Content="Ok" VerticalAlignment="Center" Margin="5" MaxWidth="200" Command="{Binding RollbackOkCommand}"/>
                    <Button Grid.Column="1" Content="Cancel" VerticalAlignment="Center" Margin="5" MaxWidth="200" Command="{Binding RollbackCancelCommand}"/>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</Window>
