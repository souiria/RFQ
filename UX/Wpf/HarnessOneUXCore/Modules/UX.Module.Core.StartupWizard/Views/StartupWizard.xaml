<Window x:Class="SEWSE.H1.UX.Module.Core.StartupWizard.Views.StartupWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="True"
        WindowStyle="SingleBorderWindow"       
        WindowStartupLocation="CenterScreen"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d" x:Name="WizardMain"
        Title="Harness One"
        xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
        xmlns:helpers="clr-namespace:Common.UX.Wpf.Helpers;assembly=Common.UX.Wpf"
        d:DesignHeight="540" d:DesignWidth="960"
        BorderBrush="{DynamicResource Highlights}" BorderThickness="0,1,0,0" >
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding PageLoadedCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>        
        <ContentControl prism:RegionManager.RegionName="{x:Static helpers:RegionNames.WizardRegion}"/>
        <!--<Button x:Name="CloseButton" Height="25" Width="25" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="10" Style="{DynamicResource ButtonDefault}"
                Command="{Binding CloseCommand}">
            <Viewbox Margin="5">
                <Path Data="M0,0 L10,10 M10,0 L0,10" StrokeThickness="1" Stroke="{Binding Foreground, ElementName=CloseButton}"/>
            </Viewbox>
        </Button>-->
    </Grid>
    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" Storyboard.TargetName="WizardMain" From="0" To="1" Duration="0:0:0.8"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
