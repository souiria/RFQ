<UserControl x:Class="SEWSE.H1.UX.Shell.Views.CustomConfirmation"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 mc:Ignorable="d"    
			 d:DesignHeight="300"
			 d:DesignWidth="500">
    <UserControl.Resources>
        <!--<Style x:Key="DialogBorderBackground"
			   TargetType="{x:Type Border}">
            <Setter Property="Background"
					Value="#0075C1"></Setter>
            <Setter Property="BorderBrush"
					Value="Transparent"></Setter>
        </Style>
        <Style x:Key="TextBlockFont"
			   TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground"
					Value="#598CF7"></Setter>
        </Style>-->
    </UserControl.Resources>
    <Border BorderThickness="2" 
            BorderBrush="{DynamicResource Highlights}" 
            Background="{DynamicResource Primary}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>
            <!--Title-->
            <Border Background="{DynamicResource Highlights}">
                <TextBlock Foreground="{DynamicResource Primary}"
                                x:Name="txtBlockHeader"
										VerticalAlignment="Center"										
										HorizontalAlignment="Left"
										FontSize="14"
										FontWeight="SemiBold"
										Margin="10"										
										Text="Confirmation" />
            </Border>
            <!--Content-->
            <!--Background="AliceBlue"-->
            <Grid Grid.Row="1" Margin="5" VerticalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Image x:Name="imgErrorMessage"
								   Height="30"
								   Width="30"
                                   Source="pack://application:,,,/Common.UX;component/Resources/Images/Dialog/Help_Dialog.png"
								   HorizontalAlignment="Center"
								   VerticalAlignment="Top"
								   Margin="10" />
                <ScrollViewer Grid.Column="1" Margin="12" VerticalScrollBarVisibility="Auto">
                    <TextBlock FontSize="14" Foreground="{DynamicResource TextColor}" TextWrapping="Wrap" 
                                    x:Name="txtBlockErrorMessage" Width="300"/>
                </ScrollViewer>
            </Grid>
            <!--Button-->
            <Border  Grid.Row="3">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!--<Image x:Name="imgFooter" Grid.Column="0"  Height="20" Width="20"  Source="/Common.UX;component/Resources/Images/Dialog/Help_Dialog_32.png" HorizontalAlignment="Left" Margin="10,0,0,0"/>-->
                    <!--<TextBlock Grid.Column="1" 
                                           HorizontalAlignment="Left" 
                                           VerticalAlignment="Center" 
                                           Foreground="{DynamicResource Negative}"
                                           FontWeight="DemiBold"  
                                           Margin="0,0,0,0"                                            
                                           Text="!! Confirmation !!"   />-->
                    <Button  Style="{DynamicResource ButtonDefaultRounded}"
										x:Name="btnOk"
										Width="70"
										Height="25"
										Margin="4"										
										IsDefault="True"
										HorizontalAlignment="Right"
										Content="Yes"
										Command="{Binding YesCommand}">
                        <!--<Button.Template>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border x:Name="bdr_btnYes"
													CornerRadius="5"
													Background="#888888">
                                                <ContentPresenter VerticalAlignment="Center"
																  HorizontalAlignment="Center"
																  ContentSource="Content" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver"
														 Value="True">
                                                    <Setter TargetName="bdr_btnYes"
															Property="Background"
															Value="#66B77C" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>-->
                    </Button>
                    <Button Style="{DynamicResource ButtonDefaultRounded}"
										x:Name="btnNo"
										Width="70"
										Height="25"
										Margin="4"										
										IsCancel="True"
										HorizontalAlignment="Right"
										Content="No"
										Command="{Binding NoCommand}">
                        <!--<Button.Template>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border x:Name="bdr_btnNo"
													CornerRadius="5"
													Background="#888888">
                                                <ContentPresenter VerticalAlignment="Center"
																  HorizontalAlignment="Center"
																  ContentSource="Content" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver"
														 Value="True">
                                                    <Setter TargetName="bdr_btnNo"
															Property="Background"
															Value="#66B77C" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>-->
                    </Button>
                    <Button Style="{DynamicResource ButtonDefaultRounded}"
										x:Name="btnCancel"
										Width="70"
										Height="25"
										Margin="4"																				
										IsCancel="True"
										HorizontalAlignment="Right"
										Content="Cancel"
										Click="btnCancel_Click">
                        <!--<Button.Template>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border x:Name="bdr_btnNo"
													CornerRadius="5"
													Background="#888888">
                                                <ContentPresenter VerticalAlignment="Center"
																  HorizontalAlignment="Center"
																  ContentSource="Content" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver"
														 Value="True">
                                                    <Setter TargetName="bdr_btnNo"
															Property="Background"
															Value="#66B77C" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>-->
                    </Button>
                    <Button Style="{DynamicResource ButtonDefaultRounded}"
										x:Name="btnOnlyOk"
										Width="70"
										Height="25"
										Margin="4"																				
										IsCancel="True"
										HorizontalAlignment="Right"
										Content="Ok"
										Click="btnCancel_Click">
                        <!--<Button.Template>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border x:Name="bdr_btnNo"
													CornerRadius="5"
													Background="#888888">
                                                <ContentPresenter VerticalAlignment="Center"
																  HorizontalAlignment="Center"
																  ContentSource="Content" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver"
														 Value="True">
                                                    <Setter TargetName="bdr_btnNo"
															Property="Background"
															Value="#66B77C" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>-->
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
