<igWpf:XamRibbonWindow x:Class="SEWSE.H1.UX.Shell.Views.Shell"
					   xmlns:igWpf="http://schemas.infragistics.com/xaml/wpf"
					   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					   xmlns:intr="http://schemas.microsoft.com/expression/2010/interactivity"
					   Title="{Binding AppTitle, UpdateSourceTrigger=PropertyChanged}"
					   Height="600"
					   Width="1024"
					   xmlns:prism="http://www.codeplex.com/prism"
					   prism:ViewModelLocator.AutoWireViewModel="True"
					   xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
					   xmlns:ig="http://schemas.infragistics.com/xaml"
					   xmlns:localviews="clr-namespace:SEWSE.H1.UX.Shell.Views"
					   xmlns:helpers="clr-namespace:Common.UX.Wpf.Helpers;assembly=Common.UX.Wpf"
					   WindowStartupLocation="CenterScreen"
					   WindowState="Maximized">
    <igWpf:XamRibbonWindow.Resources>
        <Style TargetType="{x:Type Window}"
			   x:Key="DialogWin">
            <Setter Property="WindowStyle"
					Value="None" />
            <Setter Property="MinWidth"
					Value="400" />
            <Setter Property="MinHeight"
					Value="200" />
            <Setter Property="ResizeMode"
					Value="NoResize" />
            <Setter Property="Margin"
					Value="10" />
            <Setter Property="ShowInTaskbar"
					Value="False" />
            <Setter Property="SizeToContent"
					Value="WidthAndHeight" />
        </Style>

        <!--<Style TargetType="{x:Type igPrim:ProgressRingBusyAnimationPresenter }" BasedOn="{StaticResource {x:Type igPrim:ProgressRingBusyAnimationPresenter}}">
            <Setter Property="RingFill" Value="Green" />
            <Setter Property="RingBackground" Value="White"/>
        </Style>--><!--

        <Style TargetType="{x:Type igPrim:SpinnerBallsBusyAnimationPresenter}" BasedOn="{StaticResource {x:Type igPrim:SpinnerBallsBusyAnimationPresenter}}">
            <Setter Property="AnimationFill" Value="White" />            
        </Style>-->

    </igWpf:XamRibbonWindow.Resources>
    <intr:Interaction.Triggers>
        <prism:InteractionRequestTrigger SourceObject="{Binding NotificationRequest}">
            <prism:PopupWindowAction IsModal="True"
									 CenterOverAssociatedObject="True" />
        </prism:InteractionRequestTrigger>
        <prism:InteractionRequestTrigger SourceObject="{Binding CustomConfirmationNotificationRequest}">
            <prism:PopupWindowAction IsModal="True"
									 WindowStyle="{StaticResource DialogWin}"
									 CenterOverAssociatedObject="True">
                <prism:PopupWindowAction.WindowContent>
                    <localviews:CustomConfirmation />
                </prism:PopupWindowAction.WindowContent>
            </prism:PopupWindowAction>
        </prism:InteractionRequestTrigger>
        <prism:InteractionRequestTrigger SourceObject="{Binding CustomErrorNotificationRequest}">
            <prism:PopupWindowAction IsModal="True"
									 WindowStyle="{StaticResource DialogWin}"
									 CenterOverAssociatedObject="True">
                <prism:PopupWindowAction.WindowContent>
                    <localviews:CustomError />
                </prism:PopupWindowAction.WindowContent>
            </prism:PopupWindowAction>
        </prism:InteractionRequestTrigger>
        <intr:EventTrigger EventName="Loaded">
            <intr:InvokeCommandAction Command="{Binding PageLoadedCommand}"/>
        </intr:EventTrigger>
    </intr:Interaction.Triggers>
    <Grid>
        <igWpf:XamDataGrid Width="0" Height="0" DataSource="{Binding DummyData}"/>
        <igWpf:RibbonWindowContentHost>
            <igWpf:RibbonWindowContentHost.Ribbon>
                <igWpf:XamRibbon prism:RegionManager.RegionName="RibbonTabRegion"
								 ApplicationMenuMode="Office2010"
								 IsMinimized="{Binding IsMinimized}"/>

            </igWpf:RibbonWindowContentHost.Ribbon>

            <Grid x:Name="ShellViewRoot">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ContentControl Grid.Column="0"
									prism:RegionManager.RegionName="{x:Static helpers:RegionNames.OutlookBarRegion}" />
                    <igWpf:XamDockManager x:Name="DockManager"
										  Grid.Column="1" >
                        <igWpf:DocumentContentHost x:Name="ContentHost">
                            <igWpf:SplitPane>
                                <!-- Give the TabGroupPane a name with the x:Name attribute so that the region is not destroyed when all views have been removed from the region -->
                                <igWpf:TabGroupPane x:Name="TabGroupPaneOne" 
													prism:RegionManager.RegionName="{x:Static helpers:RegionNames.ContentRegion}">
                                </igWpf:TabGroupPane>
                            </igWpf:SplitPane>
                        </igWpf:DocumentContentHost>
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="ActivePaneChanged">
                                <prism:InvokeCommandAction Command="{Binding DataContext.ActiveDocumentChangedCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </igWpf:XamDockManager>

                    <ContentControl Grid.Column="2"
									prism:RegionManager.RegionName="{x:Static helpers:RegionNames.WidgetBarRegion}" />
                </Grid>
                <ContentControl Grid.Row="2"
								prism:RegionManager.RegionName="{x:Static helpers:RegionNames.StatusBarRegion}" />
            </Grid>
        </igWpf:RibbonWindowContentHost>
        <Grid>
            <ig:XamBusyIndicator IsBusy="{Binding LoadingSettings.IsBusy}" BusyContent="{Binding LoadingSettings.LoadingText}" Foreground="#ff7f00" FontWeight="ExtraBlack"
                                 ProgressValue="{Binding LoadingSettings.Progress}" IsIndeterminate="{Binding LoadingSettings.IsIndeterminate}"  >             
            </ig:XamBusyIndicator>
            <!--<ig:XamBusyIndicator IsBusy="{Binding UploadingSettings.IsBusy}" BusyContent="{Binding UploadingSettings.LoadingText}" Foreground="White" Style="{DynamicResource UploadingBusyIndicator}" 
                                 ProgressValue="{Binding UpoadingSettings.Progress}" IsIndeterminate="{Binding UploadingSettings.IsIndeterminate}">
            </ig:XamBusyIndicator>-->
        </Grid>
        <localviews:UpdateDialog />
    </Grid>
</igWpf:XamRibbonWindow>


