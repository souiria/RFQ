<ig:XamDialogWindow x:Name="ShellUpdateDialog"
            x:Class="SEWSE.H1.UX.Shell.Views.UpdateDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             xmlns:ig="http://schemas.infragistics.com/xaml"
             xmlns:i ="http://schemas.microsoft.com/expression/2010/interactivity"
             xmlns:igWPF="http://schemas.infragistics.com/xaml/wpf"
             xmlns:local="clr-namespace:SEWSE.H1.UX.Shell.Views"
             xmlns:data="clr-namespace:SEWSE.H1.UX.Shell.ViewModels"
             xmlns:igWPF1="clr-namespace:Infragistics.Controls.Editors;assembly=InfragisticsWPF.Controls.Editors.XamComboEditor"
             mc:Ignorable="d" 
             MaxWidth="420" MaxHeight="250" MinWidth="420" MinHeight="250"
             IsModal="True" StartupPosition="Center"                                     
             CloseButtonVisibility="Collapsed"
             Header="Harness One Update"
             Visibility="{Binding DialogWindowVisilibity, Mode=TwoWay}">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <!--<RowDefinition MaxHeight="55"/>-->
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="White" FontSize="16" TextAlignment="Center" Text="Harness One Update Available">
            <TextBlock.Background>
                <ImageBrush  ImageSource="pack://application:,,,/Common.UX;component/Resources/Images/GP_Blue.png" Stretch="UniformToFill"/>
            </TextBlock.Background>
        </TextBlock>
        <StackPanel  Grid.Row="1" >
        <TextBlock TextWrapping="Wrap" Margin="10" HorizontalAlignment="Center" TextAlignment="Center" Text="{Binding DialogText}"/>
            <TextBlock TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Text="A major update has been released and cannot be postponed." Visibility="{Binding CanPostponeText}"/>
        </StackPanel>
        <ProgressBar Grid.Row="2" Width="220" Height="25" Visibility="{Binding ProgressVisibility}" Value="{Binding Progress}"/>
        <StackPanel HorizontalAlignment="Right" Visibility="Collapsed" Orientation="Horizontal" Grid.Row="2" Margin="0,0,10,0" >
            <TextBlock TextWrapping="Wrap" Text="Postpone for: " HorizontalAlignment="left" VerticalAlignment="Center"/>
            <ComboBox x:Name="PostponeComboEditor" IsEditable="False" IsEnabled="{Binding PostponeActive, Mode=TwoWay}" SelectedIndex="0" SelectedItem="{Binding SelectedTime, Mode=TwoWay}" ItemsSource="{Binding Path=PostponeTimes}" DisplayMemberPath="DisplayTime" Width="150" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </StackPanel>
        <!--<Grid Grid.Row="3" Background="#f0f0f0">
            <StackPanel Orientation="Horizontal"  HorizontalAlignment="Right" Margin="5,0" IsEnabled="{Binding IsButtonEnabled}">
                <Button Grid.Column="2" Margin="2,10,2,10" Command="{Binding UpdateRestartCommand}" Style="{DynamicResource ButtonLightRounded}" Content="Restart Now" MinWidth="90"/>
                <Button Grid.Column="3" Margin="2,10,2,10" Command="{Binding UpdateRestartLaterCommand}" Style="{DynamicResource ButtonLightRounded}" MinWidth="90" ToolTip="Installs the update in the background and will apply the changes on your next restart" Visibility="{Binding BackgroundVisibility}">
                    <Button.Content>
                        <TextBlock Text="Background Install" Margin="3,0"/>
                    </Button.Content>
                </Button>
                <Button Grid.Column="0" Margin="2,10,2,10" Command="{Binding UpdatePostponeCommand}" Style="{DynamicResource ButtonLightRounded}" Content="Postpone" MinWidth="90" Visibility="{Binding PostponeVisibility}"/>            
        </StackPanel>
        </Grid>-->
    </Grid>
</ig:XamDialogWindow>
