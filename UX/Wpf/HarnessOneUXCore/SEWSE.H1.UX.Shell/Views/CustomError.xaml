<UserControl x:Class="SEWSE.H1.UX.Shell.Views.CustomError"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 mc:Ignorable="d" 
			 d:DesignHeight="300"
			 d:DesignWidth="500">
    <UserControl.Resources>
        <Style x:Key="DialogBorderBackground"
			   TargetType="{x:Type Border}">
            <Setter Property="Background"
					Value="#0075C1"></Setter>
            <Setter Property="BorderBrush"
					Value="Transparent"></Setter>
        </Style>
        <Style x:Key="TextBlockFont"
			   TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground"
					Value="#598CF7"></Setter>
        </Style>
    </UserControl.Resources>
    <Border Margin="0"
				BorderBrush="{DynamicResource Highlights}"
				BorderThickness="2"
                Background="{DynamicResource Primary}"
				CornerRadius="0,0,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>
            <!--Title-->
            <Border Background="{DynamicResource Highlights}">
                <TextBlock  x:Name="txtBlockHeader"
										VerticalAlignment="Center"
										HorizontalAlignment="Left"
										FontSize="14"
										FontWeight="SemiBold"
										Margin="10"
										Foreground="{DynamicResource Primary}"
										Text="Error"/>
            </Border>
            <!--Content-->

            <Grid Margin="5" Grid.Row="1" VerticalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Image x:Name="imgErrorMessage"
								   Height="30"
								   Width="30"
                                   Source="pack://application:,,,/Common.UX;component/Resources/Images/Dialog/Error_Dialog.png"
								   HorizontalAlignment="Center"
								   VerticalAlignment="Top"
								   Margin="10" />
                <ScrollViewer Grid.Column="1" Margin="12" Height="115" VerticalScrollBarVisibility="Auto">
                    <TextBlock FontSize="14" Foreground="{DynamicResource TextColor}" TextWrapping="Wrap" 
                                    x:Name="txtBlockErrorMessage" Width="300"/>
                </ScrollViewer>
            </Grid>
            <!--Button-->
            <Border Grid.Row="3">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!--<Grid.ColumnDefinitions>
									<ColumnDefinition Width="10" />
									<ColumnDefinition Width="60" />
									<ColumnDefinition />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="80"  />
								</Grid.ColumnDefinitions>-->

                    <!--<Image x:Name="imgFooter1"
									   Grid.Column="0"
									   Height="20"
									   Width="20"
									   Source="/Common.UX;component/Resources/Images/Dialog/StatusFlagRed.png"
									   HorizontalAlignment="Left"
									   Margin="10,0,0,0" />-->
                    <Button Grid.Column="3"
										x:Name="btnOk" Style="{DynamicResource ButtonDefaultRounded}"
										Width="70"
										Height="25"
										Margin="4"										
										IsDefault="True"
										HorizontalAlignment="Right"
										Content="Ok"
										Command="{Binding OkCommand}">
                    </Button>
                    <Button Grid.Column="4"
										x:Name="btnHelpDesk" Style="{DynamicResource ButtonDefaultRounded}"
										Width="70"
										Height="25"
										Margin="4"										
										IsCancel="True"
										HorizontalAlignment="Left"
										Content="Helpdesk"
										Command="{Binding HelpdeskCommand}">
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
