<file src="bin\$configuration$\*.*" target="lib\net45\" exclude="bin\$configuration$\*.pdb; bin\$configuration$\*.xml; bin\$configuration$\*.exe.config; bin\$configuration$\*.nupkg"/>
<file src="bin\$configuration$\Modules\*.*" target="lib\net45\Modules"/>

<file src="bin\UAT\*.*" target="lib\net45\" exclude="bin\UAT\*.pdb; bin\UAT\*.xml; bin\UAT\*.exe.config; bin\UAT\*.nupkg"/>
<file src="bin\UAT\Modules\*.*" target="lib\net45\Modules"/>

<file src="bin\Debug\*.*" target="lib\net45\" exclude="bin\Debug\*.pdb; bin\Debug\*.xml; bin\Debug\*.exe.config;"/>
<file src="bin\Debug\Modules\*.*" target="lib\net45\Modules"/>

msbuild HarnessOneUXCore.sln /t:Build /p:RunOctoPack=true /p:OctoPackPackageVersion=1.0.0 "/p:OctoPackNuGetProperties=configuration=Release"

