<Window x:Class="SEWSE.H1.UX.Infrastructure.Core.Controls.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        ResizeMode="NoResize"        
        ShowInTaskbar="False"
        WindowStyle="None"
        BorderThickness="2,2,0,2"
        BorderBrush="{StaticResource SumitomoBlue}"
        x:Name="Popup"        
        mc:Ignorable="d" 
        Height="110" Width="380" Topmost="True">
    <Window.RenderTransform>
        <ScaleTransform CenterX="190" CenterY="55" ScaleX="1" ScaleY="1"/>
    </Window.RenderTransform>
    <Canvas Background="White">
        <Path Data="M15,25 L85,25 L85,75 L15,75Z L50,50 L85,25" Stroke="{StaticResource SumitomoBlue}" Width="100" Height="100" Margin="5"/>
        <Canvas Grid.Column="1" Margin="105,5 ,5,5" Width="270" Height="100">
            <TextBlock x:Name="Header" FontSize="23" FontWeight="Thin" Foreground="{StaticResource SumitomoBlue}"/>
            <TextBlock x:Name="ClickToClose" Text="Click to close this notification..." Canvas.Top="85" Foreground="Gray" FontSize="10" VerticalAlignment="Bottom"/>
            <TextBlock x:Name="Content" VerticalAlignment="Center" Margin="10,38"/>
        </Canvas>
    </Canvas>
