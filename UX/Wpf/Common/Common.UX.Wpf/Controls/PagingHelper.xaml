<UserControl x:Class="Common.UX.Wpf.Controls.PagingHelper"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="35"   ClipToBounds="True"
             >
    <Grid>
        <StackPanel x:Name="LayoutRoot" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid x:Name="GridLayoutRoot">
                <Grid.RowDefinitions>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="310"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="310"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" 
                            Grid.Row="0" Grid.Column="0"
                            >
                    <TextBlock 
                           Name="lblCurrentPageNo"
                           Text="Page" Margin="0,5,0,0"
                           Height="22"
                           HorizontalAlignment="Left"
                           />

                    <TextBox Grid.Column="1"
                         Margin="5,0,0,0"
                         Padding="0,2,0,0"
                         Name="txtCurrentPageNo"
                         Text="{Binding PageNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Height="22"
                         MinWidth="30"
                         HorizontalAlignment="Left"
                         TextAlignment="Center"
                         KeyDown="txtCurrentPageNo_KeyDown"
                         />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                            Grid.Row="0" Grid.Column="1"
                            >
                    <Button Style="{StaticResource PagingButtonDefaultRounded}"
                        Background="White"
                        Name="btnFirstPage"
                        Content="&lt;&lt;"
                        Click="btnFirstPage_Click"
                        Height="22"
                             MinWidth="50"
                        IsEnabled="{Binding FirstButtonIsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Height="22"
                        Width="10"></TextBlock>
                    <Button  Style="{StaticResource PagingButtonDefaultRounded}"
                        Background="White"
                        Name="btnPreviousPage"
                        Content="&lt;"
                        Click="btnPreviousPage_Click"
                        Height="22"
                        Width="30"
                        IsEnabled="{Binding PreviousButtonIsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        />
                    <TextBlock Height="22"
                        Width="10"></TextBlock>

                    <Label 
                       Name="lblPageIndex"
                       Height="27"
                       HorizontalAlignment="Center"
                       Content="{Binding PageIndex, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                       />
                    <TextBlock Height="22"
                        Width="10"></TextBlock>
                    <TextBlock 
                           Text="of"
                           HorizontalAlignment="Center"
                           Height="22"
                           VerticalAlignment="Center"
                           Margin="0,7,0,0" 
                           />
                    <TextBlock Height="22"
                        Width="10"></TextBlock>

                    <Label Grid.Column="10"
                       Name="lblNumberOfPages"
                       Height="27"
                       HorizontalAlignment="Center"
                       Content="{Binding Path=TotalNumberOfPages,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Height="22"
                        Width="10"></TextBlock>
                    <Button Style="{StaticResource PagingButtonDefaultRounded}"
                        Background="White"
                        Name="btnNextPage"
                        Content="&gt;"
                        Click="btnNextPage_Click"
                        Height="22"
                        Width="30"
                        IsEnabled="{Binding NextButtonIsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        />
                    <TextBlock Height="22"
                        Width="10"></TextBlock>
                    <Button  Style="{StaticResource PagingButtonDefaultRounded}"
                        Background="White"
                        Name="btnLastPage"
                        Content="&gt;&gt;"
                        Click="btnLastPage_Click"
                        Height="22"
                        MinWidth="50"
                        IsEnabled="{Binding LastButtonIsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            Grid.Row="0" Grid.Column="2"
                            >
                    <ComboBox Name="cmbPageSize"
                          Height="22"
                          AllowDrop="True" 
                          MinWidth="60"
                          Margin="0,0,5,0" 
                          ItemsSource="{Binding PageSizeList, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"
                          SelectedItem="{Binding SelectedPageSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"
                          SelectionChanged="cmbPageSize_SelectionChanged"
                          />
                </StackPanel>

            </Grid>
        </StackPanel>
    </Grid>
</UserControl>

