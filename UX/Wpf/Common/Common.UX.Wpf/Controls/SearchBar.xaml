<Grid x:Class="Common.UX.Wpf.Controls.SearchBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:extensions="clr-namespace:Common.UX.Wpf.Extensions"
             xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
             xmlns:ig="http://schemas.infragistics.com/xaml" xmlns:controls="clr-namespace:Common.UX.Wpf.Controls" xmlns:helpers="clr-namespace:Common.UX.Wpf.Helpers" d:DataContext="{d:DesignInstance Type=helpers:HierarchySearcher}"
      mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             ShowGridLines="False" Margin="5">
    <Grid.ColumnDefinitions>
        <ColumnDefinition MaxWidth="700"/>
        <ColumnDefinition Width="30"/>
    </Grid.ColumnDefinitions>
    <TextBox Grid.Column="0" x:Name="Text" BorderThickness="0" Height="30" VerticalContentAlignment="Center" HorizontalContentAlignment="Left" BorderBrush="{DynamicResource Highlights}" Text="{Binding SearchString, UpdateSourceTrigger=PropertyChanged}"
                     extensions:FocusExtension.IsFocused="{Binding SearchFocused}">
        <TextBox.Style>
            <Style TargetType="{x:Type TextBox}">
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background" Value="{x:Static SystemColors.InactiveBorderBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </TextBox.Style>
        <i:Interaction.Triggers>
            <i:EventTrigger EventName="TextChanged">
                <i:InvokeCommandAction Command="{Binding SearchChangedCommand}"/>
            </i:EventTrigger>
        </i:Interaction.Triggers>
    </TextBox>
    <Popup x:Name="Popup" Grid.Column="0" Placement="Bottom" PlacementTarget="{Binding ElementName=Text}" StaysOpen="True" IsOpen="{Binding SearchResultsIsOpen}" Grid.IsSharedSizeScope="True" MaxHeight="800">
        <Grid>
            <ListBox x:Name="SearchListBox" ItemsSource="{Binding SearchResults}" HorizontalContentAlignment="Stretch" Background="White" SelectedItem="{Binding SelectedSearch}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Labels"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" FontStyle="Italic" FontSize="14" Margin="5,2" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="5,2">
                                <TextBlock VerticalAlignment="Center">
                                        <Run Text="{Binding MatchType , Mode=OneWay}"/>
                                        <Run Text=":"/>
                                </TextBlock>
                                <TextBlock Text="{Binding Match}" Margin="5,2" FontStyle="Italic"/>
                            </StackPanel>
                            <ItemsControl Grid.Row="1" Grid.ColumnSpan="2" Grid.Column="0" BorderThickness="0" ItemsSource="{Binding Path}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"></StackPanel>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Foreground="Gray" FontSize="10" Margin="0,0,3,0">
                                                <Run Text=">"/>
                                                <Run Text="{Binding .}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <ig:XamBusyIndicator IsBusy="{Binding IsSearching, IsAsync=True}" Height="4" VerticalAlignment="Top"/>
        </Grid>
    </Popup>
    <Button x:Name="Button" Grid.Column="1" BorderThickness="0" Width="30" Margin="-1,0,0,0" BorderBrush="{DynamicResource Highlights}" Background="White"
                    Command="{Binding ClearCommand}">
        <Path Data="M0,0 L10,10 M10,0 L0,10" StrokeThickness="1" Stroke="Black" VerticalAlignment="Center"/>
    </Button>
    <Border x:Name="Border" BorderThickness="1" Grid.ColumnSpan="2" Grid.Column="0" SnapsToDevicePixels="True" >
        <Border.Style>
            <Style TargetType="{x:Type Border}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsValid, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" Value="False">
                        <Setter Property="BorderBrush" Value="Red"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsValid, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource Highlights}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
    </Border>
</Grid>
